{# templates/components/Input.html.twig #}
{% props value = null %}

<input
    {# 1. Fusion intelligente des classes (Tailwind Merge) avec notre palette B2B #}
    class="{{ 'flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-400 disabled:opacity-50 transition-colors ' ~ attributes.render('class') | tailwind_merge }}"

    {# 2. Rendu des autres attributs (type, name, id...) SANS dupliquer la classe
          et AVEC la protection stricte contre le null #}
    {{ attributes.without('class').defaults({
        'value': value ?? ''
    }) }}
>
