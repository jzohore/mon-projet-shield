<div {{ attributes }} class="w-full">

    {# 1. LA LISTE DES DIRIGEANTS / UBOs (Design épuré d'origine) #}
    <div class="space-y-4 mb-8">
        {% for stakeholder in this.folder.stakeholders %}

            <div class="bg-white ring-1 ring-slate-200 rounded-xl p-4 flex items-start justify-between gap-4 shadow-sm transition-all relative overflow-hidden group">

                {# Bandeau vertical coloré si c'est un UBO #}
                {% if stakeholder.isUbo %}
                    <div class="absolute left-0 top-0 bottom-0 w-1 bg-amber-400"></div>
                {% endif %}

                <div class="flex items-start gap-4">
                    {# Avatar générique simple #}
                    <div class="mt-1 h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold ring-1 ring-slate-900/5 shrink-0">
                        {{ stakeholder.firstName|first|upper }}{{ stakeholder.lastName|first|upper }}
                    </div>

                    <div>
                        <h3 class="text-sm font-bold text-slate-900">{{ stakeholder.firstName }} {{ stakeholder.lastName }}</h3>

                        <div class="flex flex-wrap items-center gap-2 mt-1">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 uppercase tracking-wide">
                                {{ stakeholder.role.label }}
                            </span>

                            {# Si le % est connu #}
                            {% if stakeholder.ownershipPercentage is not null %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700">
                                    Détient {{ stakeholder.ownershipPercentage }}%
                                </span>
                            {% endif %}

                            {% if stakeholder.isUbo %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700 uppercase gap-1">
                                    <twig:ux:icon name="tabler:star-filled" class="size-3" /> UBO
                                </span>
                            {% endif %}
                        </div>

                        {# LE CHAMP POURCENTAGE MANQUANT #}
                        {% if stakeholder.ownershipPercentage is null %}
                            <div class="flex items-center gap-2 mt-2">
                                <input
                                    type="number"
                                    name="inlinePercentage"
                                    placeholder="% des parts"
                                    class="w-24 text-xs py-1 px-2 border-slate-300 rounded focus:ring-indigo-500 focus:border-indigo-500 shadow-sm"
                                    data-action="keydown.enter->live#action:prevent"
                                    data-live-action-param="updatePercentage"
                                    data-live-id-param="{{ stakeholder.id }}"
                                >
                                <twig:Button
                                    type="button"
                                    variant="dark"
                                    size="sm"
                                    class="p-1 px-2"
                                    data-action="live#action:prevent"
                                    data-live-action-param="updatePercentage"
                                    data-live-id-param="{{ stakeholder.id }}"
                                    title="Enregistrer"
                                >
                                    <twig:ux:icon name="tabler:check" class="size-3" />
                                </twig:Button>
                                <span class="text-[10px] text-rose-500 italic font-medium">Requis</span>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Bouton Supprimer #}
                <button
                    type="button"
                    data-action="click->live#action"
                    data-live-action-param="removeStakeholder"
                    data-live-id-param="{{ stakeholder.slugId }}" {# ou slugId selon ton entité #}
                    class="text-slate-400 hover:text-rose-600 p-2 rounded-lg hover:bg-rose-50 transition-colors shrink-0 cursor-pointer"
                    title="Retirer"
                >
                    <twig:ux:icon name="tabler:trash" class="size-4" />
                </button>
            </div>

        {% else %}
            {# Empty State #}
            <div class="text-center py-8 px-4 bg-slate-50 rounded-xl ring-1 ring-slate-900/5 border-dashed border-2 border-slate-200">
                <twig:ux:icon name="tabler:users-group" class="size-8 text-slate-400 mx-auto mb-3" />
                <p class="text-sm font-medium text-slate-900">Aucun intervenant identifié</p>
                <p class="text-xs text-slate-500 mt-1">Ajoutez manuellement les dirigeants et actionnaires.</p>
            </div>
        {% endfor %}
    </div>

    {# 2. LE FORMULAIRE D'AJOUT (Minimaliste & Épuré) #}
    {% if not this.isAddingNew %}

        {# Ton bouton dashed propre #}
        <twig:Button
            type="button"
            variant="outline"
            data-action="click->live#action"
            data-live-action-param="toggleAddForm"
            class="w-full py-3 border-2 border-dashed border-slate-300 hover:text-indigo-600 hover:border-indigo-300 hover:bg-indigo-50/50 gap-2"
        >
            <twig:ux:icon name="tabler:plus" class="size-4" />
            Ajouter un autre dirigeant ou associé
        </twig:Button>

    {% else %}

        <div class="bg-white ring-1 ring-slate-200 rounded-xl p-5 mb-8 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 mb-4">Nouvel intervenant</h3>

            {{ form_start(form, {
                attr: {
                    novalidate: true,
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'saveNewStakeholder',
                }
            }) }}

            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-1">
                    {{ form_row(form.firstName) }}
                </div>
                <div class="col-span-1">
                    {{ form_row(form.lastName) }}
                </div>
                <div class="col-span-2">
                    {{ form_row(form.role) }}
                </div>
                <div class="col-span-2">
                    {{ form_row(form.percentage) }}
                </div>
            </div>

            <div class="pt-5 mt-2 flex justify-end gap-x-3 border-t border-slate-100">
                <twig:Button type="button" variant="outline" data-action="click->live#action" data-live-action-param="toggleAddForm">
                    Annuler
                </twig:Button>

                <twig:Button type="submit" variant="dark" class="px-6">
                    <span data-loading="action(saveNewStakeholder)|hide">Enregistrer</span>
                    <span data-loading="action(saveNewStakeholder)|show" class="hidden items-center gap-2">
                        <twig:ux:icon name="tabler:loader" class="size-4 animate-spin opacity-70" /> Enregistrement...
                    </span>
                </twig:Button>
            </div>

            {{ form_end(form) }}
        </div>

    {% endif %}

    {# 3. BOUTONS DE NAVIGATION (Avec tes balises twig:Button) #}
    <div class="mt-12 pt-6 border-t border-slate-200 flex items-center justify-between">

        {# Lien Retour #}
        <twig:Button as="a" href="{{ path('portal_kyc_company') }}" variant="link" class="text-slate-500 hover:text-slate-900 px-0 gap-2">
            <twig:ux:icon name="tabler:arrow-left" class="size-4" />
            Retour à l'entreprise
        </twig:Button>

        {# Le bouton de validation finale #}
        {% if this.folder.stakeholders|length > 0 %}
            <twig:Button as="a" href="{{ path('portal_kyc_documents') }}" variant="dark" class="px-8 gap-2">
                Confirmer les intervenants
                <twig:ux:icon name="tabler:arrow-right" class="size-4" />
            </twig:Button>
        {% else %}
            {# Désactivé s'il n'y a personne #}
            <twig:Button variant="outline" class="px-8 gap-2 opacity-50 cursor-not-allowed" title="Veuillez ajouter au moins un dirigeant">
                Confirmer les intervenants
                <twig:ux:icon name="tabler:arrow-right" class="size-4" />
            </twig:Button>
        {% endif %}

    </div>
</div>
