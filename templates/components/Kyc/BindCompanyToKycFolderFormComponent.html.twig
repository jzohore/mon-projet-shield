<div {{ attributes }} class="w-full relative">

    {# HEADER #}
    <div class="mb-8 animate-in fade-in slide-in-from-left-4 duration-500">
        <h1 class="text-xl font-bold text-slate-900 tracking-tight">
            {% if this.isInFormation %}
                Dites-nous en plus sur votre projet
            {% elseif this.companySiret %}
                Confirmez les informations
            {% else %}
                Identifiez votre société
            {% endif %}
        </h1>

        <p class="text-sm text-slate-500 mt-2">
            {% if this.isInFormation %}
                Saisissez le nom prévu pour votre structure afin que nous puissions préparer les documents de création.
            {% elseif this.companySiret %}
                Vérifiez que les données récupérées correspondent bien à l'entité concernée par ce dossier.
            {% else %}
                Recherchez le nom ou le SIREN de l'entreprise concernée par ce dossier de conformité.
            {% endif %}
        </p>
    </div>

    {# ÉTAT 1 : LE CLIENT DOIT CHERCHER SA SOCIÉTÉ #}
    {% if this.companySiret is empty and not this.isInFormation %}

        <div class="relative mb-2">

            {# L'input de recherche (Accessible) #}
            <div class="space-y-2">
                {# 1. LABEL LIÉ À L'INPUT #}
                <label for="company_search_input" class="flex items-center gap-2 text-sm leading-none font-medium select-none mb-3">
                    Recherchez votre structure
                </label>

                <div class="relative">
                    {# 2. INPUT AVEC ARIA (Combobox) #}
                    <input
                        id="company_search_input"
                        type="search"
                        role="combobox"
                        aria-autocomplete="list"
                        aria-expanded="{{ this.results|length > 0 ? 'true' : 'false' }}"
                        aria-controls="company_search_results"
                        data-model="debounce(500)|searchQuery"
                        placeholder="Ex: Cabinet Dupont & Associés (ou SIRET, SIREN)"
                        class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                    >
                    {% if hasApiError %}
                        <div class="mt-4 p-3 bg-amber-50 border border-amber-200 rounded-lg flex items-center gap-3 text-amber-800 animate-pulse">
                            <twig:ux:icon name="tabler:clock-stop" class="size-5 shrink-0" />
                            <p class="text-xs font-medium">
                                L'annuaire des entreprises est très sollicité.
                                Veuillez patienter quelques secondes avant de taper la suite.
                            </p>
                        </div>
                    {% endif %}
                    {# 3. INDICATEUR DE CHARGEMENT ACCESSIBLE #}
                    <div data-loading="addClass(opacity-100)" class="absolute right-3 top-1/2 -translate-y-1/2 opacity-0 transition-opacity pointer-events-none" aria-hidden="true">
                        <twig:ux:icon name="lucide:loader-2" class="w-4 h-4 text-muted-foreground animate-spin" />
                        <span class="sr-only">Recherche en cours...</span>
                    </div>
                </div>
            </div>

            {# LES RÉSULTATS FLOTTANTS #}
            {% if this.searchQuery|length >= 3 %}
                <div class="absolute z-50 w-full mt-2 bg-white ring-1 ring-slate-900/5 rounded-2xl shadow-xl overflow-hidden">

                    {% if this.results is empty %}
                        {# État vide accessible #}
                        <div class="p-8 text-center" role="status" aria-live="polite">
                            <div class="mx-auto h-12 w-12 bg-slate-50 rounded-full flex items-center justify-center mb-3 ring-1 ring-slate-900/5" aria-hidden="true">
                                <twig:ux:icon name="tabler:zoom-cancel" class="size-6 text-slate-400" />
                            </div>
                            <p class="text-sm font-medium text-slate-900">Aucune entreprise trouvée</p>
                            <p class="text-xs text-slate-500 mt-1">Vérifiez l'orthographe ou le numéro SIREN.</p>
                        </div>
                    {% else %}
                        {# 4. LA LISTE (Listbox) AVEC NAVIGATION CLAVIER #}
                        <ul id="company_search_results" role="listbox" aria-label="Entreprises trouvées" class="max-h-[320px] overflow-y-auto p-2 space-y-1 [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-thumb]:bg-slate-200 [&::-webkit-scrollbar-thumb]:rounded-full">
                            {% for company in this.results %}

                                {% set isClosed = (company.etat_administratif == 'F' or company.etat_administratif == 'C') %}

                                <li
                                    role="option"
                                    aria-selected="false"
                                    tabindex="0" {# Rend l'élément focusable avec la touche TAB #}
                                    {% if not isClosed %}
                                        data-action="click->live#action keydown.enter->live#action" {# Accepte le clic OU la touche Entrée ! #}
                                        data-live-action-param="selectCompany"
                                        data-live-name-param="{{ company.nom_complet }}"
                                        data-live-siret-param="{{ company.siege.siret }}"
                                        data-live-siren-param="{{ company.siren }}"
                                        data-live-address-param="{{ company.siege.adresse|default('') }}"
                                        data-live-legalform-param="{{ company.nature_juridique|default('Non renseignée') }}"
                                        data-live-administratif-param="{{ company.etat_administratif }}"
                                        data-live-stakeholders-param="{{ company.dirigeants|default([])|json_encode|e('html_attr') }}"
                                    {% else %}
                                        aria-disabled="true"
                                    {% endif %}
                                    class="p-3 rounded-xl flex items-start gap-3 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500
                                        {% if isClosed %}
                                            opacity-60 bg-slate-50 cursor-not-allowed
                                        {% else %}
                                            hover:bg-slate-50 focus:bg-slate-50 cursor-pointer group
                                        {% endif %}"
                                >
                                    <div class="flex-1 min-w-0 pointer-events-none">
                                        <div class="flex items-center justify-between mb-1">
                                            <span class="text-sm font-bold text-slate-900 {% if not isClosed %}group-hover:text-indigo-700{% endif %} truncate transition-colors">
                                                {{ company.nom_complet }}
                                            </span>

                                            {% if isClosed %}
                                                <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-600 ring-1 ring-inset ring-rose-500/20">
                                                    Fermée
                                                </span>
                                            {% endif %}
                                        </div>

                                        <div class="flex items-center text-[12px] text-slate-500 gap-2 overflow-hidden">
                                            <span class="font-mono text-slate-400 shrink-0 uppercase tracking-tight">
                                                <span class="sr-only">SIREN : </span>{{ company.siren }}
                                            </span>
                                            <span class="text-slate-300 shrink-0" aria-hidden="true">•</span>
                                            <span class="truncate italic font-light">
                                                {{ company.siege.adresse|default('Adresse non renseignée') }}
                                            </span>
                                        </div>
                                    </div>
                                </li>

                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}

        </div>

        {% if this.searchQuery|length < 3 %}
            <div class="mt-3 flex justify-center">
                <twig:Button
                    type="button"
                    data-action="click->live#action"
                    data-live-action-param="setInFormation"
                    variant="link"
                    class="text-[12px] font-medium text-slate-500 hover:text-indigo-600 transition-colors flex items-center gap-1.5"
                >
                    Vous n'avez pas de SIRET ? Cliquez ici si votre société est en cours de création.
                </twig:Button>
            </div>
        {% endif %}

        {# ÉTAT 1 BIS : L'ENTREPRISE EST EN COURS DE CRÉATION #}
    {% elseif this.isInFormation %}

        <div class="bg-amber-50/50 ring-1 ring-amber-500/20 rounded-2xl p-6 mb-8 relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 text-amber-500/10 transform rotate-12 pointer-events-none" aria-hidden="true">
                <twig:ux:icon name="tabler:crane" class="size-32" />
            </div>

            <div class="relative z-10">
                <div class="flex items-start gap-3 mb-4">
                    <div class="mt-0.5 p-2 bg-amber-100 rounded-lg text-amber-600 shadow-sm" aria-hidden="true">
                        <twig:ux:icon name="tabler:bulb" class="size-5" />
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Société en cours de création</h3>
                        <p class="text-xs text-slate-600 mt-1">Saisissez le nom prévu de votre future société. Les documents demandés seront adaptés (ex : Projet de statuts).</p>
                    </div>
                </div>

                <div class="flex gap-3">
                    <label for="formation_name_input" class="sr-only">Nom de la future société</label>
                    <input
                        id="formation_name_input"
                        type="text"
                        data-model="workspaceName"
                        placeholder="Nom de la future société"
                        class="flex-1 border-0 ring-1 ring-amber-500/30 rounded-xl shadow-sm focus:ring-2 focus:ring-amber-500 px-4 py-2 text-sm text-slate-900 bg-white"
                    >
                    <button
                        type="button"
                        data-action="click->live#action"
                        data-live-action-param="cancelInFormation"
                        aria-label="Annuler la saisie d'entreprise en création"
                        class="text-xs font-semibold text-slate-500 hover:text-slate-700 bg-white px-3 py-2 rounded-xl ring-1 ring-slate-900/5 shadow-sm transition-all focus:ring-2 focus:ring-slate-500"
                    >
                        Annuler
                    </button>
                </div>
            </div>
        </div>

        {% if this.companyName|length > 2 %}
            <form action="" method="POST">
                <input type="hidden" name="companyName" value="{{ this.companyName }}">
                <input type="hidden" name="siret" value="IN_FORMATION">
                <input type="hidden" name="legalCategoryCode" value="IN_FORMATION">

                <twig:Button as="button" type="submit" variant="dark" class="w-full sm:w-auto px-8"
                             data-action="live#action:prevent"
                             data-live-action-param="save">
                    <span data-loading="action(save)|hide">Confirmer et continuer</span>
                    <span data-loading="action(save)|show" class="hidden items-center gap-2" role="status">
                        <twig:ux:icon name="lucide:loader-2" class="w-4 h-4 animate-spin" aria-hidden="true" />
                        <span>Enregistrement...</span>
                    </span>
                </twig:Button>
            </form>
        {% endif %}

        {# ÉTAT 2 : LE CLIENT A SÉLECTIONNÉ SA SOCIÉTÉ (Déjà Immatriculée) #}
    {% else %}

        <div class="bg-indigo-50/50 ring-1 ring-indigo-900/10 rounded-2xl p-5 mb-8 relative overflow-hidden group">
            <div class="absolute -right-6 -top-6 text-indigo-100/50 transform rotate-12 transition-transform group-hover:rotate-6 group-hover:scale-110 duration-500 pointer-events-none" aria-hidden="true">
                <twig:ux:icon name="tabler:building-bank" class="size-32" />
            </div>

            <div class="relative z-10 flex items-start justify-between gap-4">
                <div class="flex items-start gap-4">
                    <div class="mt-1 p-2 bg-white rounded-xl text-indigo-600 ring-1 ring-indigo-900/10 shadow-sm" aria-hidden="true">
                        <twig:ux:icon name="tabler:check" class="size-5" />
                    </div>
                    <div>
                        <p class="text-sm font-bold text-slate-900 text-lg">{{ this.companyName }}</p>
                        <p class="text-sm text-slate-600 mt-1 flex flex-wrap items-center gap-2">
                            <span class="font-mono text-xs bg-white px-1.5 py-0.5 rounded ring-1 ring-slate-900/5 shadow-sm">
                                <span class="sr-only">SIRET : </span>{{ this.companySiret }}
                            </span>
                            <span class="text-slate-300 hidden sm:inline" aria-hidden="true">•</span>
                            <span class="truncate max-w-[200px] sm:max-w-xs">{{ this.companyAddress|default('Adresse enregistrée') }}</span>
                        </p>
                    </div>
                </div>

                <button
                    type="button"
                    data-action="click->live#action"
                    data-live-action-param="resetCompany"
                    aria-label="Modifier l'entreprise sélectionnée (Attention: supprime les dirigeants)"
                    class="text-xs cursor-pointer font-semibold text-indigo-600 hover:text-indigo-800 bg-white px-3 py-1.5 rounded-lg ring-1 ring-slate-900/5 shadow-sm hover:shadow transition-all shrink-0 focus:ring-2 focus:ring-indigo-500 focus:outline-none"

                >
                    Modifier
                </button>
            </div>
        </div>

        {% if this.isAlreadySavedInDatabase %}
            <twig:Button as="a" href="{{ path('portal_kyc_stakeholders') }}" variant="dark" class="w-full sm:w-auto px-8 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Continuer vers les dirigeants
                <twig:ux:icon name="tabler:arrow-right" class="size-4 ml-2" aria-hidden="true" />
            </twig:Button>

        {% else %}
            <form method="POST">
                <twig:Button as="button" type="submit" variant="dark" class="w-full sm:w-auto px-8 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" data-action="live#action:prevent"
                             data-live-action-param="save">
                    <span data-loading="action(save)|hide">Confirmer l'entreprise et continuer</span>
                    <span data-loading="action(save)|show" class="hidden items-center gap-2" role="status">
                        <twig:ux:icon name="lucide:loader-2" class="w-4 h-4 animate-spin" aria-hidden="true" />
                        <span>Enregistrement...</span>
                    </span>
                </twig:Button>
            </form>
        {% endif %}

    {% endif %}

</div>
