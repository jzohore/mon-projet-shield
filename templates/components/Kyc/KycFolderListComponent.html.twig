<div {{ attributes }} class="space-y-6">
    {% set items = this.kycList %}

    {# 💡 OPTIMISATION : Déclaration des dictionnaires HORS de la boucle #}
    {% set statusColors = {
        'draft': 'bg-slate-100 text-slate-800 border-slate-200',
        'awaiting_client': 'bg-amber-100 text-amber-800 border-amber-200',
        'in_review': 'bg-blue-100 text-blue-800 border-blue-200',
        'needs_correction': 'bg-purple-100 text-purple-800 border-purple-200',
        'approved': 'bg-emerald-100 text-emerald-800 border-emerald-200',
        'rejected': 'bg-red-100 text-red-800 border-red-200',
        'archived': 'bg-red-100 text-red-800 border-red-200'
    } %}

    {% set statusDots = {
        'draft': 'bg-slate-500',
        'awaiting_client': 'bg-amber-500 animate-pulse',
        'in_review': 'bg-blue-500',
        'needs_correction': 'bg-purple-500 animate-pulse',
        'approved': 'bg-emerald-500',
        'rejected': 'bg-red-500',
        'archived': 'bg-red-500'
    } %}

    {# --- 1. BARRE D'OUTILS (Recherche & Compteur) --- #}
    <div class="flex flex-wrap gap-4 justify-between items-center">
        <div class="relative w-full sm:w-72">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <twig:ux:icon name="tabler:search" class="size-4 text-slate-400" aria-hidden="true" />
            </div>
            <input
                type="search"
                placeholder="Rechercher un dossier, un client..."
                data-model="query"
                value="{{ query }}"
                class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-colors shadow-sm"
            />
        </div>
        <div class="text-sm font-medium text-slate-500 bg-white px-3 py-1.5 rounded-md shadow-sm border border-slate-200">
            <span class="text-slate-900 font-bold">{{ items.nbResults|default(items|length) }}</span> dossier(s)
        </div>
    </div>

    {# --- 2. GESTION DE L'AFFICHAGE --- #}
    {% if items is empty %}

        {# --- 2A. L'ÉTAT VIDE (Empty State) --- #}
        <div class="bg-white rounded-2xl p-8 shadow-sm">
            <twig:Empty class="border border-dashed border-slate-200 bg-slate-50/50 rounded-xl py-12">
                <twig:Empty:Header>
                    <twig:Empty:Media variant="icon" class="bg-white shadow-sm ring-1 ring-slate-200">
                        <twig:ux:icon name="tabler:shield-off" class="size-6 text-slate-400" />
                    </twig:Empty:Media>
                    <twig:Empty:Title class="text-lg font-bold text-slate-900 mt-4">Aucun dossier KYC</twig:Empty:Title>
                    <twig:Empty:Description class="text-slate-500">
                        Vous n'avez pas encore initié de demande de conformité. Lancez votre première vérification LCB-FT.
                    </twig:Empty:Description>
                </twig:Empty:Header>
                <twig:Empty:Content class="mt-6">
                    <a href="{{ path('app_kyc_invitation') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-transparent bg-slate-900 text-white hover:bg-slate-800 h-9 px-4 py-2 shadow-sm">
                        <twig:ux:icon name="tabler:plus" class="size-4 mr-2" />
                        Nouveau dossier KYC
                    </a>
                </twig:Empty:Content>
            </twig:Empty>
        </div>

    {% else %}

        {# --- 2B. LE TABLEAU GRID --- #}
        <twig:Grid:Table aria-label="Liste des dossiers KYC">

            {# --- EN-TÊTE DU TABLEAU --- #}
            <twig:Grid:Header>
                <div role="columnheader" class="lg:col-span-4">Client (Contact)</div>
                <div role="columnheader" class="lg:col-span-4">Entreprise</div>
                <div role="columnheader" class="lg:col-span-3">Statut</div>
                <div role="columnheader" class="lg:col-span-1 text-right">Actions</div>
            </twig:Grid:Header>

            {# --- CORPS DU TABLEAU --- #}
            <twig:Grid:Body>
                {% for kyc in items %}
                    <twig:Grid:Row>

                        {# --- Colonne 1 : Client --- #}
                        <twig:Grid:Cell cols="4" label="Client (Contact)">
                            <div class="mb-2 lg:mb-1">
                                <span class="font-mono text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                    <span class="sr-only">Référence dossier : </span>{{ kyc.reference }}
                                </span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="size-9 shrink-0 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center text-xs font-bold shadow-sm" aria-hidden="true">
                                    {{ kyc.contactFirstName|slice(0, 1) ~ kyc.contactLastName|slice(0, 1) }}
                                </div>
                                <div>
                                    <p class="font-bold text-slate-900">{{ kyc.contactFirstName }} {{ kyc.contactLastName }}</p>
                                    <p class="text-xs text-slate-500">{{ kyc.contactEmail }}</p>
                                </div>
                            </div>
                        </twig:Grid:Cell>

                        {# --- Colonne 2 : Entreprise --- #}
                        <twig:Grid:Cell cols="4" label="Entreprise" class="mt-3 lg:mt-0">
                            {% if kyc.companyName %}
                                <div class="flex items-center gap-2">
                                    <twig:ux:icon name="tabler:building-bank" class="size-4 text-slate-400 shrink-0" aria-hidden="true" />
                                    <div>
                                        <p class="text-sm font-bold text-slate-900">{{ kyc.companyName }}</p>
                                        <p class="text-xs text-slate-500">SIRET: {{ kyc.siret }}</p>
                                    </div>
                                </div>
                            {% else %}
                                <div class="flex items-center gap-2 opacity-60">
                                    <twig:ux:icon name="tabler:hourglass-empty" class="size-4 text-slate-400 shrink-0" aria-hidden="true" />
                                    <span class="text-sm italic text-slate-500">En attente de saisie...</span>
                                </div>
                            {% endif %}
                        </twig:Grid:Cell>

                        {# --- Colonne 3 : Statut --- #}
                        <twig:Grid:Cell cols="3" label="Statut" class="mt-3 lg:mt-0">
                            {% set colorClass = statusColors[kyc.status.value] | default('bg-slate-50 text-slate-700 ring-slate-600/20') %}
                            {% set dotClass = statusDots[kyc.status.value] | default('bg-slate-500') %}

                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium ring-1 ring-inset {{ colorClass }}">
                                <span class="h-1.5 w-1.5 rounded-full {{ dotClass }}" aria-hidden="true"></span>
                                {{ kyc.status.label }}
                            </span>
                        </twig:Grid:Cell>

                        {# --- Colonne 4 : Actions --- #}
                        <twig:Grid:Cell cols="1" class="flex flex-row lg:justify-end gap-2 mt-4 pt-4 lg:mt-0 lg:pt-0 border-t border-slate-100 lg:border-t-0">

                            {# Bouton copier le lien #}
                            {% if kyc.status.value in ['draft', 'awaiting_client'] %}
                                <button type="button" class="flex-1 lg:flex-none p-2 text-slate-500 hover:text-blue-600 rounded-md hover:bg-blue-50 transition-colors border border-slate-200 lg:border-transparent flex items-center justify-center"
                                        title="Copier le lien sécurisé"
                                        data-action="clipboard#copy"
                                        data-clipboard-text="">
                                    <twig:ux:icon name="tabler:link" class="size-4" aria-hidden="true" />
                                    <span class="ml-2 lg:sr-only text-xs font-medium">Copier</span>
                                </button>
                            {% endif %}

                            {# Bouton d'ouverture du dossier #}
                            <twig:Button as="a" href="{{ path('app_kyc_show', {slugId: kyc.slugId}) }}"
                                         variant="outline" size="sm" class="flex-1 lg:flex-none p-2 text-slate-500 hover:text-slate-900 rounded-md hover:bg-slate-100 transition-colors border-slate-200 lg:border-transparent flex items-center justify-center">
                                <twig:ux:icon name="tabler:folder-open" class="size-4" aria-hidden="true" />
                                <span class="ml-2 lg:sr-only text-xs font-medium">Ouvrir</span>
                            </twig:Button>

                        </twig:Grid:Cell>

                    </twig:Grid:Row>
                {% endfor %}
            </twig:Grid:Body>
        </twig:Grid:Table>

    {% endif %}
</div>
