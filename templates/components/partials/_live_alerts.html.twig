{# templates/components/partials/_live_alerts.html.twig #}
{# Attend deux variables : `message` (string|null) et `type` (string) #}

{% if message %}
    {% set is_error = (type == 'error') %}
    {% set alert_class = is_error ? 'bg-red-50 text-red-900 border-red-200' : 'bg-green-50 text-green-900 border-green-200' %}
    {% set icon = is_error ? 'lucide:circle-alert' : 'lucide:circle-check' %}
    {% set title = is_error ? 'Erreur' : 'Succès' %}

    <div data-controller="notification"
         data-notification-timeout-value="3000"
         role="status" aria-live="polite"
         class="fixed top-6 right-6 z-50 pointer-events-auto transform transition-all duration-300 ease-in-out w-full max-w-sm">

        {# On garde ton composant, on lui ajoute juste "relative" et "pr-10" pour le bouton #}
        <twig:Alert class="{{ alert_class }} relative pr-10 shadow-lg">

            <twig:Alert:Description>
                {{ message }}
            </twig:Alert:Description>

            {# Le bouton de fermeture natif, positionné en absolu à l'intérieur de l'alerte #}
            <button type="button"
                    data-action="click->notification#dismiss"
                    class="absolute top-4 right-4 p-1 rounded-md opacity-50 hover:opacity-100 hover:bg-black/5 transition-colors focus:outline-none"
                    aria-label="Fermer la notification">
                <twig:ux:icon name="lucide:x" class="w-4 h-4" />
            </button>

        </twig:Alert>
    </div>
{% endif %}
