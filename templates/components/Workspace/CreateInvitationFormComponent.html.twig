<div{{ attributes }}>
    {% include 'components/partials/_live_alerts.html.twig' with {
        message: this.actionMessage|default(null),
        type: this.actionMessageType|default('success')
    } %}

    <div class="space-y-8">
        {# --- LE FORMULAIRE --- #}
        <div class="bg-white rounded-2xl border border-slate-200 border-l-4 border-l-indigo-500 shadow-sm">
            <div class="p-6 sm:p-8">
                <h2 class="text-lg font-bold text-slate-900 mb-6">Nouvelle invitation</h2>

                {{ form_start(form, {
                    attr: {
                        novalidate: true,
                        'data-action': 'submit->live#action:prevent',
                        'data-live-action-param': 'save',
                    }
                }) }}

                <div class="space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        {{ form_row(form.firstName, {
                            label: 'Prénom',
                            attr: { placeholder: 'Jean', autofocus: true }
                        }) }}
                        {{ form_row(form.lastName, {
                            label: 'Nom',
                            attr: { placeholder: 'Dupont' }
                        }) }}
                        <div class="sm:col-span-2">
                            {{ form_row(form.email, {
                                label: 'Email professionnel',
                                attr: { placeholder: 'jean.dupont@cabinet.fr' }
                            }) }}
                        </div>
                    </div>

                    <fieldset>
                        <legend class="block text-sm font-semibold text-slate-700 mb-1">Niveau de privilèges</legend>
                        <p class="text-xs text-slate-500 mb-3">Par défaut : Collaborateur.</p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <label class="relative flex cursor-pointer rounded-xl border-2 border-slate-200 bg-white p-4 transition-all hover:border-slate-300 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50/30 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 has-[:focus-visible]:ring-offset-2 group">
                                <input type="radio" data-model="norender|invitedRole" name="invitedRole" value="ROLE_WORKSPACE_COLLAB" class="peer sr-only" {{ this.invitedRole == 'ROLE_WORKSPACE_COLLAB' ? 'checked' : '' }}>
                                <span class="flex flex-col w-full">
                                    <span class="flex items-center justify-between mb-2">
                                        <span class="flex items-center gap-2 text-sm font-bold text-slate-900">
                                            {{ ux_icon('lucide:user', { class: 'size-4 text-slate-400 group-has-[:checked]:text-indigo-600 transition-colors' }) }}
                                            Collaborateur
                                        </span>
                                        {{ ux_icon('lucide:circle-check-big', { class: 'size-4 text-indigo-600 opacity-0 peer-checked:opacity-100 transition-opacity' }) }}
                                    </span>
                                    <span class="text-xs text-slate-500 leading-relaxed">
                                        Accès aux dossiers clients et réalisation des contrôles de conformité KYC.
                                    </span>
                                </span>
                            </label>

                            <label class="relative flex cursor-pointer rounded-xl border-2 border-slate-200 bg-white p-4 transition-all hover:border-slate-300 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50/30 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 has-[:focus-visible]:ring-offset-2 group">
                                <input type="radio" data-model="norender|invitedRole" name="invitedRole" value="ROLE_WORKSPACE_ADMIN" class="peer sr-only" {{ this.invitedRole == 'ROLE_WORKSPACE_ADMIN' ? 'checked' : '' }}>
                                <span class="flex flex-col w-full">
                                    <span class="flex items-center justify-between mb-2">
                                        <span class="flex items-center gap-2 text-sm font-bold text-slate-900">
                                            {{ ux_icon('lucide:shield-check', { class: 'size-4 text-slate-400 group-has-[:checked]:text-indigo-600 transition-colors' }) }}
                                            Administrateur
                                        </span>
                                        {{ ux_icon('lucide:circle-check-big', { class: 'size-4 text-indigo-600 opacity-0 peer-checked:opacity-100 transition-opacity' }) }}
                                    </span>
                                    <span class="text-xs text-slate-500 leading-relaxed">
                                        Contrôle total. Peut inviter des membres, modifier les réglages et la facturation.
                                    </span>
                                </span>
                            </label>
                        </div>
                    </fieldset>
                </div>

                <div class="flex items-center justify-end mt-8 pt-4">
                    <twig:Button as="button" type="submit" variant="dark" class="w-full sm:w-auto px-8" aria-live="polite">
                        <span data-loading="action(save)|hide">Envoyer l'invitation</span>
                        <span data-loading="action(save)|show" class="hidden items-center gap-2">
                            Envoi de l'invitation…
                        </span>
                    </twig:Button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        {# --- LES INVITATIONS EN ATTENTE (composant autonome) --- #}
        <div class="transition-opacity duration-200" data-loading="action(save)|addClass(opacity-50)">
            <twig:WorkspacePendingInvitationsComponent />
        </div>
    </div>
</div>
