<div {{ attributes }}>

    <form data-action="live#action:prevent" data-live-action-param="finish">

        {# Remplacement de la grille par un espacement vertical #}
        <div class="space-y-4">

            {# CARTE 1 : INDÉPENDANT (Tech Row) #}
            <label class="relative flex cursor-pointer items-start sm:items-center rounded-md border border-slate-200 bg-white p-4 transition-all hover:border-slate-400 has-[:checked]:border-slate-900 has-[:checked]:ring-1 has-[:checked]:ring-slate-900">
                <input type="radio" data-model="workspaceType" value="individual" class="sr-only" required>


                {# Contenu central et Badge à droite #}
                <div class="flex-1 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <span class="block text-base font-bold text-slate-900 flex flex-col sm:flex-row sm:items-center gap-2">
                            {{ ux_icon('lucide:user', { class: 'w-4 h-4 text-slate-700' }) }} Indépendant
                        </span>
                    </div>
                </div>
            </label>

            {# CARTE 2 : CABINET (Tech Row) #}
            <label class="relative flex cursor-pointer items-start sm:items-center rounded-md border border-slate-200 bg-white p-4 transition-all hover:border-slate-400 has-[:checked]:border-slate-900 has-[:checked]:ring-1 has-[:checked]:ring-slate-900">
                <input type="radio" data-model="workspaceType" value="firm" class="sr-only" required>

                <div class="flex-1 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <span class="block text-base font-bold text-slate-900 flex flex-col sm:flex-row sm:items-center gap-2">
                            {{ ux_icon('lucide:building', { class: 'w-4 h-4 text-indigo-700' }) }} Cabinet
                        </span>
                    </div>
                    {# Badge #}
                </div>

            </label>

        </div>

        <div class="mt-8 flex items-center justify-between">
            <twig:Button as="button" type="submit" variant="dark" class="w-full rounded-md px-6 py-2.5 text-sm font-semibold shadow-none">
                <span data-loading="action(finish)|hide">Continuer &rarr;</span>
                <span data-loading="action(finish)|show" class="hidden items-center gap-2">
                    {{ ux_icon('lucide:loader-2', { class: 'w-4 h-4 animate-spin' }) }}
                    Chargement
                </span>
            </twig:Button>
        </div>
    </form>
</div>
