<div{{ attributes }}>

    {# 1. SI LE FORMULAIRE EST SOUMIS (Affichage du succès) #}
    {% if this.isSuccessful %}
        <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-8 text-center shadow-sm">
            <h3 class="text-xl font-semibold tracking-tight text-slate-900">Vérifiez votre boîte mail</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                {{ this.message|default("Si cette adresse est valide, un lien magique vous a été envoyé.") }}
            </p>

            {# Bonus UX : Un bouton pour reset le composant et recommencer #}
            <twig:Button as="a" href="{{ path('app_register') }}" variant="ghost" class="text-foreground mt-5">
                Utiliser une autre adresse
            </twig:Button>
        </div>

        {# 2. SI LE FORMULAIRE N'EST PAS ENCORE SOUMIS #}
    {% else %}
        <p class="text-xs font-medium text-slate-500 mb-6">À moins d'une mention spécifique, tous les champs sont obligatoires.</p>

        <div data-controller="form">
            {{ form_start(form, {
                attr: {
                    novalidate: true,
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'save',
                }
            }) }}

            {# La Grille #}
            <div class="grid grid-cols-2 gap-5">

                {# Prénom (Colonne 1) #}
                {{ form_row(form.firstName, {
                    label: 'Prénom',
                    attr: { placeholder: 'Jean', autofocus: true }
                }) }}

                {# Nom (Colonne 2) #}
                {{ form_row(form.lastName, {
                    label: 'Nom',
                    attr: { placeholder: 'Dupont' }
                }) }}

                {# Email (Prend les 2 colonnes grâce à col-span-2) #}
                <div class="col-span-2">
                    {{ form_row(form.email, {
                        label: 'Email professionnel',
                        attr: { placeholder: 'jean.dupont@cabinet.fr' }
                    }) }}
                </div>
            </div>

            {# Le Footer / Bouton de soumission #}
            <div class="flex items-center justify-end mt-8 pt-4">
                <twig:Button as="button" type="submit" variant="dark" class="w-full sm:w-auto px-8">

                    {# Texte affiché par défaut #}
                    <span data-loading="action(save)|hide">Créer mon compte</span>

                    {# Texte affiché PENDANT la requête AJAX (Magie Symfony UX Live Component) #}
                    <span data-loading="action(save)|show" class="hidden items-center gap-2">
                        <i class="fas fa-circle-notch fa-spin opacity-70"></i> Enregistrement...
                    </span>

                </twig:Button>
            </div>

            {{ form_end(form) }}
        </div>
    {% endif %}
</div>
