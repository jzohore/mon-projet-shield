<div {{ attributes }} class="space-y-6">
    {% set items = this.members %}
    <div class="flex flex-wrap gap-4 justify-between items-center">
        <div class="relative w-full sm:w-72">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <twig:ux:icon name="tabler:search" class="size-4 text-slate-400" />
            </div>
            <input
                type="search"
                placeholder="Rechercher un email, un nom..."
                data-model="query"
                value="{{ query }}"
                class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-colors shadow-sm"
            />
        </div>
        <div class="text-sm font-medium text-slate-500 bg-white px-3 py-1.5 rounded-md shadow-sm border border-slate-200">
            <span class="text-slate-900 font-bold">{{ items.nbResults|default(items|length) }}</span> membre(s)
        </div>
    </div>

    {% if items is empty %}

        {# --- 2A. L'ÉTAT VIDE (Empty State) --- #}
        <div class="bg-white rounded-2xl p-8">
            <twig:Empty class="border border-dashed border-slate-200 bg-slate-50/50 rounded-xl py-12">
                <twig:Empty:Header>
                    <twig:Empty:Media variant="icon" class="bg-white shadow-sm ring-1 ring-slate-200">
                        <twig:ux:icon name="tabler:users-group" class="size-6 text-slate-400" />
                    </twig:Empty:Media>
                    <twig:Empty:Title class="text-lg font-bold text-slate-900 mt-4">Aucun collaborateur</twig:Empty:Title>
                    <twig:Empty:Description class="text-slate-500">
                        Vous êtes actuellement le seul membre de ce cabinet. Invitez des collaborateurs pour déléguer la gestion de la conformité.
                    </twig:Empty:Description>
                </twig:Empty:Header>
                <twig:Empty:Content class="mt-6">
                    <a href="{{ path('app_employees_invitation') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-slate-100 hover:text-accent-foreground h-9 px-4 py-2">
                        <twig:ux:icon name="tabler:mail-forward" class="size-4 mr-2" />
                        Envoyer une invitation
                    </a>
                </twig:Empty:Content>
            </twig:Empty>
        </div>

    {% else %}
        <twig:Grid:Table aria-label="Liste des collaborateurs">

            {# --- EN-TÊTE DU TABLEAU --- #}
            <twig:Grid:Header>
                <div role="columnheader" class="lg:col-span-4">Collaborateur</div>
                <div role="columnheader" class="lg:col-span-4">Niveau d'accès</div>
                <div role="columnheader" class="lg:col-span-3">Statut</div>
                <div role="columnheader" class="lg:col-span-1 text-right">Actions</div>
            </twig:Grid:Header>

            {# --- CORPS DU TABLEAU --- #}
            <twig:Grid:Body>
                {% for member in items %}
                    <twig:Grid:Row>

                        {# --- Colonne 1 : Collaborateur --- #}
                        <twig:Grid:Cell cols="4" label="Collaborateur">
                            <div class="flex items-center gap-3">
                                <div class="size-9 shrink-0 rounded-full {{ member.user.isOwner ? 'bg-slate-900 text-white' : 'bg-blue-100 text-blue-700' }} border border-slate-200 flex items-center justify-center text-xs font-bold shadow-sm" aria-hidden="true">
                                    {{ member.user.firstName|slice(0, 1) ~ member.user.lastName|split(' ')|last|slice(0, 1) }}
                                </div>
                                <div>
                                    <p class="font-bold text-slate-900">{{ member.user.fullName }}</p>
                                    <p class="text-xs text-slate-500">{{ member.user.email }}</p>
                                </div>
                            </div>
                        </twig:Grid:Cell>

                        {# --- Colonne 2 : Niveau d'accès --- #}
                        <twig:Grid:Cell cols="4" label="Niveau d'accès" class="mt-3 lg:mt-0">
                            {% if member.user.isOwner %}
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold bg-indigo-50 text-indigo-700">
                            <twig:ux:icon name="tabler:crown" class="size-3 text-indigo-500" /> Gérant(e)
                        </span>
                            {% else %}
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold bg-slate-100 text-slate-700">
                            <twig:ux:icon name="tabler:shield" class="size-3 text-slate-500" />{{ enum('App\\Domain\\Workspace\\Enum\\InvitedRole').(member.user.roles[0]).label }}
                        </span>
                            {% endif %}
                        </twig:Grid:Cell>

                        {# --- Colonne 3 : Statut --- #}
                        <twig:Grid:Cell cols="3" label="Statut" class="mt-3 lg:mt-0">
                            <div class="flex items-center gap-2">
                                {% if member.user.isActif %}
                                    <span class="relative flex size-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full size-2 bg-emerald-500"></span>
                            </span>
                                {% else %}
                                    <span class="size-2 rounded-full bg-slate-300"></span>
                                {% endif %}
                                <span class="text-xs font-medium text-slate-600">Compte {{ member.user.isActif ? 'actif' : 'non actif' }}</span>
                            </div>
                        </twig:Grid:Cell>

                        {# --- Colonne 4 : Actions --- #}
                        <twig:Grid:Cell cols="1" class="flex flex-row lg:justify-end items-center gap-2 mt-4 pt-4 lg:mt-0 lg:pt-0 border-t border-slate-100 lg:border-t-0">
                            {% if member.user.isOwner %}
                                <span class="text-xs italic text-slate-400 lg:text-right w-full">Compte principal</span>
                            {% else %}

                                {# Bouton Modifier #}
                                <twig:Button
                                    as="a"
                                    href="{{ path('app_employees_show', {slugId: member.user.slugId}) }}"
                                    class="flex-1 lg:flex-none p-2 text-slate-500 hover:text-blue-600 rounded-md hover:bg-blue-50 transition-colors border border-slate-200 lg:border-transparent flex items-center justify-center"
                                >
                                    <twig:ux:icon name="tabler:pencil" class="size-4 shrink-0" aria-hidden="true" />
                                    <span class="ml-2 lg:sr-only text-xs font-medium">Modifier</span>
                                </twig:Button>
                            {% endif %}
                        </twig:Grid:Cell>

                    </twig:Grid:Row>
                {% endfor %}
            </twig:Grid:Body>
            <twig:block name="pagination">
                {# Version Mobile (Boutons Simples) #}
                <div class="flex-1 flex justify-between md:hidden">
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="previousPage"
                            class="relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 disabled:opacity-50"
                            {% if not items.hasPreviousPage %}disabled{% endif %}>
                        Précédent
                    </button>
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="nextPage"
                            class="ml-3 relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 disabled:opacity-50"
                            {% if not items.hasNextPage %}disabled{% endif %}>
                        Suivant
                    </button>
                </div>

                {# Version Desktop (Informations + Chiffres) #}
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-slate-600">
                            Affichage de la page <span class="font-bold text-slate-900">{{ items.currentPage }}</span>
                            sur <span class="font-bold text-slate-900">{{ items.nbPages }}</span>
                        </p>
                    </div>

                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="previousPage"
                                    class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-white text-sm font-medium text-slate-500 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed"
                                    {% if not items.hasPreviousPage %}disabled{% endif %}>
                                <span class="sr-only">Précédent</span>
                                <twig:ux:icon name="tabler:chevron-left" class="size-4" />
                            </button>

                            <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-indigo-50 text-sm font-bold text-indigo-600">
                                {{ items.currentPage }}
                            </span>

                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="nextPage"
                                    class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-white text-sm font-medium text-slate-500 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed"
                                    {% if not items.hasNextPage %}disabled{% endif %}>
                                <span class="sr-only">Suivant</span>
                                <twig:ux:icon name="tabler:chevron-right" class="size-4" />
                            </button>
                        </nav>
                    </div>
                </div>
            </twig:block>
        </twig:Grid:Table>
    {% endif %}
</div>
