<div {{ attributes }}
    data-action="meeting:stopped->live#action"
    data-live-action-param="startPolling"
    {% if this.isProcessing %}data-poll="delay(3000)|checkStatus"{% endif %}
    class="w-full max-w-5xl mx-auto mb-8">

    {% set folder = this.folder %}
    {% set status = this.processingStatus %}
    {% if this.isProcessing or folder.postMeetingReport is not empty %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <button type="button" data-action="live#action" data-live-action-param="toggle"
                    class="w-full flex items-center justify-between p-3.5 hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-3">
                    <div class="p-1.5 bg-indigo-50 rounded-md text-indigo-600 ring-1 ring-indigo-500/10">
                        <twig:ux:icon name="tabler:brain" class="size-4" />
                    </div>
                    <span class="text-sm font-bold text-slate-900">Rapport d'Entretien IA</span>
                </div>

                <div class="flex items-center gap-3">
                    {% if status.value == 'finalizing' %}
                        <span class="text-[10px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1.5">
                            <twig:ux:icon name="tabler:loader-2" class="size-3 animate-spin" /> Sécurisation de l'audio...
                        </span>
                    {% elseif status.value == 'analyzing' %}
                        <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded flex items-center gap-1.5">
                            <twig:ux:icon name="tabler:loader-2" class="size-3 animate-spin" /> Analyse...
                        </span>
                    {% else %}
                        <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">Analysé</span>
                    {% endif %}
                    <twig:ux:icon name="lucide:chevron-down" class="size-4 text-slate-400 transition-transform {{ isOpen ? '-rotate-180' : '' }}" />
                </div>
            </button>

            {% if isOpen %}
                <div class="border-t border-slate-100 p-1 bg-slate-50/30">
                    {% if status.value == 'finalizing' %}
                        <div class="flex flex-col items-center justify-center p-8">
                            <twig:ux:icon name="tabler:cloud-upload" class="size-8 text-slate-300 animate-bounce mb-3" />
                            <span class="text-sm font-bold text-slate-700">Sécurisation de l'enregistrement audio...</span>
                        </div>
                    {% elseif status.value == 'analyzing' %}
                        <div class="flex flex-col items-center justify-center p-8">
                            <twig:ux:icon name="tabler:robot" class="size-8 text-indigo-300 animate-bounce mb-3" />
                            <span class="text-sm font-bold text-indigo-900">L'IA rédige la synthèse...</span>
                        </div>
                    {% elseif folder.postMeetingReport is not empty %}
                        <div class="animate-in slide-in-from-top-2 fade-in duration-300">
                            {{ include('@app/compliance/_ai_report_display.html.twig', { 'dto': folder }) }}
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
