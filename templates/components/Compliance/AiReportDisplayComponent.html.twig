{# templates/components/AiReportDisplayComponent.html.twig #}

{# 1. LE PARENT : Fusion parfaite côté serveur via .defaults() #}
<div {{ attributes.defaults({
    'id': 'meeting-ai-report',
    'data-live-ignore': 'true',
    'class': 'fixed bottom-6 right-6 lg:right-10 z-50 pointer-events-none'
}) }}
    {% if this.isProcessing %}data-poll="delay(3000)|checkStatus"{% endif %}>

    {# Boutons fantômes #}
    <button type="button" class="hidden" id="btn-start-listening" data-action="live#action" data-live-action-param="startListening"></button>
    <button type="button" class="hidden" id="btn-start-polling" data-action="live#action" data-live-action-param="startPolling"></button>

    {% set folder = this.folder %}
    {% set status = this.processingStatus %}
    {% set meeting = this.meetingReport %}
    {% if this.isListening or this.isProcessing or folder.postMeetingReport is not empty %}

        {# 2. L'ENFANT : Rôle UI et Stimulus. #}
        <div data-controller="ai-widget"
             data-ai-widget-key-value="{{ folder.slugId }}"
             class="w-[92vw] sm:w-[440px] bg-white rounded-xl shadow-[0_12px_40px_rgb(0,0,0,0.15)] border border-slate-200 flex flex-col transition-[opacity,transform,width] duration-300 ease-out opacity-0 translate-y-2 pointer-events-auto motion-reduce:transition-none">

            {# HEADER #}
            <div data-action="click->ai-widget#toggle:stop"
                 class="shrink-0 px-4 py-3 border-b border-slate-100 flex justify-between items-center cursor-pointer select-none hover:bg-slate-50 transition-colors rounded-t-xl bg-white">

                <div class="flex items-center gap-2.5 overflow-hidden">
                    <div class="flex items-center justify-center size-6 rounded-md shrink-0 {{ this.isListening ? 'bg-rose-50 text-rose-600' : 'bg-indigo-50 text-indigo-600' }}">
                        {{ ux_icon(this.isListening ? 'lucide:mic' : 'lucide:sparkles', { class: 'size-3.5' ~ (this.isListening ? ' animate-pulse' : '') }) }}
                    </div>

                    {# 🚀 AJOUT TARGET : headerText #}
                    <h3 data-ai-widget-target="headerText" class="text-sm font-semibold text-slate-900 truncate transition-colors">
                        {% if this.isListening %}
                            Capture audio active
                        {% elseif status and status.value in ['finalizing', 'analyzing'] %}
                            Assistant IA
                        {% else %}
                            Synthèse terminée
                        {% endif %}
                    </h3>
                </div>

                <div class="flex items-center gap-1 shrink-0 ml-2">
                    <button type="button" class="p-1 text-slate-400 hover:text-slate-700 rounded transition-colors" data-ai-widget-target="chevron">
                        {{ ux_icon('lucide:chevron-down', { class: 'size-4 transition-transform duration-300' }) }}
                    </button>
                </div>
            </div>

            {# CORPS PLIABLE #}
            <div data-ai-widget-target="content" class="flex flex-col w-full overflow-hidden max-h-[75vh] transition-[max-height] duration-300 ease-out motion-reduce:transition-none">
                <div class="flex-1 overflow-y-auto bg-slate-50/20">

                    {% if this.isListening %}
                        <div class="flex flex-col items-center justify-center p-10 text-center">
                            <div class="relative mb-3 mt-2">
                                {# 🚀 AJOUT TARGET : pulse + ajout transition-colors #}
                                <div data-ai-widget-target="pulse" class="absolute inset-0 bg-rose-100 rounded-full animate-ping opacity-50 transition-colors duration-300"></div>
                                <div class="relative bg-white border border-rose-100 p-3 rounded-full shadow-sm">
                                    {{ ux_icon('lucide:activity', { class: 'size-6 text-rose-500' }) }}
                                </div>
                            </div>

                            {# 🚀 AJOUT TARGET : statusText #}
                            <span data-ai-widget-target="statusText" class="text-sm font-semibold text-slate-900 transition-colors">L'IA vous écoute...</span>

                            <p class="text-xs text-slate-500 mt-1 mb-2">L'audio est crypté en temps réel.</p>
                            <span class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Cliquez sur Stop pour analyser</span>
                        </div>

                    {% elseif status and status.value == 'finalizing' %}
                        <div class="flex flex-col items-center justify-center p-10 text-center">
                            {{ ux_icon('lucide:loader-2', { class: 'size-6 text-slate-400 animate-spin mb-3 mt-2' }) }}
                            <span class="text-sm font-semibold text-slate-700">Sécurisation du fichier...</span>
                        </div>

                    {% elseif status and status.value == 'analyzing' %}
                        <div class="flex flex-col items-center justify-center p-10 text-center">
                            {{ ux_icon('lucide:sparkles', { class: 'size-6 text-indigo-500 animate-pulse mb-3 mt-2' }) }}
                            <span class="text-sm font-semibold text-indigo-900">Analyse du discours...</span>
                        </div>

                    {% elseif meeting is not empty %}
                        <div class="animate-in fade-in duration-500">
                            {% if this.isDeleted %}
                                <div class="flex items-center gap-4 border-b border-slate-200 bg-slate-50 p-6">
                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-200 text-slate-500">
                                        {{ ux_icon('lucide:trash-2', { class: 'size-5' }) }}
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-900">
                                            Synthèse effacée
                                        </p>
                                        <p class="text-xs text-slate-500 mt-0.5">
                                            Les données ont été supprimées. Vous pouvez enregistrer une nouvelle session.
                                        </p>
                                    </div>
                                </div>
                            {% else %}
                                {{ include('@app/compliance/_ai_report_display.html.twig', { 'dto': this.meetingReport, 'hide_actions': true }) }}
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                {# ─────────────────────────  BARRE D'ACTIONS  ───────────────────────── #}
                {% if not this.isDeleted and meeting is not empty and not this.isListening
                    and status.value not in ['finalizing', 'analyzing'] and meeting.isExplorable %}
                    {% set validated = this.validatedReport %}

                    <div class="rounded-b-xl border-t border-slate-100 bg-slate-50/50 px-4 py-3">

                        {% if validated %}
                            {# ── État : rapport figé ─────────────────────────────────── #}
                            <div class="flex items-start justify-between gap-4">
                                <p class="flex items-start gap-2 text-xs leading-relaxed text-slate-600">
                                    {{ ux_icon('lucide:shield-check', { class: 'size-4 shrink-0 mt-px text-emerald-600', 'aria-hidden': 'true' }) }}
                                    <span>
                                        <span class="font-medium text-slate-800">Rapport figé &middot; version&nbsp;{{ validated.version }}</span><br>
                                        <span class="text-slate-500">Le {{ validated.validatedAt|date('d/m/Y à H:i') }} par {{ validated.validatedByName }}</span>
                                    </span>
                                </p>

                                <twig:Dialog id="revoke_meeting_report">
                                    <twig:Dialog:Trigger>
                                        <twig:Button variant="outline" size="sm" {{ ...dialog_trigger_attrs }}>
                                            {{ ux_icon('lucide:pencil', { class: 'size-3.5', 'aria-hidden': 'true' }) }}
                                            Réviser
                                        </twig:Button>
                                    </twig:Dialog:Trigger>

                                    <twig:Dialog:Content>
                                        <twig:Dialog:Header>
                                            <twig:Dialog:Title class="text-slate-900">Réviser le rapport validé</twig:Dialog:Title>
                                            <twig:Dialog:Description class="mt-2 text-slate-500">
                                                La version&nbsp;{{ validated.version }} sera révoquée : elle reste archivée et consultable dans la piste d'audit, mais cesse d'être la version en vigueur. Vous pourrez ensuite valider une nouvelle version corrigée.
                                            </twig:Dialog:Description>
                                        </twig:Dialog:Header>

                                        <div class="my-4">
                                            <label for="revoke_reason" class="mb-1.5 block text-xs font-medium text-slate-700">
                                                Motif de la révision <span class="font-normal text-slate-400">— obligatoire</span>
                                            </label>
                                            <textarea id="revoke_reason" name="revoke_reason" rows="3"
                                                      data-model="revokeReason"
                                                      aria-required="true" aria-describedby="revoke_reason_hint"
                                                      class="block w-full rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus-visible:border-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-200"
                                                      placeholder="Ex : profil de risque erroné, objectifs du client incomplets…"></textarea>
                                            <p id="revoke_reason_hint" class="mt-1.5 text-xs text-slate-400">
                                                Ce motif est consigné dans la piste d'audit LCB-FT du dossier.
                                            </p>
                                        </div>

                                        <twig:Dialog:Footer>
                                            <twig:Dialog:Close>
                                                <twig:Button variant="outline" size="sm" {{ ...dialog_close_attrs }}>Annuler</twig:Button>
                                            </twig:Dialog:Close>

                                            <twig:Button type="button" variant="destructive" size="sm"
                                                         data-action="live#action"
                                                         data-live-action-param="revokeReport"
                                                         data-loading="action(revokeReport)|addAttribute(disabled)">
                                                <span data-loading="action(revokeReport)|hide" class="inline-flex items-center gap-1.5">
                                                    {{ ux_icon('lucide:rotate-ccw', { class: 'size-3.5', 'aria-hidden': 'true' }) }}
                                                    Révoquer la version&nbsp;{{ validated.version }}
                                                </span>
                                                <span data-loading="action(revokeReport)|show" class="hidden items-center gap-1.5">
                                                    {{ ux_icon('lucide:loader-2', { class: 'size-3.5 animate-spin', 'aria-hidden': 'true' }) }}
                                                    Révocation…
                                                </span>
                                            </twig:Button>
                                        </twig:Dialog:Footer>
                                    </twig:Dialog:Content>
                                </twig:Dialog>
                            </div>

                        {% else %}
                            {# ── État : brouillon prêt à valider ─────────────────────── #}
                            <div class="flex flex-col gap-2.5">
                                <p class="text-xs text-slate-500">
                                    Brouillon généré par l'IA. Le valider le fige définitivement : plus aucune modification ne sera possible ensuite.
                                </p>

                                <div class="flex items-center justify-between gap-3">
                                    {# Action destructive — discrète, à gauche #}
                                    <twig:Dialog id="delete_meetings_record">
                                        <twig:Dialog:Trigger>
                                            <twig:Button variant="ghost" size="sm" class="text-slate-500 hover:bg-red-50 hover:text-red-700" {{ ...dialog_trigger_attrs }}>
                                                {{ ux_icon('lucide:trash-2', { class: 'size-3.5', 'aria-hidden': 'true' }) }}
                                                Supprimer
                                            </twig:Button>
                                        </twig:Dialog:Trigger>

                                        <twig:Dialog:Content>
                                            <twig:Dialog:Header>
                                                <twig:Dialog:Title class="text-slate-900">Supprimer la synthèse IA</twig:Dialog:Title>
                                                <twig:Dialog:Description class="mt-2 text-slate-500">
                                                    Cette action est irréversible.
                                                </twig:Dialog:Description>
                                            </twig:Dialog:Header>

                                            <ul class="my-4 space-y-2 text-xs text-slate-600">
                                                <li class="flex items-start gap-2">
                                                    {{ ux_icon('lucide:dot', { class: 'size-4 shrink-0 text-slate-400', 'aria-hidden': 'true' }) }}
                                                    <span>Le texte généré par l'IA et vos corrections seront définitivement effacés.</span>
                                                </li>
                                                <li class="flex items-start gap-2">
                                                    {{ ux_icon('lucide:dot', { class: 'size-4 shrink-0 text-slate-400', 'aria-hidden': 'true' }) }}
                                                    <span>L'enregistrement audio source sera également supprimé, s'il existe encore.</span>
                                                </li>
                                                <li class="flex items-start gap-2">
                                                    {{ ux_icon('lucide:dot', { class: 'size-4 shrink-0 text-slate-400', 'aria-hidden': 'true' }) }}
                                                    <span>L'opération est consignée dans la piste d'audit LCB-FT du dossier.</span>
                                                </li>
                                            </ul>

                                            <twig:Dialog:Footer>
                                                <twig:Dialog:Close>
                                                    <twig:Button variant="outline" size="sm" {{ ...dialog_close_attrs }}>Annuler</twig:Button>
                                                </twig:Dialog:Close>

                                                <twig:Button type="button" variant="destructive" size="sm"
                                                             data-action="live#action"
                                                             data-live-action-param="deleteMeetingReport"
                                                             data-loading="action(deleteMeetingReport)|addAttribute(disabled)">
                                                    <span data-loading="action(deleteMeetingReport)|hide" class="inline-flex items-center gap-1.5">
                                                        {{ ux_icon('lucide:trash-2', { class: 'size-3.5', 'aria-hidden': 'true' }) }}
                                                        Supprimer définitivement
                                                    </span>
                                                    <span data-loading="action(deleteMeetingReport)|show" class="hidden items-center gap-1.5">
                                                        {{ ux_icon('lucide:loader-2', { class: 'size-3.5 animate-spin', 'aria-hidden': 'true' }) }}
                                                        Suppression…
                                                    </span>
                                                </twig:Button>
                                            </twig:Dialog:Footer>
                                        </twig:Dialog:Content>
                                    </twig:Dialog>

                                    {# Flux principal — à droite : ajuster puis valider #}
                                    <div class="flex items-center gap-1.5">
                                        <twig:Button type="button" variant="ghost" size="sm" class="text-slate-600 hover:text-slate-900">
                                            {{ ux_icon('lucide:pencil', { class: 'size-3.5', 'aria-hidden': 'true' }) }}
                                            Ajuster le texte
                                        </twig:Button>

                                        <twig:Button type="button" variant="primary" size="sm"
                                                     data-action="live#action"
                                                     data-live-action-param="validateReport"
                                                     data-loading="action(validateReport)|addAttribute(disabled)">
                                            <span data-loading="action(validateReport)|hide" class="inline-flex items-center gap-1.5">
                                                {{ ux_icon('lucide:shield-check', { class: 'size-3.5', 'aria-hidden': 'true' }) }}
                                                Valider le rapport
                                            </span>
                                            <span data-loading="action(validateReport)|show" class="hidden items-center gap-1.5">
                                                {{ ux_icon('lucide:loader-2', { class: 'size-3.5 animate-spin', 'aria-hidden': 'true' }) }}
                                                Validation…
                                            </span>
                                        </twig:Button>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
