<div {{ attributes }} class="w-full mb-6 animate-in fade-in slide-in-from-top-2 duration-300">
    {% if this.stepBannerVisible %}

        {# ÉTAT PRÊT : Le CTA (Call To Action) pour lancer l'IA #}
        <div class="bg-indigo-50/50 border border-indigo-100 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[0_1px_2px_rgba(0,0,0,0.02)] transition-all">
            {% if not this.acceptRecording %}
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center p-2 bg-white text-indigo-600 rounded-lg shadow-sm border border-indigo-100/50 shrink-0">
                        {{ ux_icon('lucide:mic', { class: 'size-4.5' }) }}
                    </div>
                    <div>
                        <h4 class="text-sm font-semibold text-slate-900">Assistant IA disponible</h4>
                        <p class="text-xs text-slate-500 mt-0.5">Voulez-vous démarrer l'enregistrement de l'entretien ?</p>
                        <p class="text-[11px] font-medium text-indigo-800/70 mt-1.5 flex items-center gap-1.5">
                            En cliquant sur "Oui", vous certifiez avoir prévenu votre client de l'enregistrement.
                        </p>
                    </div>
                </div>
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="save"
                        class="shrink-0 w-full sm:w-auto inline-flex items-center justify-center px-6 py-2 text-sm font-medium text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2 focus:ring-offset-indigo-50">
                    Oui
                </button>
            {% else %}
                <div class="flex items-center gap-3">
                    <div class="relative flex items-center justify-center size-10 rounded-full bg-slate-50 border border-slate-100 shrink-0">
                        {{ ux_icon('lucide:mic', { class: 'size-5 text-slate-400 transition-colors duration-300', 'data-meeting-recorder-target': 'micIcon' }) }}
                        {# Petit point rouge qui clignote quand ça enregistre (optionnel si tu le gères dans Stimulus) #}
                        <span class="absolute top-0 right-0 size-2.5 bg-rose-500 rounded-full border-2 border-white hidden" data-meeting-recorder-target="recordingIndicator"></span>
                    </div>
                    <div>
                        <h4 class="text-sm font-semibold text-slate-900">Enregistrement autorisé</h4>
                        <p class="text-xs text-slate-500 mt-0.5">L'assistant IA est prêt. Démarrez l'enregistrement.</p>
                    </div>
                </div>
            {% endif %}

        </div>

    {% else %}

        {# ÉTAT EN ATTENTE : Information douce #}
        <div class="bg-slate-50 border border-slate-200 border-l-4 border-l-slate-400 rounded-xl p-4 flex items-center gap-3 shadow-[0_1px_2px_rgba(0,0,0,0.02)] transition-all">
            <div class="text-slate-400 shrink-0">
                {{ ux_icon('lucide:info', { class: 'size-5' }) }}
            </div>
            <p class="text-sm text-slate-600 font-medium">
                Remplissez les informations du client pour enregistrer l'échange.
            </p>
        </div>

    {% endif %}
</div>
