<div {{ attributes }} class="space-y-6">
    {% set items = this.items %}
    <div class="flex flex-col lg:flex-row gap-4 justify-between items-center mb-6">

        {# Groupe Gauche : Recherche + Select Statut #}
        <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto">

            {# Barre de recherche existante #}
            <div class="relative w-full sm:w-72">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none" aria-hidden="true">
                    <twig:ux:icon name="tabler:search" class="size-4 text-slate-400" />
                </div>
                <input type="search"
                       aria-label="Rechercher un ticket"
                       placeholder="Sujet, catégorie, email..."
                       data-model="query"
                       value="{{ query }}"
                       class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500 sm:text-sm transition-colors shadow-sm" />
            </div>

            {# 🪄 NOUVEAU : Filtre par Statut dynamique #}
            <div class="relative w-full sm:w-48">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none" aria-hidden="true">
                    <twig:ux:icon name="tabler:filter" class="size-4 text-slate-400" />
                </div>
                <select data-model="statusFilter"
                        aria-label="Filtrer par statut"
                        class="block w-full pl-10 pr-8 py-2 border border-slate-200 rounded-lg leading-5 bg-white text-slate-700 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500 sm:text-sm transition-colors shadow-sm appearance-none cursor-pointer">
                    <option value="">Tous les statuts</option>

                    {# Boucle sur ton Enum exposée par le composant PHP #}
                    {% for status in this.statuses %}
                        <option value="{{ status.value }}" {% if this.statusFilter == status %}selected{% endif %}>
                            {{ status.label }}
                        </option>
                    {% endfor %}
                </select>
                {# Petite flèche custom pour remplacer celle par défaut du select #}
                <div class="absolute inset-y-0 right-0 pr-2 flex items-center pointer-events-none text-slate-400">
                    <twig:ux:icon name="tabler:chevron-down" class="size-4" />
                </div>
            </div>

        </div>

        {# Groupe Droite : Compteur #}
        <div class="text-sm font-medium text-slate-500 bg-white px-3 py-1.5 rounded-md shadow-sm border border-slate-200 w-full sm:w-auto text-center" aria-live="polite">
            <span class="text-slate-900 font-bold">{{ items.nbResults }}</span> dossier(s)
        </div>

    </div>

    {% if items is empty %}

        {# --- 1. L'ÉTAT VIDE (Empty State) --- #}
        <div class="bg-white rounded-2xl p-8">
            <twig:Empty class="border border-dashed border-slate-200 bg-slate-50/50 rounded-xl py-12">
                <twig:Empty:Header>
                    <twig:Empty:Media variant="icon" class="bg-white shadow-sm ring-1 ring-slate-200">
                        <twig:ux:icon name="tabler:folder-off" class="size-6 text-slate-400" />
                    </twig:Empty:Media>
                    <twig:Empty:Title class="text-lg font-bold text-slate-900 mt-4">Aucun dossier de conformité</twig:Empty:Title>
                    <twig:Empty:Description class="text-slate-500">
                        Aucun dossier n'a encore été créé dans cet espace de travail. Commencez à auditer vos clients dès maintenant.
                    </twig:Empty:Description>
                </twig:Empty:Header>
                <twig:Empty:Content class="mt-6">
                    <a href="{{ path('app_compliance_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-transparent bg-slate-900 text-white hover:bg-slate-800 h-9 px-4 py-2 shadow-sm">
                        <twig:ux:icon name="tabler:folder-plus" class="size-4 mr-2" />
                        Nouveau dossier
                    </a>
                </twig:Empty:Content>
            </twig:Empty>
        </div>

    {% else %}
        <twig:Grid:Table aria-label="Liste des dossiers de conformité">

            {# --- 2. EN-TÊTE DU TABLEAU --- #}
            <twig:Grid:Header>
                <div role="columnheader" class="lg:col-span-3">Dossier / Réf</div>
                <div role="columnheader" class="lg:col-span-2">Niveau de risque</div>
                <div role="columnheader" class="lg:col-span-2">Statut</div>
                <div role="columnheader" class="lg:col-span-2">Date de création</div>
                <div role="columnheader" class="lg:col-span-1 text-right">Actions</div>
            </twig:Grid:Header>

            {# --- 3. CORPS DU TABLEAU --- #}
            <twig:Grid:Body>
                {% for folder in items %}
                    <twig:Grid:Row>

                        {# --- Colonne 1 : Référence & Type de dossier --- #}
                        <twig:Grid:Cell cols="3" label="Dossier / Réf">
                            <div class="flex items-center gap-3">
                                <div class="size-9 shrink-0 rounded-lg bg-slate-100 text-slate-700 border border-slate-200 flex items-center justify-center shadow-sm" aria-hidden="true">
                                    {# Utilisation d'icônes adaptées si l'entité hérite de Business ou Individual #}
                                    {% if folder.class is defined and 'BusinessFolder' in folder.class %}
                                        <twig:ux:icon name="tabler:building" class="size-5 text-slate-500" />
                                    {% else %}
                                        <twig:ux:icon name="tabler:user" class="size-5 text-slate-500" />
                                    {% endif %}
                                </div>
                                <div>
                                    <div class="flex items-center gap-1.5">
                                        <p class="font-bold text-slate-900">{{ folder.reference }}</p>
                                        {% if folder.isConfidential %}
                                            <twig:ux:icon name="tabler:lock" class="size-3.5 text-amber-600" title="Confidentiel" />
                                        {% endif %}
                                        {% if folder.isCertified %}
                                            <twig:ux:icon name="tabler:discount-check-filled" class="size-4 text-blue-600" title="Certifié" />
                                        {% endif %}
                                    </div>
                                    <p class="text-xs text-slate-500">Niveau {{ folder.diligenceLevel.label|default(folder.diligenceLevel.value) }}</p>
                                </div>
                            </div>
                        </twig:Grid:Cell>



                        {# --- Colonne 3 : Niveau de Risque --- #}
                        <twig:Grid:Cell cols="2" label="Niveau de risque" class="mt-3 lg:mt-0">
                            {% if folder.riskLevel %}
                                {% set riskClasses = {
                                    'LOW': 'bg-emerald-50 text-emerald-700 border-emerald-200/60',
                                    'MEDIUM': 'bg-amber-50 text-amber-700 border-amber-200/60',
                                    'HIGH': 'bg-rose-50 text-rose-700 border-rose-200/60'
                                } %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border {{ riskClasses[folder.riskLevel.value]|default('bg-slate-50 text-slate-700') }}">
                                {{ folder.riskLevel.label|default(folder.riskLevel.value) }}
                            </span>
                            {% else %}
                                <span class="text-xs italic text-slate-400">Non évalué</span>
                            {% endif %}
                        </twig:Grid:Cell>

                        {# --- Colonne 4 : Statut --- #}
                        <twig:Grid:Cell cols="2" label="Statut" class="mt-3 lg:mt-0">
                            {% set statusClasses = {
                                'DRAFT': 'bg-slate-100 text-slate-700 border-slate-200',
                                'TO_REVIEW': 'bg-blue-50 text-blue-700 border-blue-200',
                                'APPROVED': 'bg-emerald-50 text-emerald-700 border-emerald-200',
                                'REJECTED': 'bg-rose-50 text-rose-700 border-rose-200'
                            } %}
                            <span class="{{ folder.status.badgeClasses }}">
                            {{ folder.status.label|default(folder.status.value) }}
                        </span>
                        </twig:Grid:Cell>

                        {# --- Colonne 5 : Date de création --- #}
                        <twig:Grid:Cell cols="2" label="Date" class="mt-3 lg:mt-0">
                            <div class="text-sm text-slate-600">
                                <p class="font-medium">{{ folder.createdAt|date('d/m/Y') }}</p>
                                <p class="text-xs text-slate-400">{{ folder.createdAt|date('H:i') }}</p>
                            </div>
                        </twig:Grid:Cell>

                        {# --- Colonne 6 : Actions --- #}
                        <twig:Grid:Cell cols="1" class="flex flex-row lg:justify-end items-center gap-2 mt-4 pt-4 lg:mt-0 lg:pt-0 border-t border-slate-100 lg:border-t-0">

                            {# 🪄 On interroge directement ton entité avec l'utilisateur connecté #}
                            {% if is_granted('VIEW', folder) %}

                                {# ÉTAT 1 : ACCÈS AUTORISÉ (Bouton normal) #}
                                <twig:Button
                                    as="a"
                                    href="{{ path('app_compliance_show', {slugId: folder.slugId}) }}"
                                    class="flex-1 lg:flex-none p-2 text-slate-500 hover:text-indigo-600 rounded-md hover:bg-indigo-50 transition-colors border border-slate-200 lg:border-transparent flex items-center justify-center"
                                    title="Ouvrir le dossier"
                                >
                                    <twig:ux:icon name="tabler:folder-open" class="size-4 shrink-0" aria-hidden="true" />
                                    <span class="ml-2 lg:sr-only text-xs font-medium">Ouvrir</span>
                                </twig:Button>

                            {% else %}

                                {# ÉTAT 2 : ACCÈS REFUSÉ (Bouton verrouillé) #}
                                <twig:Button
                                    as="button"
                                    disabled
                                    class="flex-1 lg:flex-none p-2 text-slate-400 bg-slate-50 cursor-not-allowed opacity-75 rounded-md border border-slate-200 lg:border-transparent flex items-center justify-center"
                                    title="Vous n'avez pas l'autorisation d'ouvrir ce dossier"
                                >
                                    <twig:ux:icon name="iconamoon:lock-fill" class="size-4 shrink-0 text-slate-400" aria-hidden="true" />
                                    <span class="ml-2 lg:sr-only text-xs font-medium text-slate-400">Verrouillé</span>
                                </twig:Button>

                            {% endif %}

                        </twig:Grid:Cell>

                    </twig:Grid:Row>
                {% endfor %}
            </twig:Grid:Body>

            {# --- 4. CONFIGURATION PAGINATION --- #}
            <twig:block name="pagination">
                {# Version Mobile #}
                <div class="flex-1 flex justify-between md:hidden">
                    <button type="button" data-action="live#action" data-live-action-param="previousPage" class="relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 disabled:opacity-50" {% if not items.hasPreviousPage %}disabled{% endif %}>
                        Précédent
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="nextPage" class="ml-3 relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 disabled:opacity-50" {% if not items.hasNextPage %}disabled{% endif %}>
                        Suivant
                    </button>
                </div>

                {# Version Desktop #}
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-slate-600">
                            Dossiers <span class="font-bold text-slate-900">{{ items.currentPage }}</span> sur <span class="font-bold text-slate-900">{{ items.nbPages }}</span>
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <button type="button" data-action="live#action" data-live-action-param="previousPage" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-white text-sm font-medium text-slate-500 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed" {% if not items.hasPreviousPage %}disabled{% endif %}>
                                <twig:ux:icon name="tabler:chevron-left" class="size-4" />
                            </button>
                            <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-indigo-50 text-sm font-bold text-indigo-600">
                            {{ items.currentPage }}
                        </span>
                            <button type="button" data-action="live#action" data-live-action-param="nextPage" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-white text-sm font-medium text-slate-500 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed" {% if not items.hasNextPage %}disabled{% endif %}>
                                <twig:ux:icon name="tabler:chevron-right" class="size-4" />
                            </button>
                        </nav>
                    </div>
                </div>
            </twig:block>
        </twig:Grid:Table>
    {% endif %}
</div>
