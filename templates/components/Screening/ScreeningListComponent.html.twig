<div {{ attributes }} class="space-y-6">
    {% set items = this.screeningList %}

    {# --- 1. BARRE D'OUTILS (Recherche & Compteur) --- #}
    <div class="flex flex-wrap gap-4 justify-between items-center">
        <div class="relative w-full sm:w-72">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <twig:ux:icon name="tabler:search" class="size-4 text-slate-400" />
            </div>
            <input
                type="search"
                placeholder="Rechercher un nom, une entité..."
                data-model="query"
                value="{{ query }}"
                class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-colors shadow-sm"
            />
        </div>
        <div class="text-sm font-medium text-slate-500 bg-white px-3 py-1.5 rounded-md shadow-sm border border-slate-200">
            <span class="text-slate-900 font-bold">{{ items.nbResults|default(items|length) }}</span> recherche(s)
        </div>
    </div>

    {# --- 2. GESTION DE L'AFFICHAGE --- #}
    {% if items is empty %}

        {# --- 2A. L'ÉTAT VIDE (Empty State) --- #}
        <div class="bg-white rounded-2xl p-8 shadow-sm">
            <twig:Empty class="border border-dashed border-slate-200 bg-slate-50/50 rounded-xl py-12">
                <twig:Empty:Header>
                    <twig:Empty:Media variant="icon" class="bg-white shadow-sm ring-1 ring-slate-200">
                        <twig:ux:icon name="tabler:user-search" class="size-6 text-slate-400" />
                    </twig:Empty:Media>
                    <twig:Empty:Title class="text-lg font-bold text-slate-900 mt-4">Aucun historique de criblage</twig:Empty:Title>
                    <twig:Empty:Description class="text-slate-500">
                        Vous n'avez pas encore effectué de recherche LCB-FT. Vérifiez instantanément une personne ou une entreprise.
                    </twig:Empty:Description>
                </twig:Empty:Header>
                <twig:Empty:Content class="mt-6">
                    <a href="{{ path('app_screening_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-transparent bg-slate-900 text-white hover:bg-slate-800 h-9 px-4 py-2 shadow-sm">
                        <twig:ux:icon name="tabler:search" class="size-4 mr-2" />
                        Nouvelle recherche
                    </a>
                </twig:Empty:Content>
            </twig:Empty>
        </div>

    {% else %}

        {# --- 2B. LE TABLEAU DE DONNÉES --- #}
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
            <div class="overflow-x-auto">
                <twig:Table>
                    <twig:Table:Header class="bg-slate-50/80 border-b border-slate-200">
                        <twig:Table:Row class="border-none">
                            <twig:Table:Head class="text-slate-500 font-semibold text-xs uppercase tracking-wider">Entité Recherchée</twig:Table:Head>
                            <twig:Table:Head class="text-slate-500 font-semibold text-xs uppercase tracking-wider">Analyse (PEP / Sanctions)</twig:Table:Head>
                            <twig:Table:Head class="text-slate-500 font-semibold text-xs uppercase tracking-wider">Certificat</twig:Table:Head>
                            <twig:Table:Head class="text-right text-slate-500 font-semibold text-xs uppercase tracking-wider">Actions</twig:Table:Head>
                        </twig:Table:Row>
                    </twig:Table:Header>

                    <twig:Table:Body class="divide-y divide-slate-100">
                        {% for audit in items %}
                            <twig:Table:Row class="hover:bg-slate-50/50 transition-colors">

                                {# Colonne 1 : La Requête (Le nom cherché + Date) #}
                                <twig:Table:Cell>
                                    <div class="mb-1">
                                        <span class="font-mono text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                            {{ audit.createdAt|date('d/m/Y à H:i') }}
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <div>
                                            <p class="font-bold text-slate-900 uppercase">{{ audit.query }}</p>
                                        </div>
                                    </div>
                                </twig:Table:Cell>

                                {# Colonne 2 : L'Analyse des Risques (Basée sur totalMatches) #}
                                <twig:Table:Cell>
                                    {% if audit.totalMatches == 0 %}
                                        <div class="flex items-center gap-2">
                                            <div class="size-6 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
                                                <twig:ux:icon name="tabler:check" class="size-3.5 text-emerald-600" />
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-emerald-700">Aucun résultat trouvé</p>
                                                <p class="text-xs text-slate-500">Profil jugé sans risque</p>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="flex items-center gap-2">
                                            <div class="size-6 rounded-full bg-rose-100 flex items-center justify-center shrink-0">
                                                <twig:ux:icon name="tabler:alert-triangle" class="size-3.5 text-rose-600" />
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-rose-700">{{ audit.totalMatches }} correspondance(s)</p>
                                                <p class="text-xs text-slate-500">Vérification requise</p>
                                            </div>
                                        </div>
                                    {% endif %}
                                </twig:Table:Cell>

                                {# Colonne 3 : Statut du Certificat PDF #}
                                <twig:Table:Cell>
                                    {% set statusColors = {
                                        'wait': 'bg-blue-100 text-blue-800 border-blue-200',
                                        'pending': 'bg-amber-100 text-amber-800 border-amber-200',
                                        'generated': 'bg-emerald-100 text-emerald-800 border-emerald-200',
                                        'failed': 'bg-red-100 text-red-800 border-red-200'
                                    } %}
                                    {% set statusDots = {
                                        'wait': 'bg-blue-500 animate-pulse',
                                        'pending': 'bg-amber-500 animate-pulse',
                                        'generated': 'bg-emerald-500',
                                        'failed': 'bg-red-500'
                                    } %}

                                    {% set colorClass = statusColors[audit.status.value] | default('bg-slate-100 text-slate-800 border-slate-200') %}
                                    {% set dotClass = statusDots[audit.status.value] | default('bg-slate-500') %}

                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium ring-1 ring-inset {{ colorClass }}">
                                        <span class="h-1.5 w-1.5 rounded-full {{ dotClass }}"></span>
                                        {{ audit.status.label }}
                                    </span>
                                </twig:Table:Cell>

                                {# Colonne 4 : Actions #}
                                <twig:Table:Cell class="text-right">
                                    <div class="flex justify-end gap-1">
                                        <twig:Button as="a" href="{{ path('app_screening_show',{slugId: audit.slugId}) }}"
                                                     variant="outline" size="sm" class="p-2 text-slate-400 hover:text-slate-900 rounded-md hover:bg-slate-100 transition-colors border-0"
                                                     title="Consulter l'historique">
                                            <twig:ux:icon name="tabler:eye" class="size-4" />
                                        </twig:Button>
                                    </div>
                                </twig:Table:Cell>

                            </twig:Table:Row>
                        {% endfor %}
                    </twig:Table:Body>
                </twig:Table>
            </div>

            {# --- 2C. LA PAGINATION --- #}
            <div class="border-t border-slate-200 bg-slate-50/50 px-4 py-3 flex items-center justify-between sm:px-6 mt-auto">

                {# Version Mobile (Boutons Simples) #}
                <div class="flex-1 flex justify-between md:hidden">
                    <button type="button" data-action="live#action" data-live-action-param="previousPage" class="relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50">
                        Précédent
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="nextPage" class="ml-3 relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50">
                        Suivant
                    </button>
                </div>

                {# Version Desktop (Informations + Chiffres) #}
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-slate-600">
                            Affichage de la page <span class="font-bold text-slate-900">{{ this.page|default(1) }}</span>
                            sur <span class="font-bold text-slate-900">{{ items.nbResults|default(items|length) }}</span> résultats
                        </p>
                    </div>

                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            {# Bouton Précédent #}
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="previousPage"
                                    class="cursor-pointer relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-white text-sm font-medium text-slate-500 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed"
                                    {% if this.page|default(1) <= 1 %}disabled{% endif %}>
                                <span class="sr-only">Précédent</span>
                                <twig:ux:icon name="tabler:chevron-left" class="size-4" />
                            </button>

                            {# Info Page Centrale (optionnel, pour montrer où on est) #}
                            <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-indigo-50 text-sm font-bold text-indigo-600">
                                {{ this.page|default(1) }}
                            </span>

                            {# Bouton Suivant #}
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="nextPage"
                                    class="cursor-pointer relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-white text-sm font-medium text-slate-500 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed"
                                {# Remplace "has_next_page" par ta propre logique PHP pour désactiver la suite #}
                                {% if items|length < 10 %}disabled{% endif %}>
                                <span class="sr-only">Suivant</span>
                                <twig:ux:icon name="tabler:chevron-right" class="size-4" />
                            </button>
                        </nav>
                    </div>
                </div>
            </div>

        </div>

    {% endif %}
</div>
