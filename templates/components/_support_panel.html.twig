<div
     class="relative z-50"
     aria-labelledby="slide-over-title"
     role="dialog"
     aria-modal="true">

    {# Overlay sombre (Background) #}
    <div data-support-target="overlay"
         data-action="click->support#close"
         class="fixed inset-0 bg-slate-900/20 backdrop-blur-sm transition-opacity hidden"></div>

    {# Le Panneau Coulissant #}
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute inset-y-0 right-0 flex max-w-full pl-10 pointer-events-none">

            <div data-support-target="panel"
                 class="w-screen max-w-md transform transition ease-in-out duration-500 translate-x-full pointer-events-auto flex flex-col bg-slate-50 shadow-2xl">

                {# HEADER : Rassurant et humain #}
                <div class="bg-white px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="relative">
                            {# Ta photo ou un bel avatar Kysure #}
                            <div class="flex size-7 items-center justify-center rounded bg-black text-white font-bold text-sm" aria-hidden="true">K</div>
                        </div>
                        <div>
                            <h2 class="text-sm font-bold text-slate-900" id="slide-over-title">Support Kysure</h2>
                            <p class="text-xs text-slate-500">On vous répond en moins de 2 heures ⚡️</p>
                        </div>
                    </div>
                    <button type="button" data-action="click->support#close" class="text-slate-400 hover:text-slate-500 p-2 rounded-lg hover:bg-slate-50 transition">
                        {{ ux_icon('lucide:x', { class: 'size-5' }) }}
                    </button>
                </div>

                {# BODY : L'historique façon "iMessage/WhatsApp" #}
                <div data-support-target="messages" class="flex-1 overflow-y-auto p-6 space-y-6">

                    {# Message de bienvenue (Automatique) #}
                    <div class="flex gap-3 max-w-[85%]">
                        <img src="{{ asset('build/images/avatar-support.png') }}" class="size-8 rounded-full flex-shrink-0">
                        <div>
                            <div class="bg-white border border-slate-200 text-slate-700 text-sm p-3 rounded-2xl rounded-tl-none shadow-sm">
                                Bonjour {{ app.user.firstName }} 👋<br>
                                Une question sur vos analyses ou votre facturation ? Je suis là pour vous aider.
                            </div>
                            <span class="text-[10px] text-slate-400 mt-1 ml-1 block">Aujourd'hui, 09:00</span>
                        </div>
                    </div>

                    {# Exemple d'un ancien message du client #}
                    <div class="flex gap-3 max-w-[85%] ml-auto justify-end">
                        <div>
                            <div class="bg-indigo-600 text-white text-sm p-3 rounded-2xl rounded-tr-none shadow-sm">
                                Comment je fais pour inviter mon associé sur ce workspace ?
                            </div>
                            <span class="text-[10px] text-slate-400 mt-1 mr-1 block text-right">Lu</span>
                        </div>
                    </div>

                </div>

                {# FOOTER : L'input ultra simple #}
                <div class="bg-white border-t border-slate-100 p-4">
                    <form data-action="submit->support#sendMessage" class="relative flex items-end gap-2">

                        {# Le contexte invisible (La fameuse Claque technique) #}
                        <input type="hidden" name="current_url" value="{{ app.request.uri }}">
                        <input type="hidden" name="workspace_id" value="{{ workspaceInfo().slugId }}">

                        <textarea data-support-target="input"
                                  name="message"
                                  rows="1"
                                  placeholder="Écrivez votre message..."
                                  class="block w-full resize-none rounded-xl border-0 py-3 pl-4 pr-12 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 min-h-[44px] max-h-32"
                                  data-action="keydown.enter->support#submitOnEnter"></textarea>

                        <button type="submit" class="absolute right-2 bottom-1.5 p-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition shadow-sm">
                            {{ ux_icon('lucide:send', { class: 'size-4' }) }}
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
