{# Composant conteneur principal #}
<div role="table" {{ attributes.defaults({'class': 'bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col'}) }}>
    <div class="overflow-x-auto">
        {% block content %}{% endblock %}
    </div>

    {# Emplacement dédié à la pagination en bas de tableau #}
    {% if block('pagination') is defined %}
        <div class="border-t border-slate-200 bg-slate-50/50 px-4 py-3 sm:px-6 mt-auto">
            {% block pagination %}{% endblock %}
        </div>
    {% endif %}
</div>
