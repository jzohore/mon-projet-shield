{# templates/portal/signature_frame.html.twig #}
<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <title>KYSURE — Signature de votre document</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-full flex flex-col items-center justify-center p-6 antialiased text-slate-900 bg-slate-50">

<div class="w-full max-w-sm mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 p-8 text-center animate-fade-in relative overflow-hidden">

    {# Petite barre de progression visuelle en haut de la carte #}
    <div class="absolute top-0 left-0 h-1 bg-emerald-500 w-full animate-pulse"></div>

    {% if docusealUrl %}

        <div class="flex items-center justify-center size-16 rounded-full bg-emerald-50 text-emerald-600 ring-8 ring-emerald-50/50 mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-8" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                <path d="M9 12l2 2l4 -4"></path>
            </svg>
        </div>

        <h1 class="text-xl font-bold text-slate-900 mb-2">Espace de signature</h1>
        <p class="text-sm text-slate-500 mb-8">
            Vous allez être redirigé vers notre environnement de signature certifié dans un instant.
        </p>

        <a href="{{ docusealUrl }}"
           class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900 transition-colors">
            Ouvrir le document maintenant
        </a>

        {# Redirection automatique fluide #}
        <script>
            // On laisse 1.5s au client pour lire le contexte avant de le rediriger
            setTimeout(function() {
                window.location.href = "{{ docusealUrl|raw }}";
            }, 1500);
        </script>

    {% else %}

        {# Fallback : Le document n'est pas encore prêt (Génération asynchrone en cours) #}
        <div class="flex items-center justify-center mb-6">
            <div class="animate-spin rounded-full h-12 w-12 border-2 border-indigo-600 border-t-transparent"></div>
        </div>

        <h1 class="text-lg font-bold text-slate-900 mb-2">Sécurisation en cours</h1>
        <p class="text-sm text-slate-500 mb-6">
            Votre dossier est en cours de préparation. Veuillez ne pas fermer cette page.
        </p>

        {# Polling automatique pour rafraîchir la page jusqu'à ce que l'URL soit dispo #}
        <script>
            setTimeout(() => { window.location.reload(); }, 3000);
        </script>

    {% endif %}
</div>

<div class="mt-8 flex items-center justify-center gap-2 text-xs font-medium text-slate-400">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6z"></path>
        <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0"></path>
        <path d="M8 11v-4a4 4 0 1 1 8 0v4"></path>
    </svg>
    Propulsé par KYSURE
</div>

</body>
</html>
