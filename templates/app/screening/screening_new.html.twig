{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('app_screening_list') }}" class="text-xs">
            Criblage LCB-FT
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}
{% block content %}
    <div class="max-w-7xl mx-auto">

        <div class="mb-8">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title }}</h1>
        </div>

        <div class="max-w-3xl mx-auto py-12 px-4 sm:px-6 lg:px-8">

            <div class="mb-8">
                <twig:Button as="a" href="{{ path('app_screening_list') }}" variant="link">
                    <twig:ux:icon name="solar:arrow-left-bold" class="size-4" />
                    Retour à la liste
                </twig:Button>

            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-500 to-indigo-500"></div>
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-slate-900">Nouvelle recherche de criblage</h3>


                    <twig:ScreeningSearchComponent userSlugId="{{ app.user.id }}" userEmail="{{ app.user.email }}"></twig:ScreeningSearchComponent>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
