{# templates/dashboard/index.html.twig #}
{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} - {{ company_name }}{% endblock %}

{% block content %}
    {% set is_cabinet = workspaceInfo().isFirm %}
    {# HEADER : LES 3 ACTIONS CLÉS #}
    <header class="flex flex-col lg:flex-row lg:items-end">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Espace  <span class="text-blue-600">{{ workspaceInfo().name | lower | capitalize }}</span></h1>
            <p class="text-sm text-slate-500 mt-1">Gérez vos analyses de conformité et vos rapports d'adéquation.</p>
        </div>
    </header>

    {# SECTION KPIs #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {# SOLDE #}
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm group">
            {% if is_cabinet %}
                <div class="flex justify-between items-start mb-2">
                    <h2 class="text-sm font-medium text-slate-500">Analyses ce mois-ci</h2>
                    {{ ux_icon('lucide:activity', { class: 'size-4 text-indigo-500' }) }}
                </div>
                <div class="flex items-baseline gap-2 mt-2">
                    <span class="text-3xl font-bold text-slate-900">{{ subInfo().searchesUsedThisMonth }}<span class="text-lg text-slate-400">/{{ subInfo().maxSearches }}</span></span>
                </div>
            {% else %}
                <div class="flex justify-between items-start mb-2">
                    <h2 class="text-sm font-medium text-slate-500">Crédits disponibles</h2>
                    {{ ux_icon('lucide:wallet', { class: 'size-4 text-emerald-500' }) }}
                </div>
                <div class="flex items-baseline gap-2 mt-2">
                    <span class="text-3xl font-bold text-slate-900"><twig:HeaderCreditsCounter /></span>
                    <a href="{{ path('app_settings_billing') }}" class="text-xs font-medium text-emerald-600 hover:underline">Recharger</a>
                </div>
            {% endif %}
        </div>

        {# EN COURS #}
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
            <div class="flex justify-between items-start mb-2">
                <h2 class="text-sm font-medium text-slate-500">Dossiers en cours</h2>
                {{ ux_icon('lucide:loader-2', { class: 'size-4 text-amber-500 animate-spin-slow' }) }}
            </div>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="text-3xl font-bold text-slate-900">{{ stats_user.folderDraftWorkspaces }}</span>
                <span class="text-xs text-slate-500">KYC/KYB actifs</span>
            </div>
        </div>

        {# ADVISORY #}
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
            <div class="flex justify-between items-start mb-2">
                <h2 class="text-sm font-medium text-slate-500">Rapports Advisory</h2>
                {{ ux_icon('lucide:file-text', { class: 'size-4 text-emerald-500' }) }}
            </div>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="text-3xl font-bold text-slate-900">12</span>
                <span class="text-xs text-slate-500">ce mois-ci</span>
            </div>
        </div>

        {# ALERTES #}
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
            <div class="flex justify-between items-start mb-2">
                <h2 class="text-sm font-medium text-slate-500">Alertes Risques</h2>
                {{ ux_icon('lucide:shield-alert', { class: 'size-4 text-red-500' }) }}
            </div>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="text-3xl font-bold text-slate-900">0</span>
                <span class="text-xs text-slate-500">Sanctions/PEPs</span>
            </div>
        </div>
    </div>

    {# ACTIVITÉ RÉCENTE #}
    <section>
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold text-slate-900">Activité récente</h2>
            <a href="#" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Voir tout</a>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-16 text-center">
                <div class="size-16 rounded-full bg-slate-50 flex items-center justify-center border border-slate-100 mb-4 mx-auto">
                    {{ ux_icon('lucide:fingerprint', { class: 'size-8 text-slate-300' }) }}
                </div>
                <h4 class="text-base font-semibold text-slate-900">Prêt à sécuriser vos relations ?</h4>
                <p class="text-sm text-slate-500 mt-2 max-w-sm mx-auto">
                    Lancez un premier module pour générer vos fiches de synthèse ou vos rapports d'adéquation.
                </p>
            </div>
        </div>
    </section>

    {# ========================================================= #}
    {# WIDGET ONBOARDING (Stimulus)                              #}
    {# ========================================================= #}

    {% if not app.user.profile.dismissOnboarding %}
        <div data-controller="onboarding"
             data-onboarding-target="widget"
             data-onboarding-dismiss-url-value="{{ path('app_user_dismiss_onboarding') }}"
             class="fixed bottom-6 right-14 w-85 bg-white rounded-md shadow-[0_20px_50px_rgba(0,0,0,0.15)] border border-slate-200 z-50 flex flex-col transition-all duration-500 ease-in-out">

            {# HEADER #}
            <div data-action="click->onboarding#toggle" class="px-5 py-4 border-b border-slate-50 flex justify-between items-center cursor-pointer select-none">
                <div>
                    <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        Configuration
                    </h3>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" class="p-1.5 cursor-pointer text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100 transition-colors">
                        {{ ux_icon('lucide:chevron-down', { class: 'size-4' }) }}
                    </button>
                    <button type="button"
                            data-action="click->onboarding#dismiss"
                            class="p-1.5 cursor-pointer text-slate-400 hover:text-red-500 rounded-lg hover:bg-red-50 transition-colors">
                        {{ ux_icon('lucide:x', { class: 'size-4' }) }}
                    </button>
                </div>
            </div>

            {# CONTENT #}
            <div data-onboarding-target="content" class="overflow-hidden transition-all duration-300 max-h-[450px]">
                <div class="p-3 space-y-1">

                    {# ÉTAPE 1 : OK #}
                    <div class="flex items-center gap-3 p-3 rounded-xl opacity-50">
                        <div class="size-5 rounded-full bg-emerald-100 flex items-center justify-center">
                            {{ ux_icon('lucide:check', { class: 'size-3 text-emerald-600' }) }}
                        </div>
                        <span class="text-sm font-medium text-slate-600 line-through">Compte vérifié</span>
                    </div>

                    {# ÉTAPE 2 : KYC #}
                    {% set kyc_done = count_members|default(0) >= 1 %}
                    <div class="flex items-start gap-3 p-3 rounded-xl {{ kyc_done ? 'opacity-50' : 'bg-indigo-50/50' }}">
                        <div class="mt-0.5 size-5 rounded-full {{ kyc_done ? 'bg-emerald-100' : 'border-2 border-indigo-500' }} flex items-center justify-center">
                            {% if kyc_done %}
                                {{ ux_icon('lucide:check', { class: 'size-3 text-emerald-600' }) }}
                            {% else %}
                                <div class="size-1.5 bg-indigo-500 rounded-full"></div>
                            {% endif %}
                        </div>
                        <div class="flex-1">
                            {% if not kyc_done %}
                                <a href="{{ path('app_kyc_invitation') }}" class="group">
                                    <p class="text-sm font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">Lancer un premier KYC</p>
                                    <p class="text-xs text-slate-500 mt-0.5">Identifiez votre premier client physique.</p>
                                </a>
                            {% else %}
                                <p class="text-sm font-medium text-slate-600 line-through">Module KYC testé</p>
                            {% endif %}
                        </div>
                    </div>

                    {# ÉTAPE 3 : ADVISORY / KBIS #}
                    <div class="flex items-start gap-3 p-3 rounded-xl group hover:bg-slate-50 transition-colors">
                        <div class="mt-0.5 size-5 rounded-full border-2 border-slate-200 group-hover:border-slate-400 flex items-center justify-center transition-colors"></div>
                        <div class="flex-1">
                            <a href="#" class="block">
                                <p class="text-sm font-medium text-slate-700">Découvrir le module KYB</p>
                                <p class="text-xs text-slate-500 mt-0.5">Analysez une structure morale complexe.</p>
                            </a>
                        </div>
                    </div>

                    {# ÉTAPE 4 : BILLING #}
                    <div class="flex items-start gap-3 p-3 rounded-xl group hover:bg-slate-50 transition-colors">
                        <div class="mt-0.5 size-5 rounded-full border-2 border-slate-200 group-hover:border-slate-400 flex items-center justify-center transition-colors"></div>
                        <div class="flex-1">
                            {% if is_cabinet %}
                                <a href="{{ path('app_employees_invitation') }}" class="block">
                                    <p class="text-sm font-medium text-slate-700">Inviter des collaborateurs</p>
                                    <p class="text-xs text-slate-500 mt-0.5">Travaillez en équipe sur vos dossiers.</p>
                                </a>
                            {% else %}
                                <a href="{{ path('app_settings_billing') }}" class="block">
                                    <p class="text-sm font-medium text-slate-700">Recharger des crédits</p>
                                    <p class="text-xs text-slate-500 mt-0.5">Packs de crédits sans expiration.</p>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}
