{% extends '@admin/base.html.twig' %}

{% block title %}{{ page_title}} - {{ company_name }}{% endblock %}

{% block content %}
    <div class="min-h-screen bg-slate-50/50 p-6 lg:p-12">
        <div class="max-w-5xl mx-auto">

            {# 1. BANDEAU DE BIENVENUE #}
            <header class="mb-10 animate-in fade-in slide-in-from-left duration-700">
                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    Ravi de vous voir, {{ app.user.firstName }}.
                </h1>
                <p class="text-slate-500 mt-2 text-lg">
                    Par quoi commence-t-on aujourd'hui ?
                </p>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                {# 2. LA CHECKLIST DE DÉMARRAGE (Colonne principale) #}
                <div class="lg:col-span-2 space-y-4">

                    {# On ne montre le bloc que s'il reste des étapes non ignorées et non complétées #}
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-6 border-b border-slate-100 bg-slate-50/50">
                            <h2 class="font-semibold text-slate-900 flex items-center gap-2">
                                Guide de démarrage rapide
                            </h2>
                        </div>

                        <div class="p-6 space-y-3">

                            {# --- ÉTAPE 1 : TOUJOURS COMPLÉTÉE (ID: workspace_created) --- #}
                            <div id="step_workspace_created" class="flex items-center gap-4 p-4 rounded-xl bg-emerald-50 border border-emerald-100 transition-all">
                                <div class="flex-shrink-0 size-6 rounded-full bg-emerald-500 flex items-center justify-center">
                                    {{ ux_icon('lucide:check', { class: 'size-4 text-white' }) }}
                                </div>
                                <div class="flex-1">
                                    <p class="text-sm font-semibold text-emerald-900 text-decoration-line-through">Espace de travail créé</p>
                                </div>
                            </div>

                            {# --- ÉTAPE 2 : INVITER (ID: invite_team) --- #}
                            {% if not app.user.isStepDismissed('invite_team') %}
                                {% if count_members >= 1 %}
                                    <div id="step_invite_team" class="flex items-center gap-4 p-4 rounded-xl bg-emerald-50 border border-emerald-100 transition-all">
                                        <div class="flex-shrink-0 size-6 rounded-full bg-emerald-500 flex items-center justify-center">
                                            {{ ux_icon('lucide:check', { class: 'size-4 text-white' }) }}
                                        </div>
                                        <div class="flex-1">
                                            <p class="text-sm font-semibold text-slate-900">Inviter votre premier collaborateur</p>
                                        </div>
                                    </div>
                                {% else %}
                                    <div id="step_invite_team" class="group relative flex items-center gap-4 p-4 rounded-xl border border-slate-200 bg-white hover:border-indigo-300 transition-all">
                                        <div class="flex-shrink-0 size-6 rounded-full border-2 border-slate-200 flex items-center justify-center">
                                            <span class="text-[10px] font-bold text-slate-400">2</span>
                                        </div>
                                        <div class="flex-1">
                                            <a href="{{ path('app_employees_invitation') }}" class="stretched-link">
                                                <p class="text-sm font-semibold text-slate-900">Inviter votre premier collaborateur</p>
                                                <p class="text-xs text-slate-500">Travaillez en équipe sur vos dossiers.</p>
                                            </a>
                                        </div>
                                        {# Bouton Ignorer (Croix) #}
                                        <button type="button" title="Ignorer cette étape" class="z-10 p-1 rounded-md hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition-colors">
                                            {{ ux_icon('lucide:x', { class: 'size-4' }) }}
                                        </button>
                                    </div>
                                {% endif %}

                            {% endif %}

                            {# --- ÉTAPE 3 : KYC (ID: first_kyc) --- #}
                            {% if not app.user.isStepDismissed('first_kyc') %}
                                <div id="step_first_kyc" class="group relative flex items-center gap-4 p-4 rounded-xl border border-slate-200 bg-white hover:border-indigo-300 transition-all">
                                    <div class="flex-shrink-0 size-6 rounded-full border-2 border-slate-200 flex items-center justify-center">
                                        <span class="text-[10px] font-bold text-slate-400">3</span>
                                    </div>
                                    <div class="flex-1">
                                        <a href="#" class="stretched-link">
                                            <p class="text-sm font-semibold text-slate-900">Effectuer votre premier contrôle KYC</p>
                                            <p class="text-xs text-slate-500">Lancez une analyse sur une personne.</p>
                                        </a>
                                    </div>
                                    <button type="button" title="Ignorer cette étape" class="z-10 p-1 rounded-md hover:bg-slate-100 text-slate-400 hover:text-slate-600">
                                        {{ ux_icon('lucide:x', { class: 'size-4' }) }}
                                    </button>
                                </div>
                            {% endif %}

                            {# --- ÉTAPE 4 : ALERTE (ID: setup_alerts) --- #}
                            {% if not app.user.isStepDismissed('setup_alerts') %}
                                <div id="step_setup_alerts" class="group relative flex items-center gap-4 p-4 rounded-xl border border-slate-200 bg-white hover:border-indigo-300 transition-all">
                                    <div class="flex-shrink-0 size-6 rounded-full border-2 border-slate-200 flex items-center justify-center">
                                        <span class="text-[10px] font-bold text-slate-400">4</span>
                                    </div>
                                    <div class="flex-1">
                                        <a href="#" class="stretched-link">
                                            <p class="text-sm font-semibold text-slate-900">Configurer vos alertes</p>
                                            <p class="text-xs text-slate-500">Soyez notifié en cas de changement de statut.</p>
                                        </a>
                                    </div>
                                    <button type="button" title="Ignorer cette étape" class="z-10 p-1 rounded-md hover:bg-slate-100 text-slate-400 hover:text-slate-600">
                                        {{ ux_icon('lucide:x', { class: 'size-4' }) }}
                                    </button>
                                </div>
                            {% endif %}

                        </div>

                        {# Optionnel : Un bouton pour tout masquer d'un coup #}
                        <div class="bg-slate-50 px-6 py-3 border-t border-slate-100">
                            <button class="text-[11px] font-medium text-slate-400 hover:text-slate-600 uppercase tracking-wider">
                                Masquer le guide de démarrage
                            </button>
                        </div>
                    </div>
                </div>

                {# 3. STATISTIQUES RAPIDES (Colonne latérale) #}
                <div class="space-y-6">
                    <div class="bg-slate-900 rounded-2xl p-6 text-white shadow-xl shadow-slate-900/20">
                        <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Status RegTech</p>
                        <div class="flex items-center gap-2">
                            <div class="size-2 rounded-full bg-emerald-500 animate-pulse"></div>
                            <span class="text-lg font-medium">Opérationnel</span>
                        </div>
                        <hr class="my-4 border-slate-800">
                        <p class="text-sm text-slate-400 leading-relaxed">
                            Toutes les bases de données (Sanctions, PEP, Adverse Media) sont à jour.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
