{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('app_employees_list') }}" class="text-xs">
            Équipe & Accès
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}

{% block content %}
    <div class="max-w-3xl mx-auto">

        <div class="mb-8">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title }}</h1>
            <p class="text-sm text-slate-500 mt-1">Gérez les accès de votre équipe à la plateforme {{ company_name }}.</p>
        </div>

        {% if not is_admin %}
            {# ── Non-administrateur : accès refusé à l'action ── #}
            <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
                <span class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-500" aria-hidden="true">
                    {{ ux_icon('lucide:lock', { class: 'size-5' }) }}
                </span>
                <h2 class="text-base font-semibold text-slate-900">Réservé aux administrateurs</h2>
                <p class="mt-1 text-sm text-slate-500">Seul un administrateur de cet espace de travail peut inviter des collaborateurs.</p>
                <div class="mt-4">
                    <twig:Button as="a" href="{{ path('app_employees_list') }}" variant="outline" size="sm">Retour à l'équipe</twig:Button>
                </div>
            </div>

        {% elseif not has_free_seat %}
            {# ── Sièges épuisés : on bloque le formulaire, on pousse vers l'ajout de sièges ── #}
            <div class="rounded-xl border border-slate-200 border-l-4 border-l-amber-500 bg-white p-8 shadow-sm">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 shrink-0 text-amber-500" aria-hidden="true">{{ ux_icon('lucide:users', { class: 'size-5' }) }}</span>
                    <div class="min-w-0">
                        <h2 class="text-base font-semibold text-slate-900">
                            Tous vos sièges sont utilisés
                            <span class="ml-1 font-normal text-slate-500 tabular-nums">({{ seats_used }} / {{ seats_allowed }})</span>
                        </h2>
                        <p class="mt-1 text-sm text-slate-600">
                            Un siège = un collaborateur actif ou une invitation en attente. Libérez un siège
                            (révoquez une invitation) ou ajoutez des sièges pour inviter davantage.
                        </p>
                        <div class="mt-4 flex flex-wrap gap-2">
                            <twig:Button as="a" href="{{ path('app_settings_subscription') }}" variant="dark" size="sm">Ajouter des sièges</twig:Button>
                            <twig:Button as="a" href="{{ path('app_employees_list') }}" variant="outline" size="sm">Voir les invitations en cours</twig:Button>
                        </div>
                    </div>
                </div>
            </div>

        {% else %}
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm">
                <span class="text-slate-600">
                    Sièges&nbsp;: <span class="font-semibold text-slate-900 tabular-nums">{{ seats_used }} / {{ seats_allowed }}</span> utilisés
                    <span class="text-slate-400">— membres actifs + invitations en attente</span>
                </span>
                <a href="{{ path('app_settings_subscription') }}" class="font-medium text-indigo-600 hover:underline">Gérer les sièges →</a>
            </div>

            <twig:CreateInvitationFormComponent />
        {% endif %}
    </div>
{% endblock %}
