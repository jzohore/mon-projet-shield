{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('app_employees_list') }}" class="text-xs">
            Équipe & Accès
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}
{% block content %}
    <div class="max-w-7xl mx-auto">

        <div class="mb-8">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title }}</h1>
            <p class="text-sm text-slate-500 mt-1">Gérez les accès de votre équipe à la plateforme {{ company_name }}.</p>
        </div>

        {% set seats = seatInfo() %}
        {% if seats.isFirm %}
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm">
                <span class="text-slate-600">
                    Sièges&nbsp;: <span class="font-semibold text-slate-900 tabular-nums">{{ seats.used }} / {{ seats.allowed }}</span> utilisés
                    <span class="text-slate-400">— membres actifs + invitations en attente</span>
                </span>
                {% if seats.remaining == 0 %}
                    <a href="{{ path('app_settings_subscription') }}" class="font-medium text-amber-600 hover:underline">Ajouter des sièges →</a>
                {% endif %}
            </div>
        {% endif %}

        <twig:CreateInvitationFormComponent />
    </div>
{% endblock %}
