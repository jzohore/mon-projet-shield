{% extends '@admin/base.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}


{% block content %}
    <div class="max-w-7xl mx-auto space-y-6">

        {# 1. HEADER : TITRE ET BOUTON D'ACTION #}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Équipe du cabinet</h1>
                <p class="text-sm text-slate-500 mt-1">Gérez les accès, les rôles et la sécurité de vos collaborateurs.</p>
            </div>

            <div>
                <twig:Button as="a" href="{{ path('app_employees_invitation') }}"
                             variant="primary" size="sm">
                    <twig:ux:icon name="tabler:user-plus" class="size-4" /> Inviter un membre
                </twig:Button>
            </div>
        </div>



        <twig:MembersListComponent workspaceId="{{ workspace_id }}"></twig:MembersListComponent>

    </div>
{% endblock %}
