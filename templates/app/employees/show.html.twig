{% extends '@app/base_app.html.twig' %}

{% block title %}{{ member.fullName }} | {{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('app_employees_list') }}" class="text-xs">
            Équipe & Accès
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}

{% block content %}
    <div class="max-w-4xl mx-auto"> {# max-w-4xl est idéal pour un profil, ça évite que le texte soit trop étiré #}

        {# 1. En-tête de la page avec bouton de retour #}
        <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title }}</h1>
                <p class="text-sm text-slate-500 mt-1">{{ sub_title }}</p>
            </div>

            <a href="{{ path('app_employees_list') }}" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors shadow-sm focus:ring-2 focus:ring-slate-200">
                <twig:ux:icon name="lucide:arrow-left" class="w-4 h-4 mr-2" />
                Retour à la liste
            </a>
        </div>

        {# 2. La carte principale du profil #}
        <twig:RevokeWorkspaceMemberAccessComponent targetUserSlugId="{{ member.userSlugId }}"></twig:RevokeWorkspaceMemberAccessComponent>
    </div>
{% endblock %}
