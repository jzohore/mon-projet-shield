{% extends '@website/base.html.twig' %}

{% block title %}Connexion support{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
    <main class="flex min-h-screen w-full items-center justify-center bg-slate-50 p-6">
        <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <h1 class="text-lg font-bold text-slate-900">Connexion support</h1>
            <p class="mt-1 text-sm text-slate-500">
                Vous allez vous connecter en tant que collaborateur d'un cabinet. Cette action
                est <strong>tracée dans le journal d'audit du cabinet</strong>, avec votre identité
                et le motif ci-dessous.
            </p>

            <form method="POST" action="{{ path('app_support_impersonate') }}" class="mt-6 space-y-4">
                <input type="hidden" name="_token" value="{{ csrf_token('support-impersonate') }}">

                <div>
                    <label for="target_email" class="mb-1 block text-sm font-medium text-slate-700">E-mail du collaborateur</label>
                    <input type="email" id="target_email" name="target_email" required value="{{ target_email }}"
                           placeholder="jean.dupont@cabinet.fr"
                           class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2">
                </div>

                <div>
                    <label for="reason" class="mb-1 block text-sm font-medium text-slate-700">Motif d'accès <span class="font-normal text-slate-400">— 10 caractères minimum</span></label>
                    <textarea id="reason" name="reason" rows="3" required minlength="10"
                              placeholder="Ex : ticket #1287 — investigation d'un blocage à la validation d'un dossier."
                              class="flex w-full min-h-[76px] rounded-md border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"></textarea>
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <twig:Button as="a" href="{{ path('app_dashboard') }}" variant="outline" size="sm">Annuler</twig:Button>
                    <twig:Button type="submit" variant="dark" size="sm">Se connecter en tant que ce collaborateur</twig:Button>
                </div>
            </form>
        </div>
    </main>
{% endblock %}
