<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# SEO : Portail privé, on bloque les moteurs de recherche #}
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="Transmission sécurisée de votre dossier de conformité pour {{ folder.workspaceName|default('votre conseiller') }}.">

    <title>{% block title %}Dossier de conformité | {{ folder.workspaceName|default('Shield') }}{% endblock %}</title>

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    {% block stylesheets %}{% endblock %}
</head>
<body class="h-full font-sans text-slate-900 bg-slate-50 selection:bg-indigo-100 selection:text-indigo-900">

{# ACCESSIBILITÉ #}
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-slate-900 focus:text-white focus:rounded-md">
    Aller au contenu principal
</a>

{# Variables globales du tunnel #}
{% set step = step|default(1) %}
{% set workspace_name = folder.workspaceName|default('Votre Cabinet') %}

<div class="flex min-h-screen flex-col md:flex-row">

    {# ========================================== #}
    {# HEADER MOBILE (Caché sur desktop)          #}
    {# ========================================== #}
    <header class="md:hidden py-4 px-6 bg-white border-b border-slate-200 flex items-center justify-between shrink-0 shadow-sm relative z-20">
        <span class="text-lg font-black tracking-widest uppercase text-slate-900 truncate pr-4">
            {{ workspace_name }}
        </span>
        <span class="text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-md whitespace-nowrap">
            Étape {{ step }}/3
        </span>
    </header>

    {# ========================================== #}
    {# LA SIDEBAR GAUCHE (Desktop)                #}
    {# ========================================== #}
    <aside class="hidden md:flex flex-col w-80 shrink-0 bg-white border-r border-slate-200 px-10 py-12 relative z-20 shadow-[4px_0_24px_rgba(0,0,0,0.02)]" aria-label="Progression du dossier">

        <div class="mb-12">
            <span class="text-xl font-black tracking-widest uppercase text-slate-900 block truncate" title="{{ workspace_name }}">{{ workspace_name }}</span>
            <span class="block text-[10px] text-indigo-600 font-bold uppercase tracking-[0.2em] mt-1.5">Dossier LCB-FT</span>
        </div>

        <h2 id="timeline-title" class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-8">
            Progression
        </h2>

        <nav aria-labelledby="timeline-title" class="flex-1">
            <ol class="relative border-l border-slate-200 ml-4">

                {# Étape 1 : Entreprise #}
                <li class="mb-10 ml-8" {% if step == 1 %}aria-current="step"{% endif %}>
                    <span class="absolute -left-4 flex h-8 w-8 items-center justify-center rounded-full ring-4 ring-white {{ step >= 1 ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-50 border border-slate-200 text-slate-400' }}" aria-hidden="true">
                        <twig:ux:icon name="tabler:building-bank" class="size-4" />
                    </span>
                    <h3 class="{{ step >= 1 ? 'font-bold text-slate-900' : 'font-medium text-slate-500' }}">
                        <span class="sr-only">{% if step > 1 %}Terminé : {% elseif step == 1 %}Étape actuelle : {% endif %}</span>
                        1. Entreprise
                    </h3>
                    <p class="text-sm {{ step >= 1 ? 'text-slate-500' : 'text-slate-400' }} mt-1">Identification légale</p>
                </li>

                {# Étape 2 : Intervenants #}
                <li class="mb-10 ml-8" {% if step == 2 %}aria-current="step"{% endif %}>
                    <span class="absolute -left-4 flex h-8 w-8 items-center justify-center rounded-full ring-4 ring-white {{ step >= 2 ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-50 border border-slate-200 text-slate-400' }}" aria-hidden="true">
                        <twig:ux:icon name="tabler:users" class="size-4" />
                    </span>
                    <h3 class="{{ step >= 2 ? 'font-bold text-slate-900' : 'font-medium text-slate-500' }}">
                        <span class="sr-only">{% if step > 2 %}Terminé : {% elseif step == 2 %}Étape actuelle : {% endif %}</span>
                        2. Intervenants
                    </h3>
                    <p class="text-sm {{ step >= 2 ? 'text-slate-500' : 'text-slate-400' }} mt-1">Dirigeants & UBOs</p>
                </li>

                {# Étape 3 : Documents #}
                <li class="ml-8" {% if step == 3 %}aria-current="step"{% endif %}>
                    <span class="absolute -left-4 flex h-8 w-8 items-center justify-center rounded-full ring-4 ring-white {{ step >= 3 ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-50 border border-slate-200 text-slate-400' }}" aria-hidden="true">
                        <twig:ux:icon name="tabler:file-description" class="size-4" />
                    </span>
                    <h3 class="{{ step >= 3 ? 'font-bold text-slate-900' : 'font-medium text-slate-500' }}">
                        <span class="sr-only">{% if step == 3 %}Étape actuelle : {% endif %}</span>
                        3. Documents
                    </h3>
                    <p class="text-sm {{ step >= 3 ? 'text-slate-500' : 'text-slate-400' }} mt-1">Pièces justificatives</p>
                </li>
            </ol>
        </nav>

        <div class="mt-auto flex items-center gap-2 text-xs text-slate-400 font-medium">
            <twig:ux:icon name="tabler:lock" class="size-3.5" /> Espace chiffré et sécurisé
        </div>
    </aside>

    {# ========================================== #}
    {# LA ZONE DROITE CENTRALE (Contenu)          #}
    {# ========================================== #}
    <div class="flex-1 flex flex-col relative overflow-hidden bg-slate-50/50">

        {# La fameuse grille de fond "Tech" #}
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>

        {# Le MAIN qui va accueillir tes cartes blanches dynamiquement #}
        <main id="main-content" class="flex-1 flex flex-col items-center justify-center p-6 lg:p-12 relative z-10">
            <div class="w-full max-w-xl animate-in fade-in slide-in-from-bottom-4 duration-700">

                {# La carte blanche universelle pour le contenu du formulaire #}
                <div class="bg-white py-8 px-6 shadow-sm ring-1 ring-slate-900/5 sm:rounded-2xl sm:px-10">
                    {% block portal_content %}{% endblock %}
                </div>

            </div>
        </main>

        {# FOOTER (Assistance) #}
        <footer class="p-6 text-center text-sm text-slate-500 relative z-10 shrink-0 flex items-center justify-center gap-2">
            Un problème technique ?
            <twig:Button as="a" href="mailto:contact@cabinet.com?subject=Aide Dossier KYC" variant="link" class="!text-indigo-600 hover:underline !px-1">
                Contacter le cabinet
            </twig:Button>
        </footer>

    </div>
</div>
</body>
</html>
