{% extends '@admin/base.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}


{% block content %}
    <div class="max-w-7xl mx-auto space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title }}</h1>
                <p class="text-sm text-slate-500 mt-1">Gérez les obligations de conformité de vos clients en un coup d'œil.</p>
            </div>

            <div>
                <twig:Button as="a" href="{{ path('app_kyc_invitation') }}"
                             variant="primary" size="sm">
                    <twig:ux:icon name="ic:baseline-plus" class="size-4" /> Nouveau dossier
                </twig:Button>
            </div>
        </div>
        <twig:KycFolderListComponent userSlugId="{{ app.user.slugId }}"></twig:KycFolderListComponent>
    </div>

    <div class="min-h-screen bg-slate-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">

        {# Header du tunnel #}
        <div class="sm:mx-auto sm:w-full sm:max-w-xl text-center mb-8">
            <div class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 mb-4">
                <span class="text-xl">🛡️</span>
            </div>
            <h2 class="text-2xl font-bold text-slate-900">Vérification d'identité légale</h2>
            <p class="mt-2 text-sm text-slate-600">Le <span class="font-semibold text-slate-900">Cabinet Dupont & Associés</span> vous demande de compléter votre dossier LCB-FT de manière sécurisée.</p>
        </div>

        <div class="sm:mx-auto sm:w-full sm:max-w-xl">
            <div class="bg-white py-8 px-4 shadow-sm ring-1 ring-slate-200 sm:rounded-xl sm:px-10">

                {# Barre de progression #}
                <div class="mb-8">
                    <div class="flex justify-between text-xs font-medium text-slate-400 mb-2">
                        <span class="text-blue-600 font-bold">1. Entreprise</span>
                        <span>2. Intervenants</span>
                        <span>3. Documents</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-1.5">
                        <div class="bg-blue-600 h-1.5 rounded-full" style="width: 33%"></div>
                    </div>
                </div>

                {# Contenu de l'étape 1 #}
                <h3 class="text-lg font-bold text-slate-900 mb-4">Recherchez votre société</h3>
                <p class="text-sm text-slate-500 mb-6">Saisissez le nom ou le SIREN de l'entreprise concernée par ce dossier.</p>

                {# Ici viendra ton vrai composant LiveComponent Sirene #}
                <div class="relative mb-6">
                    <input type="text" class="w-full border-slate-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 pl-10" placeholder="Ex: ENIGMA SOLUTIONS">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                </div>

                {# Simulation du résultat cliqué #}
                <div class="bg-blue-50/50 border border-blue-100 rounded-lg p-4 mb-8 flex items-start gap-3">
                    <div class="mt-0.5 text-blue-600">
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-slate-900">ENIGMA SOLUTIONS SAS</p>
                        <p class="text-xs text-slate-500 mt-0.5">SIRET: 987 654 321 00045 • 75008 Paris</p>
                    </div>
                </div>

                <button class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-slate-900 hover:bg-slate-800 transition-colors">
                    Confirmer et continuer
                </button>
                {# ... (Même layout global, progression à 66%) ... #}

                <h3 class="text-lg font-bold text-slate-900 mb-1">Dirigeants & Bénéficiaires</h3>
                <p class="text-sm text-slate-500 mb-6">Ajoutez les représentants légaux et les personnes détenant plus de 25% du capital.</p>

                {# Liste des personnes ajoutées #}
                <div class="space-y-3 mb-6">
                    {# Personne 1 (Auto-remplie avec le contact par défaut) #}
                    <div class="flex items-center justify-between p-3 border border-slate-200 rounded-lg bg-slate-50">
                        <div class="flex items-center gap-3">
                            <div class="h-8 w-8 rounded bg-white border border-slate-200 flex items-center justify-center text-xs font-bold text-slate-600">AT</div>
                            <div>
                                <p class="text-sm font-bold text-slate-900">Alan Turing (Vous)</p>
                                <p class="text-xs text-slate-500">Dirigeant</p>
                            </div>
                        </div>
                        <button class="text-slate-400 hover:text-red-500"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                    </div>
                </div>

                {# Bouton d'ajout dynamique #}
                <button class="w-full flex items-center justify-center gap-2 py-2 px-4 border border-dashed border-slate-300 rounded-lg text-sm font-medium text-blue-600 hover:bg-blue-50 transition-colors mb-8">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Ajouter une autre personne
                </button>

                <div class="flex gap-3">
                    <button class="w-1/3 flex justify-center py-2.5 px-4 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50">Retour</button>
                    <button class="w-2/3 flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-slate-900 hover:bg-slate-800">
                        Étape suivante
                    </button>
                </div>
                {# ... (Progression à 100%) ... #}

                <h3 class="text-lg font-bold text-slate-900 mb-1">Dépôt des pièces</h3>
                <p class="text-sm text-slate-500 mb-6">Veuillez fournir les documents requis. Formats acceptés : PDF, JPG, PNG.</p>

                <div class="space-y-6 mb-8">

                    {# Zone 1 : KBIS (Générée pour la société) #}
                    <div>
                        <label class="block text-sm font-bold text-slate-900 mb-2">Extrait Kbis (ENIGMA SOLUTIONS)</label>
                        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-300 border-dashed rounded-lg hover:bg-slate-50 transition-colors cursor-pointer group">
                            <div class="space-y-1 text-center">
                                <svg class="mx-auto h-8 w-8 text-slate-400 group-hover:text-blue-500 transition-colors" stroke="currentColor" fill="none" viewBox="0 0 48 48"><path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <div class="flex text-sm text-slate-600 justify-center">
                                <span class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500">
                                    <span>Parcourir</span>
                                    <input id="file-upload" name="file-upload" type="file" class="sr-only">
                                </span>
                                    <p class="pl-1">ou glisser-déposer</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Zone 2 : Carte d'identité (Générée pour Alan) #}
                    <div>
                        <label class="block text-sm font-bold text-slate-900 mb-2 flex items-center justify-between">
                            Pièce d'identité (Alan Turing)
                            <span class="text-xs font-normal text-amber-600 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">Requis</span>
                        </label>
                        {# Version "Fichier Uploadé avec succès" pour montrer l'état plein #}
                        <div class="flex items-center justify-between p-4 border border-emerald-200 bg-emerald-50 rounded-lg">
                            <div class="flex items-center gap-3">
                                <div class="text-emerald-500">
                                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-emerald-900">cni_alan_recto_verso.pdf</p>
                                    <p class="text-xs text-emerald-700">2.4 MB • Uploadé à l'instant</p>
                                </div>
                            </div>
                            <button class="text-sm font-medium text-emerald-700 hover:text-emerald-900">Remplacer</button>
                        </div>
                    </div>

                </div>

                <div class="bg-blue-50 p-4 rounded-lg mb-8">
                    <div class="flex items-start">
                        <div class="flex items-center h-5">
                            <input id="certify" name="certify" type="checkbox" class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-slate-300 rounded">
                        </div>
                        <div class="ml-3 text-sm">
                            <label for="certify" class="font-medium text-slate-700">Attestation sur l'honneur</label>
                            <p class="text-slate-500 text-xs mt-1">Je certifie l'exactitude des informations fournies et l'authenticité des documents téléchargés.</p>
                        </div>
                    </div>
                </div>

                <button class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 transition-colors">
                    Transmettre le dossier sécurisé
                </button>
                {# L'écran final, centré et apaisant #}
                <div class="text-center py-8">
                    <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-emerald-100 mb-6">
                        <svg class="h-10 w-10 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </div>

                    <h3 class="text-2xl font-extrabold text-slate-900 mb-2">Dossier transmis !</h3>
                    <p class="text-slate-500 mb-8 max-w-sm mx-auto">Vos informations ont été chiffrées et envoyées avec succès au Cabinet Dupont & Associés.</p>

                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 text-sm text-left mb-8">
                        <h4 class="font-bold text-slate-900 mb-2">Et maintenant ?</h4>
                        <ul class="text-slate-600 space-y-2 list-disc list-inside">
                            <li>Le cabinet va analyser vos pièces.</li>
                            <li>Vous serez notifié par email si un document est illisible.</li>
                            <li>Vous pouvez fermer cette page en toute sécurité.</li>
                        </ul>
                    </div>

                    <p class="text-xs text-slate-400">Propulsé par la technologie Shield 🛡️</p>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
