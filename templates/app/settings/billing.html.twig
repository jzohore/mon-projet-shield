{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}


{% block content %}
    <div class="max-w-7xl mx-auto space-y-6">
        {{ include('@app/settings/_header_settings.html.twig') }}
        <div class="bg-white rounded-xl border border-slate-200 p-8 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-1">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none mb-2">Solde de votre organisation</p>
                <div class="flex items-baseline gap-3">
                    <span class="text-5xl font-black text-slate-900 tracking-tighter">{{ workspaceInfo().balance }}</span>
                    <span class="text-sm font-bold text-violet-600 uppercase tracking-tight">Crédits disponibles</span>
                </div>
            </div>

            <div class="flex flex-col gap-3">
                <twig:Button variant="primary" size="lg" class="w-full md:w-auto" as="a" href="{{ path('app_billing_products') }}">
                    <twig:ux:icon name="material-symbols:add-circle-outline-rounded" class="w-5 h-5 group-hover:scale-110 transition-transform" />
                    Recharger mon compte
                </twig:Button>

                <p class="text-[10px] text-center text-slate-400">Paiement sécurisé par Stripe</p>
            </div>
        </div>
        <twig:WalletTransactionsListComponent></twig:WalletTransactionsListComponent>

    </div>
{% endblock %}
