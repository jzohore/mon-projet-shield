{% extends '@admin/base.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}


{% block content %}
    <div class="max-w-7xl mx-auto space-y-6">
        {{ include('@app/settings/_header_settings.html.twig') }}

        {# --- BARRE DE FILTRES SHADCN --- #}
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
            <div class="relative">
                <twig:ux:icon name="material-symbols:search-rounded" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
                <input type="text" placeholder="Rechercher une action..." class="w-full pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-violet-600 outline-none transition-all">
            </div>
            <select class="bg-white border border-slate-200 text-xs rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-violet-600">
                <option>Tous les utilisateurs</option>
                <option>John Doe</option>
                <option>Service OCR (Système)</option>
            </select>
            <select class="bg-white border border-slate-200 text-xs rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-violet-600">
                <option>Gravité : Toutes</option>
                <option>Succès</option>
                <option>Avertissements</option>
                <option>Alertes critiques</option>
            </select>
            <div class="flex items-center gap-2">
                <input type="date" class="flex-1 bg-white border border-slate-200 text-xs rounded-lg px-3 py-2 outline-none">
            </div>
        </div>

        {# --- TABLEAU DES LOGS --- #}
        <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-tighter">
                <tr>
                    <th class="px-6 py-4">Horodatage</th>
                    <th class="px-6 py-4">Utilisateur</th>
                    <th class="px-6 py-4">Action</th>
                    <th class="px-6 py-4">Cible</th>
                    <th class="px-6 py-4">Statut</th>
                    <th class="px-6 py-4 text-right">Détails</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                {# LIGNE 1 : ACTION SYSTÈME (OCR) #}
                <tr class="hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 font-mono text-[10px] text-slate-400">03 Avr. 2026 - 14:22:10</td>
                    <td class="px-6 py-4 flex items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-violet-100 flex items-center justify-center">
                            <twig:ux:icon name="material-symbols:smart-toy-outline-rounded" class="w-3.5 h-3.5 text-violet-600" />
                        </div>
                        <span class="font-semibold text-slate-700">Système (OCR)</span>
                    </td>
                    <td class="px-6 py-4 font-medium text-slate-900 underline decoration-dotted decoration-slate-300 underline-offset-4">Extraction de données</td>
                    <td class="px-6 py-4 text-slate-500 italic">Kbis_Acme_2026.pdf</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-black bg-green-50 text-green-700 border border-green-100 uppercase">Succès</span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button class="p-1.5 text-slate-400 hover:text-violet-600 hover:bg-violet-50 rounded-md transition-all">
                            <twig:ux:icon name="material-symbols:unfold-more-rounded" class="w-4 h-4" />
                        </button>
                    </td>
                </tr>

                {# LIGNE 2 : ACTION CRITIQUE (MODIFICATION KYC) #}
                <tr class="hover:bg-slate-50/50 transition-colors bg-amber-50/10">
                    <td class="px-6 py-4 font-mono text-[10px] text-slate-400">03 Avr. 2026 - 10:05:42</td>
                    <td class="px-6 py-4 flex items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-[8px] font-bold">JD</div>
                        <span class="font-semibold text-slate-700">John Doe</span>
                    </td>
                    <td class="px-6 py-4 font-medium text-slate-900">Modification SIRET</td>
                    <td class="px-6 py-4 text-slate-500">Organisation #12</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-black bg-amber-50 text-amber-700 border border-amber-100 uppercase">Attention</span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button class="p-1.5 text-slate-400 hover:text-violet-600 hover:bg-violet-50 rounded-md transition-all">
                            <twig:ux:icon name="material-symbols:unfold-more-rounded" class="w-4 h-4" />
                        </button>
                    </td>
                </tr>

                {# LIGNE 3 : ALERTE SÉCURITÉ #}
                <tr class="hover:bg-slate-50/50 transition-colors bg-red-50/20">
                    <td class="px-6 py-4 font-mono text-[10px] text-red-400">02 Avr. 2026 - 23:58:01</td>
                    <td class="px-6 py-4 flex items-center gap-2 text-red-700">
                        <twig:ux:icon name="material-symbols:gavel-rounded" class="w-4 h-4 text-white" />
                        <span class="font-bold uppercase tracking-tighter">Inconnu (IP: 102.x.x.x)</span>
                    </td>
                    <td class="px-6 py-4 font-bold text-red-700">Tentative accès API</td>
                    <td class="px-6 py-4 text-red-600/70 italic">Endpoint: /v1/documents</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-black bg-red-100 text-red-700 border border-red-200 uppercase">Critique</span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button class="p-1.5 text-red-600 hover:bg-red-100 rounded-md transition-all font-black text-[10px]">BLOQUER</button>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>

        {# --- FOOTER INFO --- #}
        <div class="flex items-center gap-4 p-4 rounded-xl border border-violet-100 bg-violet-50/30">
            <div class="w-8 h-8 rounded-lg bg-violet-600 flex items-center justify-center shrink-0">
                <twig:ux:icon name="material-symbols:gavel-rounded" class="w-4 h-4 text-white" />
            </div>
            <p class="text-[10px] text-violet-700 leading-relaxed font-medium">
                <strong>Intégrité des données :</strong> Ce journal utilise un système de chaînage cryptographique. Chaque entrée est scellée temporellement. Toute tentative de modification manuelle des logs invaliderait le certificat de conformité de votre organisation.
            </p>
        </div>
    </div>
{% endblock %}
