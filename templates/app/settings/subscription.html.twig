            {#                    {% endif %}#}
            {#                </div>#}

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-200">
                    <h2 class="text-base font-semibold text-slate-900">Historique de facturation</h2>
                </div>
                {% if isTrial %}
                    <div class="p-8 text-center">
                        <div class="mx-auto h-12 w-12 text-slate-300 mb-3">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <p class="text-sm font-medium text-slate-900">Aucune facture pour le moment</p>
                        <p class="mt-1 text-sm text-slate-500">Votre première facture sera générée à la fin de la période d'essai.</p>
                    </div>
                {% else %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-slate-200">
                            <thead class="bg-slate-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Montant</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Statut</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase">Facture</th>
                            </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-slate-200">
                            {% for invoice in subInfo.invoices %}
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900">{{ invoice.date|format_date('medium', '', 'Europe/Paris') }}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">{{ invoice.amount| format_currency('EUR', [], 'fr') }}</td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">Payée</span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <a href="{{ invoice.pdf_url }}" class="text-indigo-600 hover:text-indigo-900" target="_blank">Télécharger PDF</a>
                                    </td>
                                </tr>
                            {% endfor %}

                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

        </div>
    </div>

{% endblock %}
