            {#                                    </svg>#}
            {#                                </div>#}
            {#                                <div>#}
            {#                                    <p class="text-sm font-medium text-slate-900">Aucune carte enregistrée</p>#}
            {#                                    <p class="text-sm text-slate-500">Ajoutez une carte pour éviter l'interruption du service.</p>#}
            {#                                </div>#}
            {#                            </div>#}
            {#                            <button class="text-sm font-medium text-indigo-600 hover:text-indigo-700">#}
            {#                                Ajouter une méthode#}
            {#                            </button>#}
            {#                        </div>#}
            {#                    {% else %}#}
            {#                        <div class="p-6 flex items-center gap-4">#}
            {#                            <div class="h-10 w-14 bg-slate-800 rounded flex items-center justify-center text-white font-bold text-xs">#}
            {#                                VISA#}
            {#                            </div>#}
            {#                            <div>#}
            {#                                <p class="text-sm font-medium text-slate-900">Visa se terminant par 4242</p>#}
            {#                                <p class="text-sm text-slate-500">Expire en 12/2028</p>#}
