{# Conteneur fixe en haut à droite (z-50 pour passer au-dessus de tout) #}
<div class="fixed top-6 right-6 z-50 flex flex-col gap-4 w-full max-w-sm pointer-events-none" role="status" aria-live="polite">

    {% for label, messages in app.flashes %}

        {# Mapping des icônes et des titres selon le type de flash (DDD UI approach) #}
        {% set icon = 'lucide:info' %}
        {% set title = 'Information' %}
        {% set alert_class = 'bg-white text-slate-900 border-slate-200' %}

        {% if label == 'success' %}
            {% set icon = 'lucide:circle-check' %}
            {% set title = 'Succès' %}
            {% set alert_class = 'bg-green-50 text-green-900 border-green-200' %}
        {% elseif label == 'error' %}
            {% set icon = 'lucide:circle-alert' %}
            {% set title = 'Erreur' %}
            {% set alert_class = 'bg-red-50 text-red-900 border-red-200' %}
        {% elseif label == 'warning' %}
            {% set icon = 'lucide:triangle-alert' %}
            {% set title = 'Attention' %}
            {% set alert_class = 'bg-orange-50 text-orange-900 border-orange-200' %}
        {% endif %}

        {% for message in messages %}
            {# Le div contrôlé par Stimulus. Il réactive les pointer-events pour permettre le clic #}
            <div data-controller="notification"
                 data-notification-timeout-value="3000"
                 class="pointer-events-auto transform transition-all duration-300 ease-in-out translate-x-0 opacity-100 shadow-lg rounded-lg">

                {# Ton composant générique adapté #}
                <twig:Alert class="{{ alert_class }}">
                    <twig:Alert:Description>
                        {{ message }}
                    </twig:Alert:Description>
                </twig:Alert>

            </div>
        {% endfor %}
    {% endfor %}
</div>
