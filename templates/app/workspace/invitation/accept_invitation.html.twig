{% extends '@website/base.html.twig' %}

{% block title %}Rejoindre {{ invitation.workspaceName }}{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
    <main class="flex min-h-screen w-full items-center justify-center bg-slate-50 p-6">
        <div class="w-full max-w-md">

            <div class="mb-6 flex items-center gap-2 text-[15px] font-bold tracking-tight text-slate-900">
                <span class="flex size-7 items-center justify-center rounded bg-slate-900 text-sm font-bold text-white" aria-hidden="true">K</span>
                {{ company_name }}
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
                <h1 class="text-xl font-bold tracking-tight text-slate-900">
                    Rejoindre {{ invitation.workspaceName }}
                </h1>
                <p class="mt-1 text-sm text-slate-500">
                    <span class="font-medium text-slate-700">{{ invitation.ownerFullName }}</span>
                    vous invite à collaborer sur {{ company_name }}.
                </p>

                <dl class="mt-6 space-y-3 border-t border-slate-100 pt-6 text-sm">
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-slate-500">Adresse invitée</dt>
                        <dd class="text-right font-medium text-slate-900">{{ invitation.email }}</dd>
                    </div>
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-slate-500">Rôle</dt>
                        <dd class="text-right font-medium text-slate-900">{{ invitation.role }}</dd>
                    </div>
                    {% if invitation.tokenExpiresAt %}
                        <div class="flex items-start justify-between gap-4">
                            <dt class="text-slate-500">Lien valable jusqu'au</dt>
                            <dd class="text-right font-medium text-slate-900">{{ invitation.tokenExpiresAt|date('d/m/Y à H:i') }}</dd>
                        </div>
                    {% endif %}
                </dl>

                <ul class="mt-6 space-y-2 text-xs text-slate-600">
                    <li class="flex items-start gap-2">
                        {{ ux_icon('lucide:check', { class: 'mt-0.5 size-4 shrink-0 text-emerald-500' }) }}
                        Accès aux dossiers de conformité du cabinet.
                    </li>
                    {% if invitation.isAdmin %}
                        <li class="flex items-start gap-2">
                            {{ ux_icon('lucide:check', { class: 'mt-0.5 size-4 shrink-0 text-emerald-500' }) }}
                            Contrôle total : gestion des membres, des réglages et de la facturation.
                        </li>
                    {% endif %}
                </ul>

                <form action="{{ path('portal_user_invitation_accept') }}" method="POST" class="mt-8">
                    <input type="hidden" name="_token" value="{{ csrf_token('accept-invitation') }}">
                    <twig:Button type="submit" variant="dark" class="w-full">
                        Accepter l'invitation
                        {{ ux_icon('lucide:arrow-right', { class: 'ml-2 size-4' }) }}
                    </twig:Button>
                </form>
            </div>

            <p class="mt-4 text-center text-xs text-slate-400">
                Ce n'est pas vous ? Ignorez cet e-mail, l'invitation expirera d'elle-même.
            </p>
        </div>
    </main>
{% endblock %}
