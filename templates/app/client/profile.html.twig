{% extends '@app/client/layout_client.html.twig' %}

{% block title %}Mon profil | {{ company_name|default('KYSURE') }}{% endblock %}

{% block client_main %}
    <div class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Mon profil</h1>
        <p class="text-sm text-slate-600 mt-1">Vos informations personnelles, telles que votre conseiller les voit.</p>
    </div>

    <div class="space-y-8 max-w-2xl">
        {# Informations modifiables #}
        <section>
            <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Informations</h2>
            <twig:ClientProfileFormComponent />
        </section>

        {# Compte — lecture seule #}
        <section>
            <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Compte</h2>
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm divide-y divide-slate-100">
                <div class="flex items-center justify-between gap-4 p-5">
                    <div class="min-w-0">
                        <p class="text-sm font-medium text-slate-900">Adresse e-mail</p>
                        <p class="text-sm text-slate-500 truncate">{{ client.email }}</p>
                    </div>
                    <span class="shrink-0 inline-flex items-center gap-1.5 text-xs text-slate-400">
                        <twig:ux:icon name="tabler:lock" class="size-3.5" aria-hidden="true" />
                        Non modifiable
                    </span>
                </div>
                <div class="flex items-center justify-between gap-4 p-5">
                    <p class="text-sm font-medium text-slate-900">Compte créé le</p>
                    <p class="text-sm text-slate-500">{{ client.createdAt|date('d/m/Y') }}</p>
                </div>
            </div>
            <p class="text-xs text-slate-400 mt-2">
                Cette adresse vous sert d'identifiant de connexion. Pour en changer, contactez votre conseiller.
            </p>
        </section>
    </div>
{% endblock %}
