{# 🚨 CORRECTIF N°1 : On utilise le layout global, et SURTOUT PAS le layout billing #}
{% extends '@app/client/layout_client.html.twig' %}

{% block title %}Mon Espace Sécurisé | {{ company_name }}{% endblock %}


{% block client_main %}
    {# 1. HEADER PAGE #}
    <div class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            Bonjour {{ dashboard.clientFirstName }},
        </h1>
        <p class="text-sm sm:text-base text-slate-600 mt-1">
            Voici un résumé de votre situation réglementaire.
        </p>
    </div>

    {# 2. LA PRIORITÉ : LE DOSSIER ACTIF (Pleine largeur) #}
    {% set themeColor = dashboard.activeFolder ? dashboard.portalStatus.colorTheme : 'slate' %}

    {% if dashboard.activeFolder %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden mb-8">
            <div class="border-l-4 border-l-{{ themeColor }}-500 p-6 sm:p-8">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6">
                    <div class="flex items-start gap-4">
                        <div class="p-2.5 bg-{{ themeColor }}-50 rounded-lg ring-1 ring-inset ring-{{ themeColor }}-500/20 shrink-0">
                            {# 🚨 L'icône a été remplacée ici par une icône standard garantie #}
                            <twig:ux:icon name="tabler:shield-lock" class="size-6 text-{{ themeColor }}-600" aria-hidden="true" />
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-slate-900 tracking-tight">
                                {{ dashboard.activeFolder.title }}
                            </h2>
                            <p class="text-sm text-slate-600 mt-1.5 leading-relaxed max-w-xl">
                                {% if dashboard.pendingDocumentsCount > 0 %}
                                    Votre cabinet requiert <strong>{{ dashboard.pendingDocumentsCount }} pièce(s) justificative(s)</strong> pour finaliser la mise en conformité de votre dossier.
                                {% else %}
                                    L'ensemble de vos documents réglementaires a été vérifié et validé.
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <div class="shrink-0">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-{{ themeColor }}-50 px-3 py-1 text-xs font-semibold text-{{ themeColor }}-700 ring-1 ring-inset ring-{{ themeColor }}-600/20">
                            {{ dashboard.portalStatus.label }}
                        </span>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                    {% if dashboard.pendingDocumentsCount > 0 %}
                        <a href="{{ path('app_portal_folder_detail', {id: dashboard.activeFolder.id}) }}"
                           class="inline-flex items-center justify-center gap-2 bg-[#0B261C] text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#0B261C] focus:ring-offset-2 transition-all shadow-sm">
                            Traiter mon dossier
                            <twig:ux:icon name="tabler:arrow-right" class="size-4 opacity-70" aria-hidden="true" />
                        </a>
                    {% else %}
                        <a href="{{ path('app_portal_folder_detail', {id: dashboard.activeFolder.id}) }}"
                           class="inline-flex items-center justify-center gap-2 bg-white text-slate-700 border border-slate-300 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-200 focus:ring-offset-2 transition-all shadow-sm">
                            Consulter
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    {# 3. GRILLE DE RÉASSURANCE (Widgets Secondaires) #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        {# WIDGET A : Synthèse Profil #}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2">
                <twig:ux:icon name="tabler:user-check" class="size-4 text-slate-400" />
                Validité du profil
            </h3>
            <ul class="space-y-4">
                <li class="flex items-center justify-between">
                    <span class="text-sm text-slate-600">Identité (KYC)</span>
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-600">
                        <twig:ux:icon name="tabler:check" class="size-4" /> À jour
                    </span>
                </li>
                <li class="flex items-center justify-between">
                    <span class="text-sm text-slate-600">Profil de Risque</span>
                    {# Exemple d'une donnée qui expire bientôt #}
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-amber-600">
                        <twig:ux:icon name="tabler:clock" class="size-4" /> Expire dans 3 mois
                    </span>
                </li>
                <li class="flex items-center justify-between pt-2 border-t border-slate-100">
                    <span class="text-xs text-slate-500">Dernière révision</span>
                    <span class="text-xs font-medium text-slate-700">12 Janvier 2026</span>
                </li>
            </ul>
        </div>

        {# WIDGET B : Mon Conseiller #}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2">
                <twig:ux:icon name="tabler:building-bank" class="size-4 text-slate-400" />
                Votre Cabinet
            </h3>
            <div class="flex items-start gap-4">
                <div class="size-12 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center shrink-0">
                    <span class="text-lg font-bold text-slate-400">{{ dashboard.cabinetName|first }}</span>
                </div>
                <div>
                    <h4 class="font-medium text-slate-900">{{ dashboard.cabinetName }}</h4>
                    <p class="text-sm text-slate-500 mt-0.5">Conseil en Gestion de Patrimoine</p>

                    <div class="mt-3 space-y-2">
                        <a href="mailto:contact@cabinet.com" class="flex items-center gap-2 text-sm text-slate-600 hover:text-slate-900 transition-colors group">
                            <twig:ux:icon name="tabler:mail" class="size-4 text-slate-400 group-hover:text-[#0B261C]" />
                            contact@cabinet.com
                        </a>
                        <a href="tel:+33100000000" class="flex items-center gap-2 text-sm text-slate-600 hover:text-slate-900 transition-colors group">
                            <twig:ux:icon name="tabler:phone" class="size-4 text-slate-400 group-hover:text-[#0B261C]" />
                            01 00 00 00 00
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
