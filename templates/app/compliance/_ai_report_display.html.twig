{# templates/compliance/_ai_report_display.html.twig #}

<div class="px-6 py-6 sm:px-6 sm:py-6 bg-white">



    <div class="flex flex-wrap items-center gap-y-2  border-b border-slate-100 text-xs">

        <div>
            <div class="flex items-center gap-2.5">
                <h3 class="text-base font-semibold tracking-tight text-slate-900">Compte-rendu d'adéquation</h3>
            </div>
            <p class="text-xs text-slate-500 mt-1 flex items-center gap-1.5">
                Profil de risque : <span class="font-semibold text-indigo-600 flex items-center gap-1">
                    {{ risk_override|default(dto.riskProfileDetected|default('Non déterminé')) }}
            </span>
            </p>
        </div>


    </div>
    {# 3. CONTENU RÉDACTIONNEL (SYNTHÈSE & PLAN D'ACTION) #}
    <div class="space-y-6 mt-8">

        <div class="space-y-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Synthèse de l'échange</h4>
            <div class="text-sm text-slate-700 leading-relaxed bg-white p-4 rounded-lg border border-slate-100 shadow-2xs">
                {{ (summary_override|default(dto.executiveSummary))|nl2br }}
            </div>
        </div>

        {% if dto.kycUpdates is not empty %}
            <div class="space-y-3">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Mises à jour KYC requises</h4>

                <div class="bg-white p-4 rounded-lg border border-slate-100 shadow-2xs space-y-4">
                    {# 🚀 Première boucle : On itère sur les sessions #}
                    {% for sessionGroup in dto.kycUpdates %}
                        <div class="space-y-2">
                            {# Affichage de la date comme un en-tête de sous-section élégant #}
                            <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide border-b border-slate-50 pb-1">
                                Session du {{ sessionGroup.date }}
                            </div>

                            {# 🚀 Seconde boucle : On liste les éléments avec la puce bleue #}
                            <ul class="space-y-1.5 pl-1">
                                {% for item in sessionGroup.items %}
                                    <li class="flex items-start gap-2 text-xs text-slate-700">
                                        {{ ux_icon('lucide:dot', { class: 'size-4 text-indigo-600 shrink-0 mt-0.5' }) }}
                                        <span>{{ item }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if dto.actionPlan is not empty %}
            <div class="space-y-3">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Mises à jour KYC requises</h4>

                <div class="bg-white p-4 rounded-lg border border-slate-100 shadow-2xs space-y-4">
                    {# 🚀 Première boucle : On itère sur les sessions #}
                    {% for sessionGroup in dto.actionPlan %}
                        <div class="space-y-2">
                            {# Affichage de la date comme un en-tête de sous-section élégant #}
                            <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide border-b border-slate-50 pb-1">
                                Session du {{ sessionGroup.date }}
                            </div>

                            {# 🚀 Seconde boucle : On liste les éléments avec la puce bleue #}
                            <ul class="space-y-1.5 pl-1">
                                {% for item in sessionGroup.items %}
                                    <li class="flex items-start gap-2 text-xs text-slate-700">
                                        {{ ux_icon('lucide:dot', { class: 'size-4 text-indigo-600 shrink-0 mt-0.5' }) }}
                                        <span>{{ item }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </div>
</div>
