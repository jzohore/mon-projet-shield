{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block content %}
    <div class="max-w-xl mx-auto">
        <a href="{{ path('app_clients_list') }}" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 mb-4">
            <twig:ux:icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
            Mes clients
        </a>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100 flex items-start gap-3">
                <div class="size-10 shrink-0 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center" aria-hidden="true">
                    <twig:ux:icon name="tabler:user-plus" class="size-5 text-slate-600" />
                </div>
                <div>
                    <h1 class="text-lg font-bold text-slate-900">Nouveau client</h1>
                    <p class="text-sm text-slate-500 mt-0.5">
                        Ajoutez une personne à votre portefeuille. Vous pourrez ensuite lui créer un dossier de conformité.
                    </p>
                </div>
            </div>

            <div class="p-6">
                {{ form_start(create_form) }}
                <div class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {{ form_row(create_form.firstName) }}
                        {{ form_row(create_form.lastName) }}
                    </div>
                    {{ form_row(create_form.email) }}

                    <div class="flex items-center justify-end gap-3 pt-2">
                        <twig:Button as="a" href="{{ path('app_clients_list') }}" variant="ghost">Annuler</twig:Button>
                        <twig:Button type="submit" variant="dark">
                            <twig:ux:icon name="tabler:check" class="size-4" aria-hidden="true" />
                            Ajouter au portefeuille
                        </twig:Button>
                    </div>
                </div>
                {{ form_end(create_form) }}
            </div>
        </div>

        <p class="text-xs text-slate-400 mt-4 text-center">
            Si cette adresse e-mail correspond déjà à un client KYSURE, il sera simplement rattaché à votre cabinet.
        </p>
    </div>
{% endblock %}
