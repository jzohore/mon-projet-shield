{% extends '@app/base_app.html.twig' %}

{% block title %}{{ client.fullName }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ client.fullName }}{% endblock %}

{% block content %}
    <a href="{{ path('app_clients_list') }}" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 mb-4">
        <twig:ux:icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
        Mes clients
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# --- Colonne principale : dossiers --- #}
        <div class="lg:col-span-2 space-y-6">
            <div class="flex items-center justify-between">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ client.fullName }}</h1>
                <form method="post" action="{{ path('app_clients_create_folder', {slugId: client.slugId}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('client_new_folder_' ~ client.slugId) }}">
                    <input type="hidden" name="type" value="individual">
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-[#0A2540] text-white px-4 py-2 text-sm font-semibold hover:bg-slate-900">
                        <twig:ux:icon name="tabler:folder-plus" class="size-4" aria-hidden="true" />
                        Nouveau dossier
                    </button>
                </form>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100">
                {% for folder in client.folders %}
                    <div class="p-5">
                        <div class="flex items-start justify-between gap-4">
                            <div class="min-w-0">
                                <a href="{{ path('app_compliance_show', {slugId: folder.slugId}) }}" class="font-semibold text-slate-900 hover:text-indigo-700">
                                    {{ folder.reference }}
                                </a>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    {{ folder.type == 'business' ? 'Personne morale' : 'Personne physique' }} · ouvert le {{ folder.openedAtFormatted }}
                                </p>
                            </div>
                            <span class="shrink-0 inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700">{{ folder.statusLabel }}</span>
                        </div>

                        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
                            <span>DER : {{ folder.derAcknowledged ? 'accusé de réception' : (folder.hasDer ? 'émis' : 'non émis') }}</span>
                            <span>Pièces : {{ folder.validatedDocumentCount }} / {{ folder.documentCount }} validées</span>
                            {% if folder.relationshipEnded %}
                                <span class="text-amber-700 font-medium">Relation clôturée · conservation jusqu'au {{ folder.purgeDueAtFormatted }}</span>
                            {% endif %}
                            {% if folder.underLegalHold %}
                                <span class="text-red-700 font-medium">Verrou de litige</span>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <p class="p-6 text-sm text-slate-500 text-center">Aucun dossier pour ce client.</p>
                {% endfor %}
            </div>
        </div>

        {# --- Colonne latérale : coordonnées + actions --- #}
        <div class="space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-3 text-sm">
                <h2 class="text-xs font-bold text-slate-500 uppercase tracking-widest">Coordonnées</h2>
                <div class="flex justify-between"><span class="text-slate-500">E-mail</span><span class="font-medium text-slate-900 text-right break-all">{{ client.email }}</span></div>
                {% if client.phoneNumber %}
                    <div class="flex justify-between"><span class="text-slate-500">Téléphone</span><span class="font-medium text-slate-900">{{ client.phoneNumber }}</span></div>
                {% endif %}
                <div class="flex justify-between"><span class="text-slate-500">Compte créé</span><span class="font-medium text-slate-900">{{ client.createdAtFormatted }}</span></div>
                {% if client.clientSinceFormatted %}
                    <div class="flex justify-between"><span class="text-slate-500">Client depuis</span><span class="font-medium text-slate-900">{{ client.clientSinceFormatted }}</span></div>
                {% endif %}
            </div>

            {# Retrait du portefeuille #}
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                <h2 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Retrait</h2>
                {% if client.canBeRemoved %}
                    <p class="text-xs text-slate-500 mb-3">Ce client n'a aucun dossier engagé. Le retirer supprime ses brouillons et le détache de votre cabinet (son compte n'est pas supprimé).</p>
                    <form method="post" action="{{ path('app_clients_remove', {slugId: client.slugId}) }}" onsubmit="return confirm('Retirer {{ client.fullName|e('js') }} de votre portefeuille ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('client_remove_' ~ client.slugId) }}">
                        <button type="submit" class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                            Retirer du portefeuille
                        </button>
                    </form>
                {% else %}
                    <p class="text-xs text-slate-500 mb-2">{{ client.removalBlockedReason }}</p>
                    <button type="button" disabled class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-400 cursor-not-allowed">
                        Retirer du portefeuille
                    </button>
                {% endif %}
            </div>

            {# Clôture de la relation d'affaires (admin) #}
            {% if is_granted('ROLE_WORKSPACE_ADMIN') and client.canCloseRelationship %}
                <div class="bg-white rounded-2xl border border-red-200 shadow-sm p-5">
                    <h2 class="text-xs font-bold text-red-600 uppercase tracking-widest mb-2">Clôturer la relation d'affaires</h2>
                    <p class="text-xs text-slate-500 mb-3">
                        <strong>Irréversible.</strong> Chaque dossier engagé sera clôturé et conservé 5 ans (art. L.561-12 CMF).
                        Le client recevra un e-mail. La rupture pour soupçon LCB-FT n'exonère pas de l'obligation déclarative Tracfin.
                    </p>
                    <form method="post" action="{{ path('app_clients_end_relationship', {slugId: client.slugId}) }}"
                          onsubmit="return confirm('Clôturer définitivement la relation avec {{ client.fullName|e('js') }} ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('client_end_relationship_' ~ client.slugId) }}">
                        <label class="block text-xs font-medium text-slate-600 mb-1">Motif</label>
                        <select name="reason" required class="w-full mb-3 rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
                            {% for r in end_reasons %}
                                <option value="{{ r.value }}">{{ r.label }}</option>
                            {% endfor %}
                        </select>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Retapez le nom du client pour confirmer</label>
                        <input type="text" name="confirm_name" required autocomplete="off" placeholder="{{ client.fullName }}"
                               class="w-full mb-3 rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
                        <button type="submit" class="w-full rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                            Clôturer la relation
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
