{% extends '@app/billing/base_billing.html.twig' %}
{% block title %}{{ page_title }}{% endblock %}

{% set container_width = 'max-w-6xl' %}
{% set isResume = dto.postMeetingReport is not empty %}
{% set isQuotaExhausted = dto.workspaceRemainingMinutes <= 0 %}
{% block header %}
    <header class="bg-white/80 backdrop-blur-xl border-b border-slate-200 px-4 sm:px-6 py-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 sticky top-0 z-40 shadow-sm">
        <div class="flex items-center gap-4">
            <a href="javascript:history.back()" class="p-2 hover:bg-slate-100 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400" title="Retour à l'étape précédente">
                {{ ux_icon('lucide:arrow-left', { class: 'size-5 text-slate-600' }) }}
            </a>
            <div>
                <h1 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                    Dossier {{ dto.reference }}
                </h1>
                <p class="text-xs text-slate-500">
                    {{ type == 'individual' ? 'Personne physique' : 'Personne morale' }}
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
            {# ACTION DESTRUCTIVE #}
            <div class="flex items-center gap-2 pr-4"
                {{ stimulus_controller('meeting-recorder', {
                    chunkUrl: path('app_api_meeting_chunk', { slugId: dto.slugId }),
                    stopUrl: path('app_api_meeting_stop', { slugId: dto.slugId }),
                    maxMinutes: dto.workspaceRemainingMinutes
                }) }}>

                <div class="flex flex-col text-right">
    <span data-meeting-recorder-target="timer" class="text-xs font-mono font-bold text-slate-400">
        {{ isQuotaExhausted ? '00:00' : (dto.workspaceRemainingMinutes ~ ':00') }}
    </span>
                </div>
                {% if dto.isAcceptedRecording %}
                <div class="relative group">
                    {% if isQuotaExhausted %}
                        <button type="button" disabled class="p-2 text-slate-400 bg-slate-100 rounded-xl cursor-not-allowed">
                            {{ ux_icon('tabler:microphone-off', { class: 'size-5' }) }}
                        </button>
                    {% else %}
                        <div class="flex items-center gap-1">
                            <button type="button" data-action="click->meeting-recorder#start" data-meeting-recorder-target="startBtn"
                                    class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all" title="Enregistrer">
                                {{ ux_icon('tabler:microphone', { class: 'size-5' }) }}
                            </button>
                            <button type="button" data-action="click->meeting-recorder#pause" data-meeting-recorder-target="pauseBtn"
                                    class="hidden p-2 text-amber-600 bg-amber-50 rounded-xl transition-all">
                                {{ ux_icon('tabler:player-pause', { class: 'size-5' }) }}
                            </button>
                            <button type="button" data-action="click->meeting-recorder#resume" data-meeting-recorder-target="resumeBtn"
                                    class="hidden p-2 text-emerald-600 bg-emerald-50 rounded-xl transition-all">
                                {{ ux_icon('tabler:player-play', { class: 'size-5' }) }}
                            </button>
                            <button type="button" data-action="click->meeting-recorder#stop" data-meeting-recorder-target="stopBtn"
                                    class="hidden p-2 text-rose-600 bg-rose-50 rounded-xl transition-all animate-pulse">
                                {{ ux_icon('tabler:square-rounded', { class: 'size-5' }) }}
                            </button>
                        </div>
                    {% endif %}
                </div>
            </div>
                {% else %}
                    <button type="button" disabled class="p-2 text-slate-400 bg-slate-100 rounded-xl cursor-not-allowed">
                        {{ ux_icon('tabler:microphone-off', { class: 'size-5' }) }}
                    </button>
                {% endif %}

            {% if is_granted('DELETE', folder) %}
                <div class="relative group inline-block">
                    <button type="button"
                            aria-haspopup="menu"
                            class="flex items-center justify-center size-8 sm:size-7 rounded-md text-white shadow-sm hover:bg-violet-300 transition-all active:scale-95 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-1">
                        {{ ux_icon('lsicon:setting-outline', { class: 'size-4 text-indigo-600' }) }}
                    </button>

                    {# MENU DÉROULANT (+) : Architecture ultra-dense #}
                    <div role="menu"
                         class="absolute right-0 mt-1.5 w-56 bg-white rounded-lg shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-slate-200/80 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 focus-within:opacity-100 focus-within:visible focus-within:translate-y-0 transition-all duration-150 z-50">

                        <div class="p-1">

                            {# ACTION 1 : Le fameux "Zéro Friction" (Déclenche le Modal) #}
                            <button
                               type="submit"
                               role="menuitem"
                               form="confidential-form"
                               class="flex items-center gap-2.5 px-2 py-1.5 text-[13px] font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-md transition-colors text-left cursor-pointer outline-none focus:bg-slate-50 w-full">
                                {% if folder.isConfidential %}
                                    {{ ux_icon('iconamoon:lock-fill', { class: 'size-3.5 text-indigo-600' }) }}
                                    Dévérouiller
                                {% else %}
                                    {{ ux_icon('iconamoon:lock-off-fill', { class: 'size-3.5' }) }}
                                    Vérouiller le dossier
                                {% endif %}
                            </button>

                            <div class="h-px bg-slate-100 my-1 mx-2"></div>
                            <twig:Dialog id="archive_compliance_folder">
                                <twig:Dialog:Trigger>

                                    <twig:Button
                                        class="inline-flex items-start justify-start gap-2.5 px-2 py-1.5 text-[13px] font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-md transition-colors text-left cursor-pointer outline-none focus:bg-slate-50 w-full"

                                        {{ ...dialog_trigger_attrs }}>
                                        <span class="flex items-center gap-1.5">
                                           {{ ux_icon('lucide:trash-2', { class: 'size-3.5' }) }}
                                        Archiver
                                        </span>

                                    </twig:Button>

                                </twig:Dialog:Trigger>
                                <twig:Dialog:Content>
                                    <twig:Dialog:Header>
                                        <twig:Dialog:Title class="text-slate-900">Archiver le dossier client</twig:Dialog:Title>
                                        <twig:Dialog:Description class="text-slate-600 mt-5">
                                            Cette action va clôturer ce dossier de conformité. Il ne sera plus modifiable, mais restera accessible en lecture seule dans vos archives pour répondre aux obligations de l'AMF.
                                        </twig:Dialog:Description>
                                    </twig:Dialog:Header>

                                    {# Bloc d'avertissement B2B (Style Linear/Stripe) - Scannable et sans fioritures #}
                                    <div class="my-4 border-l-4 border-amber-500 bg-slate-50 p-4 rounded-r-md">
                                        <div class="flex gap-3">
                                            <div class="space-y-2">
                                                <p class="text-sm font-semibold text-slate-900">
                                                    Conséquences immédiates :
                                                </p>
                                                <ul class="text-sm text-slate-600 space-y-1 list-disc ml-4 marker:text-slate-400">
                                                    <li>L'espace de collecte du client sera définitivement désactivé.</li>
                                                    <li>La piste d'audit et les documents signés seront scellés.</li>
                                                    <li>Les relances automatiques par email seront interrompues.</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>

                                    <twig:Dialog:Footer>
                                        <twig:Dialog:Close>
                                            <twig:Button variant="outline" {{ ...dialog_close_attrs }} class="text-slate-700 border-slate-200 hover:bg-slate-100">
                                                Annuler
                                            </twig:Button>
                                        </twig:Dialog:Close>

                                        {# Formulaire d'action avec protection CSRF #}
                                        <form action="{{ path('app_compliance_archive_folder', {
                                            slugId: folder.slugId, type: type, method: method
                                        }) }}" method="post" class="inline-block">
                                            <input type="hidden" name="_token" value="{{ csrf_token('archive_folder_' ~ folder.slugId) }}">
                                            <twig:Button type="submit" variant="destructive">
                                                Archiver le dossier
                                            </twig:Button>
                                        </form>
                                    </twig:Dialog:Footer>
                                </twig:Dialog:Content>
                            </twig:Dialog>
                            <div class="h-px bg-slate-100 my-1 mx-2"></div>

                            <twig:Dialog id="delete_compliance_folder">
                                <twig:Dialog:Trigger>

                                    <twig:Button
                                        class="inline-flex items-start justify-start gap-2.5 px-2 py-1.5 text-[13px] font-medium text-red-600 hover:bg-slate-50 hover:text-red-900 rounded-md transition-colors text-left cursor-pointer outline-none focus:bg-slate-50 w-full"

                                        {{ ...dialog_trigger_attrs }}>
                                        <span class="flex items-center gap-1.5">
                                            {{ ux_icon('lucide:trash-2', { class: 'size-3.5' }) }}
                                        Supprimer
                                        </span>

                                    </twig:Button>

                                </twig:Dialog:Trigger>
                                <twig:Dialog:Content>
                                    <twig:Dialog:Header>
                                        <twig:Dialog:Title class="text-slate-900">Archiver le dossier client</twig:Dialog:Title>
                                        <twig:Dialog:Description class="text-red-800 mt-5 font-bold">
                                            Cette action va supprimer ce dossier de conformité.
                                        </twig:Dialog:Description>
                                    </twig:Dialog:Header>

                                    {# Bloc d'avertissement B2B (Style Linear/Stripe) - Scannable et sans fioritures #}
                                    <div class="my-4 border-l-4 border-red-500 bg-slate-50 p-4 rounded-r-md">
                                        <div class="flex gap-3">
                                            <div class="space-y-2">
                                                <p class="text-sm font-semibold text-slate-900">
                                                    Conséquences immédiates :
                                                </p>
                                                <ul class="text-sm text-slate-600 space-y-1 list-disc ml-4 marker:text-slate-400">
                                                    <li>L'espace de collecte du client sera définitivement désactivé.</li>
                                                    <li>La piste d'audit et les documents signés seront scellés.</li>
                                                    <li>Les relances automatiques par email seront interrompues.</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>

                                    <twig:Dialog:Footer>
                                        <twig:Dialog:Close>
                                            <twig:Button variant="outline" {{ ...dialog_close_attrs }} class="text-slate-700 border-slate-200 hover:bg-slate-100">
                                                Annuler
                                            </twig:Button>
                                        </twig:Dialog:Close>

                                        {# Formulaire d'action avec protection CSRF #}
                                        <form action="{{ path('app_compliance_delete_folder', {
                                            slugId: folder.slugId, type: type, method: method
                                        }) }}" method="post" class="inline-block">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_folder_' ~ folder.slugId) }}">
                                            <twig:Button type="submit" variant="destructive">
                                                Supprimer le dossier
                                            </twig:Button>
                                        </form>
                                    </twig:Dialog:Footer>
                                </twig:Dialog:Content>
                            </twig:Dialog>
                        </div>
                    </div>
                </div>
