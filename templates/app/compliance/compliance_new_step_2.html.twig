{% extends '@app/billing/base_billing.html.twig' %}
{% block title %}{{ page_title }}{% endblock %}

{% set container_width = 'max-w-6xl' %}
{% set isResume = dto.postMeetingReport is not empty %}
{% set isQuotaExhausted = dto.workspaceRemainingMinutes <= 0 %}
{% block header %}
    <header class="bg-white/80 backdrop-blur-xl border-b border-slate-200 px-4 sm:px-6 py-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 sticky top-0 z-40 shadow-sm">
        <div class="flex items-center gap-4">
            <a href="javascript:history.back()" class="p-2 hover:bg-slate-100 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400" title="Retour à l'étape précédente">
                {{ ux_icon('lucide:arrow-left', { class: 'size-5 text-slate-600' }) }}
            </a>
            <div>
                <h1 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                    Dossier {{ dto.reference }}
                </h1>
                <p class="text-xs text-slate-500">
                    {{ type == 'individual' ? 'Personne physique' : 'Personne morale' }}
                    • <span class="text-indigo-600 font-medium">Envoi par lien sécurisé</span>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
            {# ACTION DESTRUCTIVE #}
            <div class="flex items-center gap-2 pr-4"
                {{ stimulus_controller('meeting-recorder', {
                    chunkUrl: path('app_api_meeting_chunk', { slugId: dto.slugId }),
                    stopUrl: path('app_api_meeting_stop', { slugId: dto.slugId }),
                    maxMinutes: dto.workspaceRemainingMinutes
                }) }}>

                <div class="flex flex-col text-right">
    <span data-meeting-recorder-target="timer" class="text-xs font-mono font-bold text-slate-400">
        {{ isQuotaExhausted ? '00:00' : (dto.workspaceRemainingMinutes ~ ':00') }}
    </span>
                </div>

                <div class="relative group">
                    {% if isQuotaExhausted %}
                        <button type="button" disabled class="p-2 text-slate-400 bg-slate-100 rounded-xl cursor-not-allowed">
                            {{ ux_icon('tabler:microphone-off', { class: 'size-5' }) }}
                        </button>
                    {% else %}
                        <div class="flex items-center gap-1">
                            <button type="button" data-action="click->meeting-recorder#start" data-meeting-recorder-target="startBtn"
                                    class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all" title="Enregistrer">
                                {{ ux_icon('tabler:microphone', { class: 'size-5' }) }}
                            </button>
                            <button type="button" data-action="click->meeting-recorder#pause" data-meeting-recorder-target="pauseBtn"
                                    class="hidden p-2 text-amber-600 bg-amber-50 rounded-xl transition-all">
                                {{ ux_icon('tabler:player-pause', { class: 'size-5' }) }}
                            </button>
                            <button type="button" data-action="click->meeting-recorder#resume" data-meeting-recorder-target="resumeBtn"
                                    class="hidden p-2 text-emerald-600 bg-emerald-50 rounded-xl transition-all">
                                {{ ux_icon('tabler:player-play', { class: 'size-5' }) }}
                            </button>
                            <button type="button" data-action="click->meeting-recorder#stop" data-meeting-recorder-target="stopBtn"
                                    class="hidden p-2 text-rose-600 bg-rose-50 rounded-xl transition-all animate-pulse">
                                {{ ux_icon('tabler:square-rounded', { class: 'size-5' }) }}
                            </button>
                        </div>
                    {% endif %}
                </div>
            </div>
            {% if is_granted('DELETE', folder) %}
                <div data-controller="inline-confirm"
                     data-action="click@window->inline-confirm#clickOutside"
                     class="inline-block">
                    <twig:Button
                        class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all focus:outline-none focus:ring-2 focus:ring-red-500"
                        title="Supprimer le brouillon"
                        data-action="inline-confirm#toggle"
                        title="Révoquer"
                    >
                        {{ ux_icon('lucide:trash-2', { class: 'size-5' }) }}
                    </twig:Button>

                    <div data-inline-confirm-target="popover"
                         class="hidden z-[100] w-64 bg-white border border-slate-200 rounded-md shadow-xl p-3 animate-in fade-in zoom-in-95 duration-200">

                        <p class="text-sm text-slate-700 font-medium mb-3 text-center">
                            Êtes-vous sûr de vouloir supprimer ce dossier ?
                        </p>

                        <div class="flex gap-2">
                            <twig:Button variant="secondary"
                                         data-action="live#action inline-confirm#close"
                                         size="sm"
                            >
                                Annuler
                            </twig:Button>
                            <div>
                                <twig:Button
                                    type="submit"
                                    form="delete-form"
                                    variant="destructive"
                                >
                                    <twig:ux:icon name="lucide:user-x" class="w-4 h-4 mr-2" />
                                    Supprimer
                                </twig:Button>
                            </div>

                        </div>
                    </div>
                </div>
            {% endif %}

            {% if is_granted('MAKE_CONFIDENTIAL', folder) %}
                <div data-controller="inline-confirm"
                     data-action="click@window->inline-confirm#clickOutside"
                     class="inline-block">
                    <twig:Button
                        class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all focus:outline-none focus:ring-2 focus:ring-blue-500"
                        title="Rendre ce dossier confidentiel"
                        data-action="inline-confirm#toggle"
                        title="Confidentiel"
                    >
                        {% if folder.isConfidential %}
                            {{ ux_icon('iconamoon:lock-fill', { class: 'size-5 text-indigo-600' }) }}
                        {% else %}
                            {{ ux_icon('iconamoon:lock-off-fill', { class: 'size-5' }) }}
                        {% endif %}
                    </twig:Button>

                    <div data-inline-confirm-target="popover"
                         class="hidden z-[100] w-64 bg-white border border-slate-200 rounded-md shadow-xl p-3 animate-in fade-in zoom-in-95 duration-200">
                        {% if folder.isConfidential %}
                            <p class="text-sm text-slate-700 font-medium mb-3 text-center">
                                Voulez-vous rendre ce dossier accessible ?
                            </p>

                            <div class="flex flex-col gap-2">
                                <twig:Button variant="secondary"
                                             data-action="live#action inline-confirm#close"
                                             size="sm"
                                >
                                    Non
                                </twig:Button>
                                <twig:Button
                                    type="submit"
                                    form="make-accessible-form"
                                    variant="primary"
                                >
                                    Oui
                                </twig:Button>

                            </div>
                        {% else %}
                            <p class="text-sm text-slate-700 font-medium mb-3 text-center">
                                Voulez-vous rendre ce dossier confidentiel ?
                            </p>

                            <div class="flex flex-col gap-2">
                                <twig:Button variant="secondary"
                                             data-action="live#action inline-confirm#close"
                                             size="sm"
                                >
                                    Non
                                </twig:Button>
                                <twig:Button
                                    type="submit"
                                    form="confidential-form"
                                    variant="primary"
                                >
                                    Oui
                                </twig:Button>

                            </div>
                        {% endif %}

                    </div>
                </div>
            {% endif %}


{#            <button type="submit" form="setup-form" class="flex-1 sm:flex-none bg-green-700 text-white px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-slate-800 transition-all shadow-lg shadow-slate-900/10 active:scale-95 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">#}
{#                {{ method == 'request' ? 'Envoyer la demande' : 'Valider & Importer' }}#}
{#            </button>#}
        </div>
    </header>
{% endblock %}
{% block portal_content %}
    {# Formulaire caché pour la suppression du brouillon #}
    <form id="delete-form" method="POST" action="{{ path('app_compliance_delete_folder', {slugId: folder.slugId}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('remove-compliance') }}">
    </form>
    <form id="setup-form" method="POST" action="{{ path('app_compliance_submit_for_review', {slugId: folder.slugId}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('submit-for-review-compliance') }}">
    </form>
    <form id="confidential-form" method="POST" action="{{ path('app_compliance_make_confidential_folder', {
        slugId: folder.slugId, type: type, method: method
    }) }}">
        <input type="hidden" value="true" name="folder_confidential_value">
        <input type="hidden" name="_token" value="{{ csrf_token('make-confidential-compliance') }}">
    </form>
    <form id="make-accessible-form" method="POST" action="{{ path('app_compliance_make_confidential_folder', {
        slugId: folder.slugId, type: type, method: method
    }) }}">
        <input type="hidden" value="false" name="folder_confidential_value">
        <input type="hidden" name="_token" value="{{ csrf_token('make-confidential-compliance') }}">
    </form>

    <div class="py-6 sm:py-10">
        <div class="bg-slate-50/50 pb-24 rounded-3xl relative">
            <div class="mx-auto px-2 sm:px-6 max-w-3xl">

                <div class="space-y-8">

                    {# EN-TÊTE #}
                    <div class="flex items-center justify-between">
                        <h2 class="text-2xl font-bold text-slate-900">
                            {{ type == 'individual' ? 'Personne physique' : 'Personne morale' }}
                        </h2>
                    </div>

                    {# 🪄 LA BANNIÈRE DE CONFIDENTIALITÉ #}
                    {% if folder.isConfidential %}
                        <div class="bg-indigo-50/80 border border-indigo-200 rounded-xl p-5 flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between shadow-sm animate-fade-in">

                            {# Icone et texte explicatif #}
                            <div class="flex items-center gap-3">
                                <div class="p-2.5 bg-indigo-100 text-indigo-700 rounded-lg shadow-inner">
                                    <twig:ux:icon name="iconamoon:lock-fill" class="size-5" />
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-indigo-950">Dossier à accès restreint</h3>
                                    <p class="text-xs text-indigo-700 mt-0.5">Seules les personnes ci-contre peuvent consulter ce dossier.</p>
                                </div>
                            </div>

                            {# Liste des utilisateurs autorisés sous forme de "Pills" (Badges) #}
                            <div class="flex flex-wrap items-center gap-2">
                                {% for allowedUser in folder.restrictedUsers %}
                                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-indigo-100 text-xs font-medium text-slate-700 shadow-sm transition-transform hover:scale-105 cursor-default">

                                        {# Petit cercle avec les initiales #}
                                        <span class="size-5 rounded-full bg-indigo-600 flex items-center justify-center text-[9px] font-bold text-white tracking-wider">
                                        {{ allowedUser.firstName|first|upper }}{{ allowedUser.lastName|first|upper }}
                                    </span>

                                        {{ allowedUser.fullName }}
                                    </div>
                                {% endfor %}

                                {# 💡 Optionnel : Le fameux bouton pour modifier les accès qu'on a créé tout à l'heure ! #}

                            </div>

                        </div>
                    {% endif %}

                    <twig:AiReportDisplayComponent folder="{{ folder }}"></twig:AiReportDisplayComponent>
                    {# LES COMPOSANTS MÉTIER #}
                    <twig:ManualIndividualStepOneComponent complianceFolder="{{ folder }}" method="{{ method }}" type="{{ type }}"></twig:ManualIndividualStepOneComponent>

                    <twig:GenerateDERComponent complianceFolder="{{ folder }}"></twig:GenerateDERComponent>
{#                    <twig:ManualIndividualStepTwoComponent folder="{{ folder }}"></twig:ManualIndividualStepTwoComponent>#}
                </div>

            </div>
        </div>
    </div>
{% endblock %}
