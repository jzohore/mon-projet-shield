{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block content %}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title }}</h1>
            <p class="text-sm text-slate-500 mt-1">Votre portefeuille de clients et l'état de leurs dossiers.</p>
        </div>

        <details class="group">
            <summary class="list-none cursor-pointer inline-flex items-center gap-2 rounded-lg bg-[#0A2540] text-white px-4 py-2 text-sm font-semibold hover:bg-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-slate-900">
                <twig:ux:icon name="tabler:user-plus" class="size-4" aria-hidden="true" />
                Nouveau client
            </summary>
            <div class="mt-3 w-full sm:w-96 rounded-xl border border-slate-200 bg-white p-4 shadow-lg">
                {{ form_start(create_form) }}
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        {{ form_row(create_form.firstName) }}
                        {{ form_row(create_form.lastName) }}
                    </div>
                    {{ form_row(create_form.email) }}
                    <button type="submit" class="w-full rounded-md bg-[#0A2540] text-white px-4 py-2 text-sm font-semibold hover:bg-slate-900">
                        Ajouter au portefeuille
                    </button>
                </div>
                {{ form_end(create_form) }}
            </div>
        </details>
    </div>

    <twig:WorkspaceClientListComponent />
{% endblock %}
