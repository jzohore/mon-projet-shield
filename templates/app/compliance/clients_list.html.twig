{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block content %}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title }}</h1>
            <p class="text-sm text-slate-500 mt-1">Votre portefeuille de clients et l'état de leurs dossiers.</p>
        </div>

        {% if workspace_can('manage_portfolio') %}
            <twig:Button as="a" href="{{ path('app_clients_new') }}" variant="dark">
                <twig:ux:icon name="tabler:user-plus" class="size-4" aria-hidden="true" />
                Nouveau client
            </twig:Button>
        {% endif %}
    </div>

    <twig:WorkspaceClientListComponent />
{% endblock %}
