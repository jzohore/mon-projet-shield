{% extends 'app/der/_base.html.twig' %}

{% block title %}Accuser réception du DER{% endblock %}

{% block content %}
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-200 px-6 py-5">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-400 mb-2">
                <span class="text-indigo-600">1. Lire le document</span>
                <twig:ux:icon name="lucide:chevron-right" class="size-3.5" aria-hidden="true" />
                <span>2. Confirmer la réception</span>
            </div>
            <h1 class="text-lg font-semibold text-slate-900">Document d'Entrée en Relation</h1>
            <p class="mt-1 text-sm text-slate-600">
                Merci de prendre connaissance du document ci-dessous, puis de confirmer sa réception.
            </p>
        </div>

        <div class="px-6 py-5">
            {# Desktop : lecture inline dans une iframe, avec overlay de chargement
               (connexion lente : la page ne doit jamais sembler cassée). #}
            <div data-controller="pdf-loader" class="relative hidden sm:block">
                <div data-pdf-loader-target="overlay"
                     class="absolute inset-0 flex items-center justify-center rounded-lg border border-slate-200 bg-slate-100">
                    <span class="flex items-center gap-2 text-sm text-slate-500">
                        <twig:ux:icon name="lucide:loader" class="size-4 animate-spin" aria-hidden="true" />
                        Chargement du document…
                    </span>
                </div>
                <iframe
                    src="{{ pdf_url }}"
                    title="Document d'Entrée en Relation"
                    data-action="load->pdf-loader#hideOverlay"
                    class="w-full h-[70vh] min-h-[520px] rounded-lg border border-slate-200 bg-slate-100"
                ></iframe>
            </div>

            {# Mobile : le rendu PDF dans une iframe est peu fiable sur les navigateurs
               mobiles — on propose directement les actions de consultation. #}
            <div class="sm:hidden rounded-lg border border-slate-200 bg-slate-50 p-5 text-center">
                <twig:ux:icon name="lucide:file-text" class="mx-auto size-8 text-slate-400" aria-hidden="true" />
                <p class="mt-2 text-sm text-slate-600">Le document est prêt à être consulté.</p>
                <twig:Button as="a" href="{{ pdf_url }}" target="_blank" rel="noopener" variant="dark" class="w-full mt-3">
                    <twig:ux:icon name="lucide:eye" />
                    Consulter le document
                </twig:Button>
            </div>

            <p class="mt-2 hidden sm:flex items-center justify-between text-xs text-slate-500">
                <span>Le document ne s'affiche pas ?
                    <a href="{{ pdf_url }}" target="_blank" rel="noopener" class="font-medium text-indigo-600 underline focus-visible:ring-2 focus-visible:ring-indigo-500 rounded">
                        Ouvrir dans un nouvel onglet
                    </a>
                </span>
                <a href="{{ pdf_url }}" download target="_blank" rel="noopener"
                   class="inline-flex items-center gap-1.5 font-medium text-slate-600 hover:text-slate-900 focus-visible:ring-2 focus-visible:ring-indigo-500 rounded">
                    <twig:ux:icon name="lucide:download" class="size-3.5" aria-hidden="true" />
                    Télécharger une copie
                </a>
            </p>
        </div>

        <div class="border-t border-slate-200 bg-slate-50 px-6 py-5">
            {{ form_start(form) }}
                <div class="space-y-4">
                    <div>
                        {{ form_label(form.declaredName, null, {label_attr: {class: 'block text-sm font-medium text-slate-700'}}) }}
                        {{ form_widget(form.declaredName, {attr: {class: 'mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus-visible:ring-2 focus-visible:ring-indigo-500 focus:outline-none'}}) }}
                        {{ form_errors(form.declaredName) }}
                    </div>

                    <label class="flex items-start gap-3 text-sm text-slate-700">
                        {{ form_widget(form.accepted, {attr: {class: 'mt-0.5 size-4 rounded border-slate-300 text-indigo-600 focus-visible:ring-2 focus-visible:ring-indigo-500'}}) }}
                        <span>{{ statement.text }}</span>
                    </label>
                    {{ form_errors(form.accepted) }}

                    <twig:Button type="submit" variant="dark" class="w-full py-2.5">
                        <twig:ux:icon name="lucide:check" />
                        Confirmer la réception
                    </twig:Button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <details class="group mt-4 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm">
        <summary class="flex cursor-pointer items-center gap-1.5 font-medium text-slate-600 hover:text-slate-900 focus-visible:ring-2 focus-visible:ring-indigo-500 rounded">
            <twig:ux:icon name="lucide:chevron-right" class="size-3.5 transition-transform group-open:rotate-90" aria-hidden="true" />
            Je ne reconnais pas ce document
        </summary>
        <div class="mt-3 pl-5">
            <p class="text-xs text-slate-500 mb-2">
                Cette action met votre dossier en pause et votre conseiller en sera immédiatement informé.
            </p>
            {{ form_start(decline_form) }}
                {{ form_row(decline_form.reason, {
                    label_attr: {class: 'block text-xs font-medium text-slate-600'},
                    attr: {class: 'mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus-visible:ring-2 focus-visible:ring-indigo-500 focus:outline-none'}
                }) }}
                <twig:Button type="submit" variant="destructive" size="sm" class="mt-2">
                    Confirmer le refus
                </twig:Button>
            {{ form_end(decline_form) }}
        </div>
    </details>
{% endblock %}
