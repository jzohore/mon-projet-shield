<!DOCTYPE html>
<html lang="fr" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Document d'Entrée en Relation{% endblock %}</title>
    <link rel="icon" href="{{ absolute_url(asset('kysure_favicon/favicon.ico')) }}">
    {{ importmap('app') }}
</head>
<body class="h-full font-sans text-slate-900 bg-slate-50">
    <main id="main-content" class="min-h-full flex flex-col items-center px-4 py-10 sm:py-16">
        <div class="w-full {% block width %}max-w-2xl{% endblock %}">
            {% for message in app.flashes('error') %}
                <div class="mb-4 rounded-md border-l-4 border-l-red-500 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {% block content %}{% endblock %}

            <p class="mt-8 text-center text-xs text-slate-400">
                Document transmis via KYSURE pour le compte de votre conseiller.
            </p>
        </div>
    </main>
</body>
</html>
