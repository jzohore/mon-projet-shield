{% extends '@website/base.html.twig' %}

{% block title %}Créer un compte - {{ company_name }}{% endblock %}

{% block body %}
    {# SEO & Sémantique : Le conteneur principal devient un <main> #}
    <main class="flex min-h-screen w-full bg-background antialiased">

        {# =========================================================
       MOITIÉ GAUCHE : LA PROMESSE (Design Stripe / Apple)
       ========================================================= #}
        {# Sémantique : Devient un <aside> car c'est du contenu secondaire sur mobile #}
        <aside class="relative hidden w-1/2 flex-col justify-between bg-[#0A0B0E] p-12 lg:flex overflow-hidden" aria-labelledby="register-marketing-title">

            {# Mesh Gradient (Caché aux lecteurs d'écran) #}
            <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
                <div class="absolute -top-[20%] -left-[10%] w-[70%] h-[70%] rounded-full bg-blue-600/10 blur-[120px]"></div>
                <div class="absolute bottom-[0%] -right-[10%] w-[60%] h-[60%] rounded-full bg-emerald-500/10 blur-[100px]"></div>
            </div>

            {# Logo #}
            <div class="relative z-10 flex items-center gap-3 text-xl font-semibold tracking-tight text-white">
                <div class="flex size-9 items-center justify-center rounded-xl bg-gradient-to-b from-slate-700 to-slate-900 border border-slate-700 shadow-inner">
                    <img src="{{ asset('kysure_logo.png') }}" alt="Logo de {{ company_name }}">
                </div>
                <a href="{{ path('website_home') }}" title="Retour à la page d'accueil">
                    {{ company_name }}
                </a>
            </div>

            {# La promesse d'Onboarding #}
            <div class="relative z-10 max-w-md space-y-8 mt-12 mb-auto">
                {# SEO : Devient un <h2> car il disparaît sur mobile #}
                <h2 id="register-marketing-title" class="text-[2.75rem] font-medium leading-[1.1] tracking-tight text-slate-50">
                    Votre conformité. <br>
                    <span class="text-slate-500">Notre infrastructure.</span>
                </h2>
                <p class="text-[1.05rem] text-slate-400 leading-relaxed font-light">
                    Rejoignez les cabinets d'audit et les institutions financières qui font confiance à {{ company_name }} pour sécuriser leurs processus réglementaires.
                </p>

                {# Chiffres clés ou rassurance rapide #}
                <div class="flex items-center gap-8 pt-4">
                    <div>
                        <div class="text-2xl font-bold text-white">SecNum</div>
                        <div class="text-sm text-slate-500 font-medium">Hébergement certifié</div>
                    </div>
                    <div class="w-px h-10 bg-slate-800" aria-hidden="true"></div>
                    <div>
                        <div class="text-2xl font-bold text-white">100%</div>
                        <div class="text-sm text-slate-500 font-medium">Traçabilité garantie</div>
                    </div>
                </div>
            </div>

            {# Le Badge (Glassmorphism) #}
            <div class="relative z-10 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6 backdrop-blur-xl shadow-2xl flex items-center gap-4">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400">
                    <i class="fas fa-lock text-sm" aria-hidden="true"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-slate-200">Chiffrement de bout en bout</p>
                    <p class="text-xs text-slate-400 mt-0.5">Vos données KYC ne quittent jamais l'Union Européenne.</p>
                </div>
            </div>
        </aside>

        {# =========================================================
       MOITIÉ DROITE : LE FORMULAIRE D'INSCRIPTION
       ========================================================= #}
        {# Sémantique : Devient une <section> #}
        <section class="relative flex w-full flex-col items-center justify-center p-6 lg:w-1/2 sm:p-12">

            {# === NOUVEAU : LOGO MOBILE === #}
            {# Indispensable pour que l'utilisateur mobile sache où il s'inscrit #}
            <div class="absolute left-6 top-6 flex items-center gap-2 font-bold text-foreground lg:hidden">
                <div class="flex size-8 items-center justify-center rounded-lg bg-slate-900 text-white shadow-sm">
                    <i class="fas fa-shield-halved text-[12px]" aria-hidden="true"></i>
                </div>
                {{ company_name }}
            </div>

            {# Lien vers la connexion (En haut à droite) #}
            <div class="absolute right-6 top-6 md:right-8 md:top-8 flex items-center gap-2 z-10">
                <span class="hidden text-sm text-muted-foreground sm:inline-block">Déjà un compte ?</span>
                <twig:Button as="a" href="{{ path('app_login') }}" variant="ghost" class="text-foreground text-sm">
                    Connexion
                </twig:Button>
            </div>

            {# Le conteneur du formulaire #}
            {# Margin-top augmenté sur mobile (mt-20) pour ne pas chevaucher le logo/bouton du header #}
            <div class="w-full max-w-[400px] space-y-8 mt-20 lg:mt-0">

                <header class="space-y-2 text-center lg:text-left">
                    {# SEO : C'est le vrai <h1>, l'action principale de la page #}
                    <h1 class="text-2xl font-bold tracking-tight text-foreground">Créer votre espace.</h1>
                    <p class="text-sm text-muted-foreground">
                        Configurez votre accès auditeur en moins de deux minutes.
                    </p>
                </header>

                <twig:CreateUserFormComponent></twig:CreateUserFormComponent>

                {# A11y : Ajout des états de focus pour la navigation au clavier #}
                <footer class="text-center text-xs text-muted-foreground">
                    En créant un compte, vous acceptez nos
                    <br class="sm:hidden"> {# Retour à la ligne pour les petits écrans #}
                    <a href="#" class="underline underline-offset-4 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm transition-colors">Conditions générales</a> et confirmez agir au nom d'une entité professionnelle.
                </footer>

            </div>
        </section>

    </main>
{% endblock %}
