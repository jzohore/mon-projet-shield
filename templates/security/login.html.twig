{% extends '@website/base.html.twig' %}

{% block title %}Connexion - Shield{% endblock %}

{% block body %}
    <div class="flex min-h-screen w-full bg-background antialiased">

        {# =========================================================
       MOITIÉ GAUCHE : LA PRÉCISION STRIPE / APPLE
       ========================================================= #}
        <div class="relative hidden w-1/2 flex-col justify-between bg-[#0A0B0E] p-12 lg:flex overflow-hidden">

            {# 1. Le "Mesh Gradient" façon Stripe (Lumière diffuse et sophistiquée) #}
            <div class="absolute inset-0 pointer-events-none overflow-hidden">
                <div class="absolute -top-[20%] -left-[10%] w-[70%] h-[70%] rounded-full bg-blue-600/10 blur-[120px]"></div>
                <div class="absolute bottom-[0%] -right-[10%] w-[60%] h-[60%] rounded-full bg-indigo-500/10 blur-[100px]"></div>
            </div>

            {# 2. Le Logo (Traitement "Hardware" premium) #}
            <div class="relative z-10 flex items-center gap-3 text-xl font-semibold tracking-tight text-white">
                <div class="flex size-9 items-center justify-center rounded-xl bg-gradient-to-b from-slate-700 to-slate-900 border border-slate-700 shadow-inner">
                    <i class="fas fa-shield-halved text-[13px] text-white/90"></i>
                </div>
                Shield
            </div>

            {# 3. La proposition de valeur (Typographie millimétrée) #}
            <div class="relative z-10 max-w-md space-y-8 mt-12 mb-auto">
                <h1 class="text-[2.75rem] font-medium leading-[1.1] tracking-tight text-slate-50">
                    La conformité, <br>
                    <span class="text-slate-500">sans la complexité.</span>
                </h1>
                <p class="text-[1.05rem] text-slate-400 leading-relaxed font-light">
                    Automatisez vos processus KYC, gérez vos habilitations finement et maintenez une piste d'audit infaillible en toute sécurité.
                </p>
            </div>

            {# 4. Le Témoignage (Glassmorphism ultra-fin) #}
            <div class="relative z-10 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6 backdrop-blur-xl shadow-2xl">
                <div class="flex items-start gap-4">
                    <i class="fas fa-quote-left text-slate-600 mt-1"></i>
                    <div class="space-y-3">
                        <p class="text-sm font-medium leading-relaxed text-slate-200">
                            Shield a divisé par trois notre temps de traitement des dossiers clients tout en garantissant un niveau de sécurité institutionnel.
                        </p>
                        <div class="flex items-center gap-2">
                            <div class="h-[1px] w-4 bg-slate-700"></div>
                            <p class="text-xs font-medium text-slate-400 tracking-wide uppercase">
                                Directeur Conformité, Banque XYZ
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# =========================================================
       MOITIÉ DROITE : TON FORMULAIRE (Inchangé)
       ========================================================= #}
        {# On ajoute "relative" ici pour que le bouton absolu reste dans cette moitié d'écran #}
        <div class="relative flex w-full flex-col items-center justify-center p-8 lg:w-1/2 sm:p-12">

            {# === LE LIEN EN HAUT À DROITE === #}
            <div class="absolute right-4 top-4 md:right-8 md:top-8">
                <twig:Button as="a" href="{{ path('app_register') }}" variant="ghost" class="text-muted-foreground">
                    Créer un compte
                </twig:Button>
            </div>

            {# === LE FORMULAIRE CENTRÉ === #}
            <div class="w-full max-w-[350px] space-y-8">

                <div class="space-y-2">
                    <h2 class="text-2xl font-bold tracking-tight text-foreground">Bon retour.</h2>
                    <p class="text-sm text-muted-foreground">
                        Saisissez votre adresse email professionnelle. Nous vous enverrons un lien magique pour vous connecter instantanément.
                    </p>
                </div>

                <twig:LoginUserFormComponent></twig:LoginUserFormComponent>

                <p class="text-center text-xs text-muted-foreground">
                    En continuant, vous acceptez nos
                    <a href="#" class="underline underline-offset-4 hover:text-foreground transition-colors">Conditions de service</a> et notre
                    <a href="#" class="underline underline-offset-4 hover:text-foreground transition-colors">Politique de confidentialité</a>.
                </p>

            </div>
        </div>

    </div>
{% endblock %}
