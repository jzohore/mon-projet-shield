{% extends '@website/base.html.twig' %}

{% block title %}{{ company_name }} — KYC & KYB automatisé pour les professionnels réglementés{% endblock %}

{% block meta_description %}{{ company_name }} automatise vos vérifications KYC et KYB en 60 secondes. Piste d'audit ACPR, conformité LCB-FT, hébergement souverain. 5 vérifications gratuites.{% endblock %}

{% block body %}
    <div class="min-h-screen bg-white text-[#1a1a1a] font-sans antialiased selection:bg-[#cce4ff]">

        {% include '@website/_header.html.twig' %}
        <main id="contenu-principal">

            {# ==========================================
           1. HERO — Impact maximal, CTA double
           ========================================== #}
            <section aria-labelledby="hero-heading" class="relative pt-20 pb-16 px-4 sm:px-6 overflow-hidden">

                {# Glow de fond discret #}
                <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
                    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-blue-50 rounded-full blur-3xl opacity-60"></div>
                </div>

                <div class="relative mx-auto max-w-5xl text-center">

                    {# Pill badge — légitimité #}

                    {# H1 — proposition de valeur claire, mots-clés SEO #}
                    <h1 id="hero-heading" class="text-[36px] sm:text-[48px] md:text-[48px] font-bold leading-[1.1] tracking-tight mb-6">
                        Vos dossiers clients,<br>
                        <span class="text-[#0060df]">pilotés simplement et sans friction.</span>
                    </h1>

                    <p class="mx-auto max-w-2xl text-[16px] sm:text-[18px] text-[#555] leading-relaxed mb-10">
                        {{ company_name }} aide les CGP, indépendants, cabinets et agences immobilières à centraliser leurs contrôles, leurs documents et leur piste d’audit. Gagnez du temps, sécurisez vos dossiers et gardez une vision claire en un seul espace.
                    </p>

                    {# CTAs principaux #}
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-4">
                        <a href="{{ path('app_register') }}"
                           class="w-full sm:w-auto rounded-[6px] bg-[#0060df] px-8 py-3.5 text-[16px] font-bold text-white hover:bg-[#0050bc] shadow-md hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-[#0060df] focus:ring-offset-2"
                           aria-label="Créer un compte et tester 5 vérifications KYC gratuitement">
                            Tester 5 vérifications gratuites →
                        </a>
                        <a href="#demo"
                           class="w-full sm:w-auto rounded-[6px] border border-[#e6e6e6] px-8 py-3.5 text-[16px] font-bold text-[#1a1a1a] hover:bg-[#f5f5f5] transition-all focus:outline-none focus:ring-2 focus:ring-[#1a1a1a] focus:ring-offset-2">
                            Demander une démo
                        </a>
                    </div>

                    {# Réassurance sous CTAs #}
                    <p class="text-[13px] text-[#999] font-medium">
                        Sans carte bancaire · Sans engagement · Résultats en 60 secondes
                    </p>

                    {# Dashboard mockup #}
                    <figure class="mt-16 relative max-w-5xl mx-auto" aria-label="Aperçu du dashboard réel de {{ company_name }}">
                        <div class="rounded-xl border border-[#e6e6e6] bg-[#f7f7f5] p-1.5 shadow-2xl shadow-slate-200 overflow-hidden">
                            <div class="bg-white rounded-lg border border-[#e6e6e6] overflow-hidden">

                                {# Barre navigateur factice #}
                                <div class="flex items-center gap-1.5 px-4 py-3 border-b border-[#f0f0f0] bg-[#fafafa]">
                                    <div class="flex gap-1.5">
                                        <span class="size-2.5 rounded-full bg-[#ff5f56]" aria-hidden="true"></span>
                                        <span class="size-2.5 rounded-full bg-[#ffbd2e]" aria-hidden="true"></span>
                                        <span class="size-2.5 rounded-full bg-[#27c93f]" aria-hidden="true"></span>
                                    </div>
                                    <div class="ml-4 flex-1 max-w-xs rounded-full bg-[#f0f0f0] px-4 py-1 text-[11px] text-[#999] font-mono">
                                        app.kysure.fr/tableau-de-bord
                                    </div>
                                </div>

                                {# Corps du dashboard — Aligné sur la capture réelle #}
                                <div class="flex min-h-[450px]">

                                    {# Sidebar — Dark mode comme sur l'image #}
                                    <aside class="hidden sm:flex w-[200px] flex-col bg-[#0B1121] p-4 text-slate-400" aria-label="Menu latéral réel">
                                        <div class="mb-8 px-2 text-[10px] font-bold uppercase tracking-widest opacity-50">Conformité</div>
                                        <nav class="space-y-1 flex-1">
                                            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[#1e293b] text-white text-[13px] font-medium">
                                                <twig:ux:icon name="lucide:layout-dashboard" class="size-4" /> Tableau de bord
                                            </div>
                                            <div class="flex items-center gap-2 px-3 py-2 text-[13px] hover:bg-slate-800 transition-colors">
                                                <twig:ux:icon name="lucide:folder" class="size-4" /> Dossiers
                                                <span class="ml-auto size-4 flex items-center justify-center bg-blue-600 text-[10px] text-white rounded-full">2</span>
                                            </div>
                                            <div class="flex items-center gap-2 px-3 py-2 text-[13px] hover:bg-slate-800 transition-colors">
                                                <twig:ux:icon name="lucide:file-text" class="size-4" /> Rapports
                                            </div>
                                            <div class="flex items-center gap-2 px-3 py-2 text-[13px] hover:bg-slate-800 transition-colors">
                                                <twig:ux:icon name="lucide:shield-check" class="size-4" /> Criblage LCB-FT
                                            </div>
                                        </nav>
                                    </aside>

                                    {# Contenu principal #}
                                    <div class="flex-1 bg-[#F9FAFB] p-6 text-left">

                                        {# Top Bar interne #}
                                        <div class="flex justify-between items-center mb-8">
                                            <div class="text-[12px] text-slate-500 font-medium">
                                                <twig:Breadcrumb>
                                                    <twig:Breadcrumb:List>
                                                        <twig:Breadcrumb:Item>
                                                            <twig:Breadcrumb:Link href="{{ path('app_dashboard') }}">
                                                                <twig:ux:icon name="material-symbols:home-rounded" />
                                                            </twig:Breadcrumb:Link>
                                                        </twig:Breadcrumb:Item>

                                                        <twig:Breadcrumb:Separator />
                                                        <twig:Breadcrumb:Item>
                                                            <twig:Breadcrumb:Page class="text-xs">
                                                                Vue d'ensemble
                                                            </twig:Breadcrumb:Page>
                                                        </twig:Breadcrumb:Item>
                                                    </twig:Breadcrumb:List>
                                                </twig:Breadcrumb>
                                            </div>
                                            <div class="flex items-center gap-3">
                                                <div class="bg-white border border-slate-200 rounded-md px-3 py-1 flex items-center gap-2 shadow-sm">
                                                    <span class="size-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                                                    <span class="text-[11px] font-bold text-slate-700">100 crédits</span>
                                                </div>
                                                <div class="size-7 rounded-md bg-purple-100 flex items-center justify-center text-[10px] font-bold text-purple-700 border border-purple-200">AN</div>
                                            </div>
                                        </div>

                                        <div class="flex items-center justify-between mb-6">
                                            <div>
                                                <h2 class="text-[20px] font-bold text-slate-900">Tableau de bord</h2>
                                            </div>
                                            <div class="flex gap-2">
                                                <div class="px-4 py-1.5 bg-white border border-slate-200 rounded-lg text-[12px] font-bold text-slate-700 shadow-sm flex items-center gap-2">
                                                    <twig:ux:icon name="lucide:plus" class="size-3" /> Nouveau KYC
                                                </div>
                                                <div class="px-4 py-1.5 bg-[#6366F1] rounded-lg text-[12px] font-bold text-white shadow-lg shadow-indigo-200 flex items-center gap-2">
                                                    <twig:ux:icon name="lucide:zap" class="size-3" /> Conseil Advisory
                                                </div>
                                            </div>
                                        </div>

                                        {# Cartes réelles basées sur image_d8e8a6.jpg #}
                                        <div class="grid grid-cols-4 gap-4 mb-8">
                                            {# Crédits #}
                                            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                                                <div class="flex justify-between items-start mb-2">
                                                    <span class="text-[10px] font-bold text-slate-400 uppercase">Crédits</span>
                                                    <twig:ux:icon name="lucide:wallet" class="size-3.5 text-blue-500" />
                                                </div>
                                                <div class="text-[22px] font-bold text-slate-900">100</div>
                                                <div class="text-[10px] text-blue-600 font-bold hover:underline cursor-pointer">Recharger</div>
                                            </div>
                                            {# Dossiers #}
                                            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                                                <div class="flex justify-between items-start mb-2">
                                                    <span class="text-[10px] font-bold text-slate-400 uppercase">Dossiers</span>
                                                    <twig:ux:icon name="lucide:refresh-cw" class="size-3.5 text-orange-400" />
                                                </div>
                                                <div class="text-[22px] font-bold text-slate-900">3</div>
                                                <div class="text-[10px] text-slate-500">KYC/KYB actifs</div>
                                            </div>
                                            {# Rapports #}
                                            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                                                <div class="flex justify-between items-start mb-2">
                                                    <span class="text-[10px] font-bold text-slate-400 uppercase">Rapports</span>
                                                    <twig:ux:icon name="lucide:file-check" class="size-3.5 text-emerald-500" />
                                                </div>
                                                <div class="text-[22px] font-bold text-slate-900">12</div>
                                                <div class="text-[10px] text-slate-500">ce mois-ci</div>
                                            </div>
                                            {# Alertes #}
                                            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                                                <div class="flex justify-between items-start mb-2">
                                                    <span class="text-[10px] font-bold text-slate-400 uppercase">Risques</span>
                                                    <twig:ux:icon name="lucide:alert-circle" class="size-3.5 text-red-500" />
                                                </div>
                                                <div class="text-[22px] font-bold text-slate-900">0</div>
                                                <div class="text-[10px] text-slate-500">Sanctions/PEPs</div>
                                            </div>
                                        </div>

                                        {# Zone centrale vide comme sur l'image #}
                                        <div class="h-48 border-2 border-dashed border-slate-200 rounded-2xl flex flex-col items-center justify-center bg-white">
                                            <div class="size-12 rounded-full bg-slate-50 flex items-center justify-center text-slate-300 mb-4">
                                                <twig:ux:icon name="lucide:fingerprint" class="size-6" />
                                            </div>
                                            <p class="text-[14px] font-bold text-slate-900">Prêt à sécuriser vos relations ?</p>
                                            <p class="text-[11px] text-slate-400 mt-1 italic">Lancez un premier module pour générer vos synthèses.</p>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Badge flottant — on le garde car il apporte du "Notion touch" #}
                        <div class="absolute -left-3 sm:-left-8 top-1/3 bg-white p-3 rounded-xl border border-[#e6e6e6] shadow-xl flex items-center gap-3 animate-bounce" role="status" aria-label="Dossier conforme">
                            <div class="size-9 rounded-lg bg-emerald-100 flex items-center justify-center text-xl" aria-hidden="true">🛡️</div>
                            <div class="text-left leading-tight">
                                <div class="text-[12px] font-bold text-slate-900">Dossier conforme</div>
                                <div class="text-[10px] text-slate-500 font-mono mt-0.5">KYC-882-VERIFIED · 0.8s</div>
                            </div>
                        </div>
                    </figure>
                </div>

                {# Barre logos — preuve sociale #}
                <div class="mt-32 max-w-5xl mx-auto border-t border-[#f0f0f0] pt-10">
                    <p class="text-center text-[11px] font-bold text-[#bbb] uppercase tracking-widest mb-12">
                        La solution dédiée aux professionnels du patrimoine
                    </p>

                    <ul class="flex flex-wrap justify-center items-center gap-6 md:gap-10 opacity-80">
                        {% set professions = [
                            {'name': 'Conseillers en Patrimoine', 'seed': 'cgp'},
                            {'name': 'Agences Immobilières', 'seed': 'immo'},
                            {'name': 'Cabinets d\'Audit', 'seed': 'audit'},
                            {'name': 'Expertise Comptable', 'seed': 'compta'},
                            {'name': 'Notaires', 'seed': 'notaire'}
                        ] %}

                        {% for item in professions %}
                            <li class="group relative">
                                {# L'Avatar qui sort au hover #}
                                <div class="absolute -top-8 left-1/2 -translate-x-1/2 w-12 h-12 opacity-0 pointer-events-none transform translate-y-4 group-hover:opacity-100 group-hover:-translate-y-6 group-hover:scale-110 transition-all duration-300 ease-out z-0">
                                    <img src="https://api.dicebear.com/7.x/notionists/svg?seed={{ item.seed }}&scale=110"
                                         alt="Illustration"
                                         class="w-full h-full filter grayscale">
                                </div>

                                {# Le Badge (au premier plan) #}
                                <div class="relative z-10 px-5 py-2.5 rounded-lg bg-white border border-[#e6e6e6] text-[13px] font-bold text-[#1a1a1a] shadow-sm group-hover:border-[#0060df] group-hover:text-[#0060df] transition-all cursor-default">
                                    {{ item.name }}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>

            {# ==========================================
           2. STATS — Chiffres clés
           ========================================== #}
            <section aria-labelledby="stats-heading" class="border-y border-[#f0f0f0] bg-[#fafafa] py-12 px-4 sm:px-6">
                <h2 id="stats-heading" class="sr-only">Chiffres clés de {{ company_name }}</h2>
                <dl class="mx-auto max-w-5xl grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-0 md:divide-x md:divide-[#ececec] text-center">
                    <div class="md:px-6">
                        <dt class="text-[11px] font-bold text-[#999] uppercase tracking-widest mb-1">Vérifications traitées</dt>
                        <dd class="text-[30px] sm:text-[36px] font-bold tracking-tight">128&nbsp;742</dd>
                    </div>
                    <div class="md:px-6">
                        <dt class="text-[11px] font-bold text-[#999] uppercase tracking-widest mb-1">Temps moyen d'analyse</dt>
                        <dd class="text-[30px] sm:text-[36px] font-bold tracking-tight">0,8s</dd>
                    </div>
                    <div class="md:px-6">
                        <dt class="text-[11px] font-bold text-[#999] uppercase tracking-widest mb-1">Disponibilité garantie</dt>
                        <dd class="text-[30px] sm:text-[36px] font-bold tracking-tight">99,99%</dd>
                    </div>
                    <div class="md:px-6">
                        <dt class="text-[11px] font-bold text-[#999] uppercase tracking-widest mb-1">Incidents de sécurité</dt>
                        <dd class="text-[30px] sm:text-[36px] font-bold tracking-tight">0</dd>
                    </div>
                </dl>
            </section>

            {# ==========================================
           3. FONCTIONNALITÉS — Feature split
           ========================================== #}
            <section id="produit" aria-labelledby="produit-heading" class="py-24 px-4 sm:px-6 bg-[#f7f7f5]">
                <div class="mx-auto max-w-7xl">

                    <header class="mb-16 max-w-2xl">
                        <p class="text-[12px] font-bold text-[#0060df] uppercase tracking-widest mb-3">La plateforme</p>
                        <h2 id="produit-heading" class="text-[36px] sm:text-[42px] font-bold leading-tight tracking-tight">
                            Un suivi d'audit automatisé,<br>en continu.
                        </h2>
                    </header>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-24">
                        <div>
                            <div class="space-y-3">
                                <article class="group p-4 rounded-xl hover:bg-white transition-all border border-transparent hover:border-[#e6e6e6] hover:shadow-sm">
                                    <div class="flex items-start gap-4">
                                        <div class="size-9 shrink-0 bg-orange-100 rounded-lg flex items-center justify-center text-xl" aria-hidden="true">🔔</div>
                                        <div>
                                            <h3 class="text-[17px] font-bold mb-1">Alertes LCB-FT intelligentes</h3>
                                            <p class="text-[#666] leading-relaxed text-[15px]">Soyez notifié dès qu'un bénéficiaire effectif apparaît sur une liste de sanctions internationales (OFAC, UE, ONU).</p>
                                        </div>
                                    </div>
                                </article>

                                <article class="group p-4 rounded-xl hover:bg-white transition-all border border-transparent hover:border-[#e6e6e6] hover:shadow-sm">
                                    <div class="flex items-start gap-4">
                                        <div class="size-9 shrink-0 bg-purple-100 rounded-lg flex items-center justify-center text-xl" aria-hidden="true">📄</div>
                                        <div>
                                            <h3 class="text-[17px] font-bold mb-1">Génération de rapports certifiés</h3>
                                            <p class="text-[#666] leading-relaxed text-[15px]">Exportez des rapports PDF certifiés pour vos audits internes ou les régulateurs (ACPR, Tracfin) en un clic.</p>
                                        </div>
                                    </div>
                                </article>

                                <article class="group p-4 rounded-xl hover:bg-white transition-all border border-transparent hover:border-[#e6e6e6] hover:shadow-sm">
                                    <div class="flex items-start gap-4">
                                        <div class="size-9 shrink-0 bg-blue-100 rounded-lg flex items-center justify-center text-xl" aria-hidden="true">🔍</div>
                                        <div>
                                            <h3 class="text-[17px] font-bold mb-1">Moteur OCR & extraction IA</h3>
                                            <p class="text-[#666] leading-relaxed text-[15px]">Extraction instantanée des données sur les Kbis, CNI et statuts. Détection automatique des fraudes documentaires.</p>
                                        </div>
                                    </div>
                                </article>
                            </div>

                            <div class="mt-8 pl-4">
                                <a href="{{ path('website_features') }}" class="inline-flex items-center gap-2 text-[#0060df] font-bold text-[15px] hover:underline">
                                    Voir toutes les fonctionnalités →
                                </a>
                            </div>
                        </div>

                        {# Preview piste d'audit #}
                        <figure class="bg-white rounded-2xl border border-[#e6e6e6] shadow-xl overflow-hidden" aria-label="Interface de piste d'audit {{ company_name }}">
                            <div class="flex items-center gap-1.5 px-4 py-3 border-b border-[#f0f0f0] bg-[#fafafa]">
                                <span class="size-2.5 rounded-full bg-[#ff5f56]" aria-hidden="true"></span>
                                <span class="size-2.5 rounded-full bg-[#ffbd2e]" aria-hidden="true"></span>
                                <span class="size-2.5 rounded-full bg-[#27c93f]" aria-hidden="true"></span>
                                <span class="ml-4 text-[10px] font-bold text-[#bbb] font-mono uppercase tracking-widest">Audit_Log — Dossier #KYC-882</span>
                            </div>
                            <div class="p-6">
                                <ul class="space-y-2" aria-label="Événements de la piste d'audit">
                                    {% set events = [
                                        {'icon': '✅', 'label': 'Identité vérifiée', 'time': '09:41:02'},
                                        {'icon': '📂', 'label': 'Kbis extrait & validé', 'time': '09:41:05'},
                                        {'icon': '🔍', 'label': 'Bénéficiaires effectifs identifiés', 'time': '09:41:08'},
                                        {'icon': '🛡️', 'label': 'Screening sanctions : RAS', 'time': '09:41:10'},
                                        {'icon': '⏳', 'label': 'Validation compliance en attente', 'time': '09:41:12'}
                                    ] %}
                                    {% for event in events %}
                                        <li class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-[#f7f7f5] transition-colors border-b border-[#f7f7f5] last:border-0">
                                            <span class="text-base shrink-0" aria-hidden="true">{{ event.icon }}</span>
                                            <span class="text-[13px] font-medium flex-1">{{ event.label }}</span>
                                            <time class="text-[11px] font-mono text-[#999] shrink-0">{{ event.time }}</time>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </figure>
                    </div>

                    {# Témoignage + métriques #}
                    <div class="rounded-2xl border border-[#e6e6e6] bg-white p-8 sm:p-12 grid grid-cols-1 md:grid-cols-2 gap-10 items-center shadow-sm">
                        <div>
                            <blockquote class="text-[20px] sm:text-[22px] font-medium leading-snug text-[#1a1a1a] mb-6 italic">
                                "Depuis {{ company_name }}, nos équipes ne chassent plus les Kbis manquants. Notre temps d'onboarding a été divisé par&nbsp;4."
                            </blockquote>
                            <cite class="flex items-center gap-3 not-italic">
                                <div class="size-10 rounded-full bg-[#e6e6e6] flex items-center justify-center font-bold text-sm text-[#555]" aria-hidden="true">JD</div>
                                <div>
                                    <div class="text-[14px] font-bold">Julien D.</div>
                                    <div class="text-[13px] text-[#666]">Directeur Conformité, NeoBank (Beta)</div>
                                </div>
                            </cite>
                        </div>
                        <dl class="grid grid-cols-2 gap-4">
                            <div class="rounded-xl bg-[#f7f7f5] p-5 border border-[#f0f0f0]">
                                <dd class="text-[28px] font-bold text-[#0060df] mb-1">−80%</dd>
                                <dt class="text-[13px] text-[#666] font-medium">Temps d'analyse réduit</dt>
                            </div>
                            <div class="rounded-xl bg-[#f7f7f5] p-5 border border-[#f0f0f0]">
                                <dd class="text-[28px] font-bold text-[#0060df] mb-1">3 min</dd>
                                <dt class="text-[13px] text-[#666] font-medium">Au lieu de 25 par dossier</dt>
                            </div>
                            <div class="rounded-xl bg-[#f7f7f5] p-5 border border-[#f0f0f0]">
                                <dd class="text-[28px] font-bold text-[#0060df] mb-1">0</dd>
                                <dt class="text-[13px] text-[#666] font-medium">Dossier incomplet relancé</dt>
                            </div>
                            <div class="rounded-xl bg-[#f7f7f5] p-5 border border-[#f0f0f0]">
                                <dd class="text-[28px] font-bold text-[#0060df] mb-1">100%</dd>
                                <dt class="text-[13px] text-[#666] font-medium">Audit trail ACPR-ready</dt>
                            </div>
                        </dl>
                    </div>
                </div>
            </section>

            {# ==========================================
           4. CAS D'USAGE — Solutions par métier
           ========================================== #}
            <section id="usage" aria-labelledby="usage-heading" class="py-24 px-4 sm:px-6 bg-white">
                <div class="mx-auto max-w-7xl">
                    <header class="text-center mb-16">
                        <p class="text-[12px] font-bold text-[#0060df] uppercase tracking-widest mb-3">Solutions</p>
                        <h2 id="usage-heading" class="text-[36px] sm:text-[42px] font-bold tracking-tight">
                            Adapté à votre métier.
                        </h2>
                        <p class="mt-4 text-[18px] text-[#555] max-w-xl mx-auto">La conformité sur-mesure pour chaque secteur réglementé.</p>
                    </header>

                    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
                        {% set usecases = [
                            {
                                'icon': '🧮',
                                'title': 'Experts-Comptables',
                                'desc': "Simplifiez l'entrée en relation. Collectez les Kbis, validez les statuts et identifiez les Bénéficiaires Effectifs (UBO) en quelques clics.",
                                'tags': ['LCB-FT', 'Tracfin']
