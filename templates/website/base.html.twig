<!DOCTYPE html>
{# 1. Langue dynamique pour les lecteurs d'écran (a11y) #}
<html lang="{{ app.request.locale|default('fr') }}" class="antialiased">
<head>
    <meta charset="UTF-8">

    {# 2. Viewport accessible : on autorise le zoom jusqu'à 5x pour les malvoyants #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">

    {# 3. SEO : Titre et Description dynamiques avec Fallback #}
    <title>{% block title %}Bienvenue{% endblock %} - Shield</title>
    <meta name="description" content="{% block meta_description %}Shield : La plateforme RegTech de référence pour la gestion de vos conformités, habilitations et pistes d'audit.{% endblock %}">

    {# 4. Robots : Indexation par défaut, mais surchargeable sur des pages privées #}
    <meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">

    {# 5. Open Graph / Twitter Card (Pour les aperçus propres sur Slack, LinkedIn, etc.) #}
    {% block meta_social %}
        <meta property="og:type" content="website">
        <meta property="og:title" content="{{ block('title') }} - Shield">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:image" content="{{ absolute_url(asset('images/og-shield.jpg')) }}">
        <meta name="twitter:card" content="summary_large_image">
    {% endblock %}

    {# Favicon propre #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛡️</text></svg>">

    {# Thème couleur pour la barre de statut des navigateurs mobiles #}
    <meta name="theme-color" content="#0f172a">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

{# 6. Classes de base Tailwind : antialiased (lisse les polices), fond et texte par défaut #}
<body class="min-h-screen bg-background text-foreground font-sans selection:bg-primary/20 selection:text-primary flex flex-col">

{# 7. Lien d'évitement (Skip-to-content) : Indispensable pour l'accessibilité au clavier.
          Il est invisible sauf si l'utilisateur appuie sur "Tab". #}
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-primary-foreground focus:outline-none focus:ring-2 focus:ring-offset-2">
    Aller au contenu principal
</a>

{# 8. Le bloc de contenu principal (La balise <main> est cruciale pour le SEO/a11y) #}
<main id="main-content" class="flex-grow flex flex-col outline-none" tabindex="-1">
    {% block body %}{% endblock %}
</main>

</body>
</html>
