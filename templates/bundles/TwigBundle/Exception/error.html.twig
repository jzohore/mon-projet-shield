{% extends '@website/base.html.twig' %}

{% block title %}Incident technique (500) — {{ company_name }}{% endblock %}

{% block body %}
    <div class="min-h-screen bg-[#f7f7f5] flex flex-col antialiased">

        <main class="flex-1 flex items-center justify-center px-6">
            <div class="max-w-lg w-full bg-white rounded-2xl border border-[#e6e6e6] p-12 shadow-xl text-center space-y-8">

                <div class="size-16 rounded-full bg-amber-50 flex items-center justify-center mx-auto text-amber-600">
                    <twig:ux:icon name="lucide:wrench" class="size-8" />
                </div>

                <div class="space-y-4">
                    <h1 class="text-[28px] font-bold tracking-tight">Analyse interrompue.</h1>
                    <p class="text-[#666] leading-relaxed">
                        Notre moteur de vérification rencontre une difficulté technique imprévue. Nos équipes (enfin, Junior) sont déjà sur le coup.
                    </p>
                </div>

                {# Status Box #}
                <div class="bg-[#fafafa] rounded-lg border border-[#f0f0f0] p-4 flex items-center justify-between text-left">
                    <div>
                        <div class="text-[12px] font-bold text-slate-900">Serveurs Scaleway</div>
                        <div class="text-[11px] text-emerald-600 font-medium">Opérationnels 🇫🇷</div>
                    </div>
                    <div class="h-8 w-px bg-[#eee]"></div>
                    <div>
                        <div class="text-[12px] font-bold text-slate-900">Base de données</div>
                        <div class="text-[11px] text-emerald-600 font-medium">En ligne</div>
                    </div>
                </div>

                <div class="pt-4">
                    <button onclick="window.location.reload()" class="w-full rounded-[6px] border border-[#e6e6e6] px-6 py-3 text-[15px] font-bold hover:bg-[#f5f5f5] transition-all flex items-center justify-center gap-2">
                        <twig:ux:icon name="lucide:refresh-cw" class="size-4" />
                        Tenter de rafraîchir la page
                    </button>
                </div>

                <p class="text-[12px] text-[#999]">
                    Si le problème persiste, n'hésitez pas à nous contacter sur <strong>contact@kysure.fr</strong>
                </p>
            </div>
        </main>
    </div>
{% endblock %}
