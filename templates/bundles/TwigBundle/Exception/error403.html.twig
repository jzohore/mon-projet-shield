{% extends '@website/base.html.twig' %}

{% block title %}Accès refusé{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
    <main class="flex min-h-screen w-full items-center justify-center bg-slate-50 p-6">
        <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <span class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-500" aria-hidden="true">
                {{ ux_icon('lucide:lock', { class: 'size-5' }) }}
            </span>
            <h1 class="text-lg font-bold text-slate-900">Accès réservé</h1>
            <p class="mt-2 text-sm text-slate-500">
                Cette action est réservée aux administrateurs de votre cabinet. Demandez à l'un d'eux
                de vous ouvrir ce droit ou de réaliser l'opération.
            </p>
            <div class="mt-6">
                <twig:Button as="a" href="{{ path('app_dashboard') }}" variant="outline" size="sm">Retour au tableau de bord</twig:Button>
            </div>
        </div>
    </main>
{% endblock %}
