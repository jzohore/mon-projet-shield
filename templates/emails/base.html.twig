<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ company_name }} RegTech{% endblock %}</title>
    <style>
        /* CSS Inliner de Symfony convertira ça en styles inline automatiquement */
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc; /* slate-50 */
            color: #0f172a; /* slate-900 */
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .wrapper {
            width: 100%;
            table-layout: fixed;
            background-color: #f8fafc;
            padding: 40px 20px;
        }
        .container {
            max-width: 500px;
            margin: 0 auto;
            background-color: #ffffff;
            border: 1px solid #e2e8f0; /* slate-200 */
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .header {
            padding: 32px 40px 10px 40px;
        }
        .logo {
            font-size: 20px;
            font-weight: 700;
            color: #0f172a;
            text-decoration: none;
            letter-spacing: -0.025em;
        }
        .content {
            padding: 20px 40px 40px 40px;
        }
        h1 {
            font-size: 24px;
            font-weight: 600;
            margin: 0 0 16px;
            letter-spacing: -0.025em;
        }
        p {
            font-size: 15px;
            line-height: 24px;
            color: #475569; /* slate-600 */
            margin: 0 0 24px;
        }
        .btn-container {
            margin: 32px 0;
            text-align: center;
        }
        .btn {
            display: inline-block;
            background-color: #0f172a;
            color: #ffffff !important;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 6px;
        }
        .footer {
            padding: 24px 40px;
            background-color: #f8fafc;
            border-top: 1px solid #e2e8f0;
            text-align: center;
        }
        .footer p {
            font-size: 12px;
            color: #94a3b8;
            margin: 0 0 8px 0;
            line-height: 1.5;
        }
        .footer a {
            color: #64748b;
            text-decoration: underline;
        }
    </style>
</head>
<body>
<div class="wrapper">
    <div class="container">

        {# Le Header commun à tous les emails #}
        <div class="header">
            <a href="{{ url('app_login')|default('#') }}" class="logo">{{ company_name }}.</a>
        </div>

        {# Le contenu spécifique sera injecté ici #}
        <div class="content">
            {% block content %}{% endblock %}
        </div>

        {# Le Footer commun #}
        <div class="footer">
            {% block footer_text %}
                <p>Cet email a été envoyé par {{ company_name }}.</p>
            {% endblock %}
            <p>
                <a href="#">Support</a> • <a href="#">Politique de confidentialité</a>
            </p>
        </div>

    </div>
</div>
</body>
</html>
