{# templates/emails/compliance/der_rejected_notification.html.twig #}
{% extends 'emails/base.html.twig' %}

{% block title %}Action requise : DER refusé - {{ client_name }}{% endblock %}

{% block content %}
    <h1 style="color: #0f172a; margin-bottom: 5px;">Signature refusée</h1>
    <h3 style="color: #64748b; font-weight: normal; margin-top: 0; margin-bottom: 20px;">Dossier de : {{ client_name }}</h3>

    <p>Bonjour {{ workspace_name }},</p>

    <p>Le processus d'entrée en relation est <strong>suspendu</strong>. Le client a formellement refusé la signature électronique du Document d'Entrée en Relation (DER).</p>

    {# Le bloc d'alerte (Rouge) pour mettre en évidence le motif #}
    <div style="background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 15px; border-radius: 0 6px 6px 0; margin: 25px 0;">
        <h4 style="color: #991b1b; margin-top: 0; margin-bottom: 10px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px;">Motif du refus</h4>
        <p style="margin: 0; font-size: 14px; color: #7f1d1d; font-style: italic;">
            "{{ decline_reason|default('Aucun motif fourni par le client.') }}"
        </p>
    </div>

    <ul style="list-style-type: none; padding: 0; margin: 0 0 25px 0; font-size: 14px; color: #334155;">
        <li style="margin-bottom: 8px;"><strong>Date de l'événement :</strong> {{ rejected_at }}</li>
        <li><strong>Dossier LCB-FT :</strong> #{{ folder_reference }}</li>
    </ul>

    <div class="btn-container">
        <a href="{{ folder_url }}" class="btn" style="background-color: #0f172a; color: #ffffff;">Ouvrir et corriger le dossier</a>
    </div>

    <p style="font-size: 12px; color: #94a3b8; word-break: break-all; margin-top: 25px;">
        En cas de problème avec le bouton, utilisez cette URL sécurisée :<br>
        <a href="{{ folder_url }}" style="color: #64748b;">{{ folder_url }}</a>
    </p>
{% endblock %}
