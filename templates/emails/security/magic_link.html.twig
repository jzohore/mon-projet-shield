{# On étend le layout de base #}
{% extends 'emails/base.html.twig' %}

{# On personnalise le titre (sujet interne) #}
{% block title %}Votre lien de connexion sécurisé{% endblock %}

{# On injecte le contenu #}
{% block content %}
    <h1>Connexion à votre espace</h1>

    <p>Bonjour,</p>
    <p>Nous avons reçu une demande de connexion à votre compte {{ company_name }}. Cliquez sur le bouton ci-dessous pour vous authentifier en toute sécurité.</p>

    <div class="btn-container">
        <a href="{{ action_url }}" class="btn">Me connecter en toute sécurité</a>
    </div>

    <p style="font-size: 13px; color: #64748b; margin-bottom: 8px;">
        ⏱️ Ce lien est à usage unique et expirera dans <strong>{{ expires_in }}</strong>.
    </p>

    <p style="font-size: 12px; color: #94a3b8; word-break: break-all;">
        Si le bouton ne fonctionne pas, copiez et collez cette URL dans votre navigateur :<br>
        <a href="{{ action_url }}" style="color: #64748b;">{{ action_url }}</a>
    </p>
{% endblock %}

{# On peut même surcharger le footer juste pour cet email de sécurité #}
{% block footer_text %}
    <p>Si vous n'avez pas demandé ce lien, vous pouvez ignorer cet email en toute sécurité. Quelqu'un s'est peut-être trompé en tapant son adresse.</p>
{% endblock %}
