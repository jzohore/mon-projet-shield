{% extends '@admin/base_admin.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('admin_organizations_list') }}" class="text-xs">
            Workspaces & clients
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}

{% block content %}
    <div class="space-y-8  mx-auto">

        {# ========================================================= #}
        {# 1. HEADER : STYLE "CENTRE DE CONTRÔLE"                    #}
        {# ========================================================= #}
        <header class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative z-30">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-[#6e2f1e] rounded-l-2xl"></div>

            <div class="pl-2">
                <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="text-2xl font-bold tracking-tight text-slate-900">{{ workspace.name }}</h1>

                    {% if workspace.isActive %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span> Actif
                    </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        <span class="size-1.5 rounded-full bg-rose-500"></span> Suspendu
                    </span>
                    {% endif %}

                    {% if workspace.subscriptionStatus == 'active' %}
                        <span class="px-2 py-0.5 bg-slate-900 text-white rounded text-[10px] font-bold uppercase tracking-wider">
                        {{ workspace.subscriptionPlan|default('SaaS') }}
                    </span>
                    {% endif %}
                </div>
                <p class="text-xs text-slate-500 mt-1 flex items-center gap-2">
                    Raison sociale : <strong class="text-slate-700">{{ workspace.legalName|default('-') }}</strong>
                    &bull; Réf: <span class="font-mono">{{ workspace.slugId }}</span>
                </p>
            </div>

            {# BARRE D'ACTIONS & TOOLBOX ADMIN #}
            <div class="flex items-center gap-2 shrink-0">

                {# DROPDOWN TOOLBOX ADMIN (PASSANT DEVANT TOUT) #}
                <div class="relative group">
                    <button type="button" class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold border border-slate-200 shadow-sm transition active:scale-95">
                        <twig:ux:icon name="tabler:tools" class="size-4 text-[#6e2f1e]" />
                        <span>Toolbox Admin</span>
                        <twig:ux:icon name="tabler:chevron-down" class="size-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" />
                    </button>

                    <div class="absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-2xl border border-slate-200
                            opacity-0 invisible translate-y-2
                            group-hover:opacity-100 group-hover:visible group-hover:translate-y-0
                            transition-all duration-200 z-[9999] overflow-hidden">


                        <div class="p-1 space-y-1">
                            {# 1. Re-check SIRET #}
                            <form action="{{ path('admin_workspace_action_verify_siret', {slug: workspace.slugId}) }}"
                                  method="POST"
                                  data-controller="submit-emitter"
                                  data-submit-emitter-event-name-value="kysure:siret-loading"
                                  data-action="submit->submit-emitter#submit">

                                <input type="hidden" name="_token" value="{{ csrf_token('verify_siret_' ~ workspace.slugId) }}">

                                <button type="submit"
                                        class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 rounded-lg transition cursor-pointer disabled:opacity-50 disabled:cursor-wait"
                                        data-submit-emitter-target="button">
                                    <twig:ux:icon name="tabler:certificate" class="size-4 text-slate-400" />
                                    Re-vérifier SIRET (INSEE)
                                </button>
                            </form>
                            {# 2. Re-check ORIAS #}
                            <form action="{{ path('admin_workspace_action_verify_orias', {slug: workspace.slugId}) }}"
                                  method="POST"
                                  data-controller="submit-emitter"
                                  data-submit-emitter-event-name-value="kysure:orias-loading"
                                  data-action="submit->submit-emitter#submit">

                                <input type="hidden" name="_token" value="{{ csrf_token('verify_orias_' ~ workspace.slugId) }}">

                                <button type="submit"
                                        class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 rounded-lg transition cursor-pointer disabled:opacity-50 disabled:cursor-wait"
                                        data-submit-emitter-target="button">
                                    <twig:ux:icon name="tabler:certificate" class="size-4 text-slate-400" />
                                    Re-vérifier ORIAS
                                </button>
                            </form>

                            {# 3. Sync Stripe #}
                            <form action="" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('sync_stripe_' ~ workspace.slugId) }}">
                                <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 rounded-lg transition cursor-pointer">
                                    <twig:ux:icon name="tabler:brand-stripe" class="size-4 text-slate-400" />
                                    Force-Sync Stripe
                                </button>
                            </form>

                            <div class="my-1 border-t border-slate-100"></div>

                            {# 4. Extension d'essai (+14j) #}
                            <form action="" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('extend_trial_' ~ workspace.slugId) }}">
                                <input type="hidden" name="days" value="14">
                                <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-indigo-600 hover:bg-indigo-50 rounded-lg transition cursor-pointer">
                                    <twig:ux:icon name="tabler:clock-plus" class="size-4 text-indigo-500" />
                                    Prolonger l'essai (+14 jours)
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <a href="{{ path('admin_workspace_settings', {slugId: workspace.slugId}) }}" class="px-4 py-2 bg-white border border-slate-200 text-xs font-bold text-slate-700 rounded-xl hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-1.5">
                    <twig:ux:icon name="tabler:edit" class="size-4" />
                    Paramètres
                </a>

                <a href="" class="px-4 py-2 bg-[#6e2f1e] text-xs font-bold text-white rounded-xl hover:bg-[#5a2517] transition-colors shadow-sm flex items-center gap-1.5">
                    <twig:ux:icon name="tabler:spy" class="size-4" />
                    Impersonate
                </a>
            </div>
        </header>

        {% if workspace.suspensionReason %}
            <div class="p-3.5 bg-rose-50 border border-rose-200 rounded-xl flex items-center gap-3">
                <twig:ux:icon name="tabler:alert-triangle" class="size-5 text-rose-600 shrink-0" />
                <p class="text-xs text-rose-800 font-medium">
                    <strong>Cabinet suspendu le {{ workspace.suspendedAt|date('d/m/Y') }} :</strong> {{ workspace.suspensionReason }}
                </p>
            </div>
        {% endif %}

        {# ========================================================= #}
        {# GRID PRINCIPALE : 1/3 (Stats/Profil) - 2/3 (Onglets)       #}
        {# ========================================================= #}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start relative z-10">

            {# ----------------------------------------------------- #}
            {# COLONNE GAUCHE : DONNÉES DU CABINET (1/3)             #}
            {# ----------------------------------------------------- #}
            <div class="lg:col-span-4 space-y-8 sticky top-24">

                {# GROUPE 1 : Santé LCB-FT & ORIAS #}
                {# GROUPE 1 : Santé LCB-FT & ORIAS #}
                <div>
                    <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4">Agrément & Conformité</h2>
                    <ul class="space-y-1">

                        {# Score Santé LCB-FT #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-emerald-100 rounded-lg text-emerald-700">
                                    <twig:ux:icon name="tabler:shield-check" class="size-4" />
                                </div>
                                <span class="text-sm font-medium text-slate-600">Santé LCB-FT</span>
                            </div>
                            <div class="text-right">
                <span class="text-base font-bold text-emerald-700">
                    {{ healthScore.score|default(100) }}%
                </span>
                                <div class="text-[10px] text-slate-400">
                                    {% if workspace.isValidOrias %}Conforme{% else %}Action requise{% endif %}
                                </div>
                            </div>
                        </li>

                        {# N° ORIAS & Statut de Vérification #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60"
                            data-controller="inline-status-loader"
                            data-action="kysure:orias-loading@window->inline-status-loader#showLoading">

                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-blue-100 rounded-lg text-blue-700 relative">
                                    {# Icône par défaut #}
                                    <span data-inline-status-loader-target="icon">
                <twig:ux:icon name="tabler:certificate" class="size-4" />
            </span>
                                    {# Spinner masqué par défaut #}
                                    <span data-inline-status-loader-target="spinner" class="hidden">
                <svg class="animate-spin size-4 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </span>
                                </div>

                                <div>
                                    <span class="text-sm font-medium text-slate-600 transition-colors duration-300" data-inline-status-loader-target="title">N° ORIAS</span>

                                    <div data-inline-status-loader-target="subtitle">
                                        {% if workspace.lastCheckOrias %}
                                            <p class="text-[10px] text-slate-400">
                                                Vérifié le {{ workspace.lastCheckOrias|date('d/m/Y à H:i') }}
                                            </p>
                                        {% else %}
                                            <p class="text-[10px] text-amber-600 font-medium">Jamais vérifié</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            {# La zone de droite qui sera floutée pendant le chargement #}
                            <div class="text-right transition-all duration-300" data-inline-status-loader-target="details">
                                <div class="flex items-center justify-end gap-1.5">
                                    <span class="text-sm font-bold font-mono text-slate-900">{{ workspace.oriasNumber|default('Non renseigné') }}</span>

                                    {% if workspace.oriasNumber %}
                                        {% if workspace.isValidOrias %}
                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200" title="Immatriculation ORIAS confirmée">
                        Valide
                    </span>
                                        {% else %}
                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200" title="Non trouvé ou radié sur le registre ORIAS">
                        Invalide
                    </span>
                                        {% endif %}
                                    {% endif %}
                                </div>
                                <div class="text-[10px] text-slate-400 mt-0.5">{{ workspace.professionalAssociation|default('Sans association') }}</div>
                            </div>
                        </li>

                        {# Assurance RC Pro #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-indigo-100 rounded-lg text-indigo-700">
                                    <twig:ux:icon name="tabler:file-certificate" class="size-4" />
                                </div>
                                <span class="text-sm font-medium text-slate-600">RC Pro</span>
                            </div>
                            <div class="text-right">
                                <span class="text-xs font-bold text-slate-900">{{ workspace.rcProInsurer|default('Non renseigné') }}</span>
                                <div class="text-[10px] font-mono text-slate-400">{{ workspace.rcProPolicyNumber|default('-') }}</div>
                            </div>
                        </li>
                    </ul>
                </div>

                {# GROUPE 2 : Facturation & Abonnement #}
                <div>
                    <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4">Abonnement & Facturation</h2>
                    <ul class="space-y-1">

                        {# Plan Stripe #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-violet-100 rounded-lg text-violet-700">
                                    <twig:ux:icon name="tabler:credit-card" class="size-4" />
                                </div>
                                <span class="text-sm font-medium text-slate-600">Forfait Actuel</span>
                            </div>
                            <div class="text-right">
                                <span class="text-sm font-bold text-slate-900">{{ workspace.subscriptionPlan|default('Gratuit') }}</span>
                                {% if workspace.subscriptionStatus == 'active' %}
                                    <div class="text-[10px] font-bold text-emerald-600">Payant</div>
                                {% else %}
                                    <div class="text-[10px] text-slate-400">Inactif</div>
                                {% endif %}
                            </div>
                        </li>

                        {# Échéance #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-amber-100 rounded-lg text-amber-700">
                                    <twig:ux:icon name="tabler:calendar-event" class="size-4" />
                                </div>
                                <span class="text-sm font-medium text-slate-600">Fin de Période</span>
                            </div>
                            <div class="text-right">
                            <span class="text-xs font-bold text-slate-900">
                                {{ workspace.subscriptionEnd ? workspace.subscriptionEnd|date('d/m/Y') : '-' }}
                            </span>
                                {% if workspace.subscriptionCancelAtPeriodEnd %}
                                    <div class="text-[10px] font-bold text-rose-600">Résiliation programmée</div>
                                {% endif %}
                            </div>
                        </li>
                    </ul>
                </div>

                {# GROUPE 3 : Signalétique Legal #}
                <div>
                    <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4">Signalétique Légale</h2>
                    <ul class="space-y-1">

                        {# --- Ligne 1 : Le SIRET enrichi (Loader asynchrone & Statut) --- #}
                        <li class="flex items-center justify-between py-2 border-b border-slate-200/60"
                            data-controller="inline-status-loader"
                            data-action="kysure:siret-loading@window->inline-status-loader#showLoading">

                            <div class="flex items-center gap-2">
                                <div class="p-1 bg-indigo-100 rounded text-indigo-700 relative">
                                    {# Icône #}
                                    <span data-inline-status-loader-target="icon">
                        <twig:ux:icon name="tabler:building-bank" class="size-4" />
                    </span>
                                    {# Spinner #}
                                    <span data-inline-status-loader-target="spinner" class="hidden">
                        <svg class="animate-spin size-4 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </span>
                                </div>

                                <div class="flex flex-col">
                                    <span class="text-sm font-medium text-slate-500 transition-colors duration-300" data-inline-status-loader-target="title">SIRET</span>
                                    <div data-inline-status-loader-target="subtitle">
                                        {% if workspace.verifySiretLastAttemptedAt %}
                                            <p class="text-[10px] text-slate-400">
                                                Vérifié le {{ workspace.verifySiretLastAttemptedAt|date('d/m/Y à H:i') }}
                                            </p>
                                        {% else %}
                                            <p class="text-[10px] text-amber-600 font-medium">Jamais vérifié</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="text-right transition-all duration-300" data-inline-status-loader-target="details">
                                <div class="flex items-center justify-end gap-1.5">
                                    <span class="text-xs font-mono font-bold text-slate-900">{{ workspace.siret|default('Non renseigné') }}</span>

                                    {% if workspace.siret %}
                                        {% if workspace.isSiretValid %}
                                            <span class="inline-flex items-center gap-1 px-1 py-0.5 rounded text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200" title="Société enregistrée et active">
                                Valide
                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center gap-1 px-1 py-0.5 rounded text-[9px] font-bold bg-rose-50 text-rose-700 border border-rose-200" title="SIRET invalide ou entreprise fermée">
                                Invalide
                            </span>
                                        {% endif %}
                                    {% endif %}
                                </div>

                                {% if workspace.siret and workspace.etatAdministratif %}
                                    <div class="text-[9px] text-slate-400 mt-0.5">
                                        Statut Insee:
                                        <span class="font-medium {{ workspace.etatAdministratif == 'A' ? 'text-emerald-600' : 'text-rose-600' }}">
                            {{ workspace.etatAdministratif == 'A' ? 'Actif' : 'Cessée' }}
                        </span>
                                    </div>
                                {% endif %}
                            </div>
                        </li>

                        {# --- Ligne 2 : Inscription (inchangée) --- #}
                        <li class="flex items-center justify-between py-2 border-b border-slate-200/60">
                            <span class="text-sm font-medium text-slate-500">Inscrit le</span>
                            <span class="text-sm font-bold text-slate-900">{{ workspace.createdAt|date('d/m/Y') }}</span>
                        </li>

                    </ul>
                </div>

            </div>

            {# ----------------------------------------------------- #}
            {# COLONNE DROITE : ACTIVITÉ ET ONGLETS (2/3)            #}
            {# ----------------------------------------------------- #}
            <div class="lg:col-span-8 space-y-6">

                {# CARTE 1 : LES 4 KPI ACTIVITÉ DU CABINET #}
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-medium text-slate-500">Dossiers KYC</span>
                        <div class="mt-2 flex items-baseline justify-between">
                            <span class="text-2xl font-black text-slate-900">{{ workspace.foldersCount }}</span>
                            <twig:ux:icon name="tabler:folder" class="size-4 text-slate-400" />
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-medium text-slate-500">Clients Finaux</span>
                        <div class="mt-2 flex items-baseline justify-between">
                            <span class="text-2xl font-black text-slate-900">{{ workspace.clientsCount }}</span>
                            <twig:ux:icon name="tabler:users" class="size-4 text-slate-400" />
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-medium text-slate-500">Membres Équipe</span>
                        <div class="mt-2 flex items-baseline justify-between">
                            <span class="text-2xl font-black text-slate-900">{{ workspace.membersCount }}</span>
                            <twig:ux:icon name="tabler:users-group" class="size-4 text-slate-400" />
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-medium text-slate-500">Support Client</span>
                        <div class="mt-2 flex items-baseline justify-between">
                        <span class="text-2xl font-black {% if workspace.openTicketsCount > 0 %}text-amber-600{% else %}text-slate-900{% endif %}">
                            {{ workspace.openTicketsCount }}
                        </span>
                            <twig:ux:icon name="tabler:lifebuoy" class="size-4 text-slate-400" />
                        </div>
                    </div>

                </div>

                {# CARTE 2 : SYSTÈME D'ONGLETS ET CONTENU OPÉRATIONNEL #}
                <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden" data-controller="tabs">
                    {# Barre d'onglets #}
                    <div class="flex border-b border-slate-200 bg-slate-50/50 px-4 pt-3 gap-2 overflow-x-auto">
                        <button type="button"
                                class="px-4 py-2.5 text-xs font-bold border-b-2 border-[#6e2f1e] text-[#6e2f1e] flex items-center gap-2 bg-white rounded-t-lg shadow-sm"
                                data-tabs-target="tab"
                                data-action="click->tabs#change">
                            <twig:ux:icon name="tabler:users-group" class="size-4" />
                            Équipe ({{ workspace.membersCount }})
                        </button>

                        <button type="button"
                                class="px-4 py-2.5 text-xs font-semibold text-slate-600 border-b-2 border-transparent hover:text-slate-900 flex items-center gap-2 transition"
                                data-tabs-target="tab"
                                data-action="click->tabs#change">
                            Audit Logs Récents
                        </button>
                    </div>

                    {# Contenu des Onglets #}
                    <div class="p-6">
                        {# Onglet 1 : Membres de l'équipe (LiveComponent) #}
                        <div>
                        </div>
                    </div>
                </section>

            </div>
        </div>

    </div>
{% endblock %}
