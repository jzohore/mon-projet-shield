{% extends '@admin/base_admin.html.twig' %}

{% block title %}Paramètres - {{ workspace.name }} | {{ company_name }}{% endblock %}
{% block page_title %}Paramètres du cabinet{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('admin_organizations_list') }}" class="text-xs focus-visible:ring-2 focus-visible:ring-slate-900 rounded outline-none">
            Workspaces & clients
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('admin_workspace_details', {slugId: workspace.slugId}) }}" class="text-xs focus-visible:ring-2 focus-visible:ring-slate-900 rounded outline-none" aria-current="page">
            {{ workspace.name }}
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}

{% block content %}
    <div class="space-y-8 mx-auto">

        {# ========================================================= #}
        {# 1. BANDEAU DE NAVIGATION & HEADER ÉPURÉ                  #}
        {# ========================================================= #}
        <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
            <div class="space-y-1">
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold tracking-tight text-slate-900">{{ workspace.name }}</h1>

                    {% if workspace.isActive %}
                        {# Ajout d'un title/aria-label implicite via le texte, l'icône décorative est ignorée #}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span> Actif
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                            <span class="size-1.5 rounded-full bg-rose-500" aria-hidden="true"></span> Suspendu
                        </span>
                    {% endif %}
                </div>
                <p class="text-xs text-slate-500 flex items-center gap-2">
                    Réf: <span class="font-mono text-slate-700">{{ workspace.slugId }}</span>
                    <span aria-hidden="true">&bull;</span>
                    <span>Créé le <time datetime="{{ workspace.createdAt|date('Y-m-d') }}">{{ workspace.createdAt|date('d/m/Y') }}</time></span>
                </p>
            </div>

            <div class="flex items-center gap-2">
                <a href="{{ path('admin_workspace_details', {slugId: workspace.slugId}) }}" class="px-3 py-2 bg-white border border-slate-200 text-xs font-bold text-slate-700 rounded-xl hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-slate-400 outline-none transition-colors shadow-sm flex items-center gap-1.5">
                    <twig:ux:icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
                    Retour
                </a>
            </div>
        </header>

        {% if workspace.suspensionReason %}
            {# Ajout du rôle "alert" pour annoncer immédiatement la suspension au lecteur d'écran #}
            <div role="alert" class="p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <twig:ux:icon name="tabler:alert-triangle" class="size-5 text-rose-600 shrink-0" aria-hidden="true" />
                    <p class="text-xs text-rose-800 font-medium">
                        <strong>Cabinet suspendu le {{ workspace.suspendedAt ? workspace.suspendedAt|date('d/m/Y') : 'Récemment' }} :</strong> {{ workspace.suspensionReason }}
                    </p>
                </div>
            </div>
        {% endif %}

        {# ========================================================= #}
        {# 2. DISPOSITION 2 COLONNES : FORMULAIRE (LEFT) / ACTIONS (RIGHT) #}
        {# ========================================================= #}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            {# ----------------------------------------------------- #}
            {# COLONNE GAUCHE : FORMULAIRE PRINCIPAL (8 cols)        #}
            {# ----------------------------------------------------- #}
            <main class="lg:col-span-8 space-y-6">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
                    <div class="mb-6 pb-4 border-b border-slate-100">
                        <h2 class="text-base font-bold text-slate-900">Informations Légales & Configuration</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Modifiez la raison sociale et les identifiants d'agrément utilisés pour la génération des DER.</p>
                    </div>

                    <twig:WorkspaceEditComponent slugId="{{ workspace.slugId }}" adminEmail="{{ app.user.email }}" />
                </div>
            </main>

            {# ----------------------------------------------------- #}
            {# COLONNE DROITE : PANNEAU D'ACTIONS ET CONTRÔLE (4 cols) #}
            {# ----------------------------------------------------- #}
            <aside class="lg:col-span-4 space-y-6 sticky top-6" aria-label="Actions d'administration">

                {# CARTE 2 : GESTION DU STATUT DU COMPTE #}
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
                    {# CORRECTION: Passage de h3 à h2 et text-slate-400 à text-slate-500 pour le contraste #}
                    <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-2">
                        <twig:ux:icon name="tabler:user-check" class="size-4 text-slate-600" aria-hidden="true" />
                        Statut du Compte
                    </h2>

                    {% if workspace.isActive %}
                        <div class="space-y-3">
                            <p class="text-xs text-slate-500 leading-relaxed">
                                La suspension bloque l'accès des collaborateurs et interrompt la collecte des pièces justificatives KYC.
                            </p>
                            <twig:WorkspaceSuspendedComponent slugId="{{ workspace.slugId }}" adminEmail="{{ app.user.email }}" />

                        </div>
                    {% else %}
                        <div class="space-y-3">
                            <p class="text-xs text-slate-500 leading-relaxed">
                                Le cabinet est actuellement suspendu. Rétablissez l'accès aux collaborateurs en faisant sauter la mesure.
                            </p>
                            <form action="" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('reactivate_workspace_' ~ workspace.slugId) }}">
                                <button type="submit" class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-700 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-emerald-600 outline-none text-white font-bold text-xs rounded-xl transition shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                                    <twig:ux:icon name="tabler:play" class="size-4" aria-hidden="true" />
                                    Réactiver le cabinet
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>

            </aside>

        </div>

    </div>
{% endblock %}
