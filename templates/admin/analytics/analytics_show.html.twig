{% extends '@admin/base_admin.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}


{% block content %}
    <div class="max-w-7xl mx-auto space-y-6">
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title|default('Dashboard Analytique') }}</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            {# Bloc Tendance #}
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col">
                <h2 class="text-lg font-semibold text-slate-700 mb-4 shrink-0">Activité des 7 derniers jours</h2>

                {# 🛡️ FIX : Conteneur strict avec position relative et hauteur définie #}
                <div class="relative h-72 w-full flex-1">
                    {{ render_chart(trendChart) }}
                </div>
            </div>

            {# Bloc Répartition #}
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col">
                <h2 class="text-lg font-semibold text-slate-700 mb-4 shrink-0">Top Boutons/Éléments cliqués</h2>

                {# 🛡️ FIX : Conteneur strict avec position relative et hauteur définie #}
                <div class="relative h-72 w-full flex-1">
                    {{ render_chart(elementsChart) }}
                </div>
            </div>

        </div>
    </div>
{% endblock %}
