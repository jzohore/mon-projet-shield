<!DOCTYPE html>
<html lang="fr" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow"> {# Sécurité : On n'indexe pas l'admin #}

    <title>{% block title %}{{ company_name }} | Dashboard{% endblock %}</title>

    {# Préchargement de la police pour éviter le flash de texte (Figma Look) #}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% block stylesheets %}{% endblock %}
</head>
<body class="h-full text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-700">
{# Skip to content : Accessibilité essentielle #}
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-white focus:text-blue-600">
    Passer au contenu principal
</a>

{# 1. ICI : h-screen et overflow-hidden bloquent le scroll global de la page #}
<div class="flex h-screen overflow-hidden bg-[#fcfaf8]">

    {# 2. OPTIONNEL MAIS RECOMMANDÉ : overflow-y-auto sur la sidebar si le menu devient trop long un jour #}
    <aside class="w-64 bg-[#0a0f1a] text-white flex-shrink-0 flex flex-col border-r border-white/5 overflow-y-auto" aria-label="Navigation principale">

        <div class="p-8 mb-4 flex-shrink-0">
            <div class="flex items-center gap-3 group cursor-default">
                <div class="flex flex-col">
                    <span class="text-sm font-black tracking-widest uppercase leading-none">Kysure</span>
                    <span class="text-[9px] text-blue-500/80 font-bold uppercase tracking-[0.2em] mt-1">RegTech Solutions</span>
                </div>
            </div>
        </div>

        <nav class="flex-1 px-5 space-y-6 overflow-y-auto">

            <div>
                <p class="px-4 text-[10px] font-bold text-slate-500 uppercase tracking-[0.15em] mb-3">Conformité</p>
                <div class="space-y-1">
                    {% set compliance_items = [
                        {'icon': 'lucide:layout-dashboard', 'label': 'Tableau de Bord', 'badge': null, 'link': 'app_dashboard'},
                        {'icon': 'lucide:shield-check', 'label': 'Dossiers KYC', 'badge': '3', 'link': 'app_kyc_list'},
                        {'icon': 'lucide:users-round', 'label': 'Parties Prenantes', 'badge': null, 'link': 'app_kyc_list'},
                        {'icon': 'lucide:folder-open', 'label': 'Documents Collectés', 'badge': null, 'link': 'app_kyc_list'}
                    ] %}

                    {% for item in compliance_items %}
                        {% set is_active = (app.request.attributes.get('_route') == item.link) %}
                        <a href="{{ path(item.link) }}" class="group flex items-center justify-between px-4 py-2 rounded-md transition-all
                        {% if is_active %}
                            bg-blue-600/10 border border-blue-500/20 text-blue-400
                        {% else %}
                            text-slate-500 hover:text-white border border-transparent hover:bg-white/[0.03]
                        {% endif %}"
                           {% if is_active %}aria-current="page"{% endif %}>

                            <div class="flex items-center gap-3">
                                <twig:ux:icon name="{{ item.icon }}" class="w-4 h-4 transition-opacity {% if is_active %}opacity-100{% else %}opacity-40 group-hover:opacity-100{% endif %}" />
                                <span class="text-[12px] font-bold">{{ item.label }}</span>
                            </div>

                            {% if item.badge %}
                                <span class="bg-blue-600 text-white text-[9px] font-black px-1.5 py-0.5 rounded min-w-[1.25rem] text-center">{{ item.badge }}</span>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </div>

            <div>
                <p class="px-4 text-[10px] font-bold text-slate-500 uppercase tracking-[0.15em] mb-3">Organisation</p>
                <div class="space-y-1">
                    {% set org_items = [
                        {'icon': 'lucide:building-2', 'label': 'Mon Entreprise', 'link': 'admin_organizations_list'},
                        {'icon': 'lucide:users', 'label': 'Équipe & Accès', 'link': 'app_employees_list'},
                        {'icon': 'lucide:receipt', 'label': 'Facturation', 'link': 'admin_billings_list'}
                    ] %}

                    {% for item in org_items %}
                        {% set is_active = (app.request.attributes.get('_route') == item.link) %}
                        <a href="{{ path(item.link) }}" class="group flex items-center gap-3 px-4 py-2 rounded-md transition-all
                        {% if is_active %}
                            bg-blue-600/10 border border-blue-500/20 text-blue-400
                        {% else %}
                            text-slate-500 hover:text-white border border-transparent hover:bg-white/[0.03]
                        {% endif %}"
                           {% if is_active %}aria-current="page"{% endif %}>
                            <twig:ux:icon name="{{ item.icon }}" class="w-4 h-4 transition-opacity {% if is_active %}opacity-100{% else %}opacity-40 group-hover:opacity-100{% endif %}" />
                            <span class="text-[12px] font-bold">{{ item.label }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <div class="pt-6 mt-4 border-t border-white/5">
                    <p class="px-4 text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-4">Administration Système</p>
                    <div class="space-y-1">
                        {% set system_items = [
                            {'icon': 'lucide:user-cog', 'label': 'Administrateurs', 'link': 'account_admin_list'},
                            {'icon': 'lucide:scroll-text', 'label': 'Journal d\'Audit', 'link': 'admin_audit_logs_list'},
                            {'icon': 'lucide:webhook', 'label': 'Intégrations API', 'link': 'admin_integration_api_list'},
                            {'icon': 'lucide:credit-card', 'label': 'Abonnements', 'link': 'admin_subscriptions_list'},
                            {'icon': 'lucide:scale', 'label': 'Règles Compliance', 'link': 'admin_compliance_list'}
                        ] %}

                        {% for item in system_items %}
                            {% set is_active = (app.request.attributes.get('_route') == item.link) %}
                            <a href="{{ path(item.link) }}" class="group flex items-center gap-3 px-4 py-2 rounded-md transition-all
                            {% if is_active %}
                                bg-slate-800/80 border border-slate-700/50 text-white
                            {% else %}
                                text-slate-500 hover:text-white border border-transparent hover:bg-white/[0.03]
                            {% endif %}"
                               {% if is_active %}aria-current="page"{% endif %}>
                                <twig:ux:icon name="{{ item.icon }}" class="w-4 h-4 transition-opacity {% if is_active %}opacity-100{% else %}opacity-40 group-hover:opacity-100{% endif %}" />
                                <span class="text-[12px] font-bold">{{ item.label }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

        </nav>

        <div class="p-6 flex-shrink-0 mt-auto">
            <div class="group p-3 rounded-2xl bg-white/[0.03] border border-white/[0.05] flex items-center gap-3 hover:bg-white/[0.08] transition-all cursor-pointer">

                <a href="" class="flex items-center gap-3 flex-1 min-w-0 outline-none">
                    <div class="relative">
                        <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-[10px] font-black text-blue-400 border border-white/10 shadow-sm uppercase group-hover:bg-blue-900/40 group-hover:border-blue-500/30 transition-all">
                            {{ app.user.fullName|slice(0, 2) }}
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-[12px] font-bold text-slate-200 truncate leading-tight group-hover:text-blue-400 transition-colors">{{ app.user.fullName }}</p>
                        <p class="text-[10px] text-slate-500 font-medium truncate italic">Gérer mon compte</p>
                    </div>
                </a>

                <a href="{{ path('app_logout') }}" class="text-slate-600 hover:text-red-400 transition-colors p-2 rounded-lg hover:bg-red-500/10" title="Se déconnecter">
                    <twig:ux:icon name="lucide:log-out" class="w-4 h-4" />
                </a>
            </div>
        </div>
    </aside>

    {% set dynamic_breadcrumbs %}
        {% block breadcrumb_items %}{% endblock %}
    {% endset %}
    {% set title_page %}
        {% block page_title %}Vue d'ensemble{% endblock %}
    {% endset %}

    <main id="main-content" class="flex-1 flex flex-col min-w-0">
        {# 3. ICI : J'ai remplacé `sticky` par `flex-shrink-0` pour fixer la hauteur #}
        <header class="flex-shrink-0 h-16 bg-white/80 backdrop-blur-md border-b border-slate-200/60 flex items-center justify-between px-8 z-10">
            <twig:Breadcrumb>
                <twig:Breadcrumb:List>
                    <twig:Breadcrumb:Item>
                        <twig:Breadcrumb:Link href="{{ path('app_dashboard') }}">
                            <twig:ux:icon name="material-symbols:home-rounded" />
                        </twig:Breadcrumb:Link>
                    </twig:Breadcrumb:Item>

                    {{ dynamic_breadcrumbs }}

                    <twig:Breadcrumb:Separator />
                    <twig:Breadcrumb:Item>
                        <twig:Breadcrumb:Page class="text-xs">
                            {{ title_page }}
                        </twig:Breadcrumb:Page>
                    </twig:Breadcrumb:Item>
                </twig:Breadcrumb:List>
            </twig:Breadcrumb>

            <div class="flex items-center gap-6">
                {% block button_page %}
                    {# Status Indicateur #}
                    <div class="flex items-center gap-2.5 px-3 py-1.5 bg-green-50 rounded-full border border-green-100">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                        </span>
                        <span class="text-[10px] font-bold text-green-700 uppercase tracking-wider">Pappers API : Stable</span>
                    </div>

                    <button class="text-slate-400 hover:text-slate-900 transition-colors relative" aria-label="Notifications">
                        <i class="far fa-bell text-lg"></i>
                        <span class="absolute -top-1 -right-1 w-2 h-2 bg-blue-600 rounded-full ring-2 ring-white"></span>
                    </button>
                {% endblock %}
            </div>
        </header>

        {# 4. LA MAGIE EST ICI : flex-1 + overflow-y-auto #}
        <div class="flex-1 overflow-y-auto p-8">
            {% block content %}{% endblock %}
        </div>
    </main>
</div>
{%  include '@app/partials/_flashes.html.twig' %}
</body>
</html>
