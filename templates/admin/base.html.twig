<!DOCTYPE html>
<html lang="fr" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"> {# Sécurité mobile : empêche le zoom auto #}
    <meta name="robots" content="noindex, nofollow"> {# Sécurité : On n'indexe pas l'admin #}

    <title>{% block title %}{{ company_name }} | Dashboard{% endblock %}</title>

    <link rel="canonical" href="{{ app.request.getSchemeAndHttpHost() ~ app.request.getRequestUri() }}">
    {# Favicon propre #}
    <link rel="icon" href="{{ absolute_url(asset('kysure_favicon/favicon.ico')) }}">
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% block stylesheets %}{% endblock %}
</head>

{# On ajoute le contrôleur Stimulus au body pour gérer l'ouverture/fermeture du menu #}
<body class="h-full text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-700" data-controller="support">

{# Skip to content : Accessibilité essentielle #}
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-white focus:text-blue-600">
    Passer au contenu principal
</a>

<div class="flex h-screen overflow-hidden bg-[#fcfaf8]">

    {# ==========================================
       OVERLAY MOBILE (Fond sombre)
       ========================================== #}
    <div data-sidebar-target="backdrop"
         data-action="click->sidebar#close"
         class="fixed inset-0 z-40 bg-slate-900/80 backdrop-blur-sm transition-opacity hidden opacity-0 md:hidden"
         aria-hidden="true">
    </div>

    {# ==========================================
       SIDEBAR RESPONSIVE
       ========================================== #}
    <aside data-sidebar-target="menu"
           class="fixed inset-y-0 left-0 z-50 w-64 bg-[#0a0f1a] text-white flex flex-col border-r border-white/5 overflow-y-auto transform -translate-x-full transition-transform duration-300 ease-in-out md:relative md:translate-x-0 md:flex-shrink-0"
           aria-label="Navigation principale">

        <div class="p-6 md:p-8 mb-4 flex items-center justify-between flex-shrink-0">
            <div class="flex flex-col cursor-default">
                <span class="text-sm font-black tracking-widest uppercase leading-none">{{ company_name }}</span>
            </div>
            {# Bouton fermer (Visible uniquement sur mobile) #}
            <button data-action="click->sidebar#close" class="md:hidden p-2 -mr-2 text-slate-400 hover:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-white/20">
                <twig:ux:icon name="lucide:x" class="w-5 h-5" />
            </button>
        </div>

        <nav class="flex-1 px-4 md:px-5 space-y-6 overflow-y-auto pb-6">

            <div>
                <p class="px-4 text-[10px] font-bold text-slate-500 uppercase tracking-[0.15em] mb-3">Conformité</p>
                <div class="space-y-1">
                    {% set compliance_items = [
                        {'icon': 'lucide:layout-dashboard', 'label': 'Tableau de Bord', 'badge': null, 'link': 'app_dashboard'},
                        {'icon': 'lucide:shield-check', 'label': 'Dossiers', 'badge': '3', 'link': 'app_kyc_list'},
                        {'icon': 'lucide:sparkles', 'label': 'Rapports Advisory', 'badge': null, 'link': 'app_employees_list'},
                        {'label': 'Criblage LCB-FT', 'icon': 'lucide:user-round-search', 'badge': null, 'link': 'app_screening_list'},
                        {'icon': 'lucide:users-round', 'label': 'Parties Prenantes', 'badge': null, 'link': 'app_employees_list'},
                        {'icon': 'lucide:folder-open', 'label': 'Documents Collectés', 'badge': null, 'link': 'app_employees_list'}
                    ] %}

                    {% for item in compliance_items %}
                        {% set is_active = (app.request.attributes.get('_route') == item.link) %}
                        <a href="{{ path(item.link) }}" class="group flex items-center justify-between px-4 py-2.5 md:py-2 rounded-md transition-all
                        {% if is_active %}
                            bg-blue-600/10 border border-blue-500/20 text-blue-400
                        {% else %}
                            text-slate-500 hover:text-white border border-transparent hover:bg-white/[0.03]
                        {% endif %}"
                           {% if is_active %}aria-current="page"{% endif %}>

                            <div class="flex items-center gap-3">
                                <twig:ux:icon name="{{ item.icon }}" class="w-4 h-4 transition-opacity {% if is_active %}opacity-100{% else %}opacity-40 group-hover:opacity-100{% endif %}" />
                                <span class="text-[13px] md:text-[12px] font-bold">{{ item.label }}</span>
                            </div>

                            {% if item.badge %}
                                <twig:SidebarKycCounter></twig:SidebarKycCounter>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {#            <div>#}
            {#                <p class="px-4 text-[10px] font-bold text-slate-500 uppercase tracking-[0.15em] mb-3">Organisation</p>#}
            {#                <div class="space-y-1">#}
            {#                    {% set org_items = [#}
            {#                        {'icon': 'lucide:building-2', 'label': 'Mon Entreprise', 'link': 'admin_organizations_list'},#}
            {#                        {'icon': 'lucide:users', 'label': 'Équipe & Accès', 'link': 'app_employees_list'},#}
            {#                        {'icon': 'lucide:receipt', 'label': 'Facturation', 'link': 'admin_billings_list'}#}
            {#                    ] %}#}

            {#                    {% for item in org_items %}#}
            {#                        {% set is_active = (app.request.attributes.get('_route') == item.link) %}#}
            {#                        <a href="{{ path(item.link) }}" class="group flex items-center gap-3 px-4 py-2 rounded-md transition-all#}
            {#                        {% if is_active %}#}
            {#                            bg-blue-600/10 border border-blue-500/20 text-blue-400#}
            {#                        {% else %}#}
            {#                            text-slate-500 hover:text-white border border-transparent hover:bg-white/[0.03]#}
            {#                        {% endif %}"#}
            {#                           {% if is_active %}aria-current="page"{% endif %}>#}
            {#                            <twig:ux:icon name="{{ item.icon }}" class="w-4 h-4 transition-opacity {% if is_active %}opacity-100{% else %}opacity-40 group-hover:opacity-100{% endif %}" />#}
            {#                            <span class="text-[12px] font-bold">{{ item.label }}</span>#}
            {#                        </a>#}
            {#                    {% endfor %}#}
            {#                </div>#}
            {#            </div>#}

            {% if is_granted('ROLE_ADMIN') %}
                <div class="pt-6 mt-4 border-t border-white/5">
                    <p class="px-4 text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-4">Administration Système</p>
                    <div class="space-y-1">
                        {% set system_items = [
                            {'icon': 'lucide:user-cog', 'label': 'Administrateurs', 'link': 'account_admin_list'},
                            {'icon': 'lucide:scroll-text', 'label': 'Journal d\'Audit', 'link': 'admin_audit_logs_list'},
                            {'icon': 'lucide:webhook', 'label': 'Intégrations API', 'link': 'admin_integration_api_list'},
                            {'icon': 'lucide:credit-card', 'label': 'Abonnements', 'link': 'admin_subscriptions_list'},
                            {'icon': 'lucide:scale', 'label': 'Règles Compliance', 'link': 'admin_compliance_list'}
                        ] %}

                        {% for item in system_items %}
                            {% set is_active = (app.request.attributes.get('_route') == item.link) %}
                            <a href="{{ path(item.link) }}" class="group flex items-center gap-3 px-4 py-2.5 md:py-2 rounded-md transition-all
                            {% if is_active %}
                                bg-slate-800/80 border border-slate-700/50 text-white
                            {% else %}
                                text-slate-500 hover:text-white border border-transparent hover:bg-white/[0.03]
                            {% endif %}"
                               {% if is_active %}aria-current="page"{% endif %}>
                                <twig:ux:icon name="{{ item.icon }}" class="w-4 h-4 transition-opacity {% if is_active %}opacity-100{% else %}opacity-40 group-hover:opacity-100{% endif %}" />
                                <span class="text-[13px] md:text-[12px] font-bold">{{ item.label }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

        </nav>
    </aside>

    {% set dynamic_breadcrumbs %}
        {% block breadcrumb_items %}{% endblock %}
    {% endset %}
    {% set title_page %}
        {% block page_title %}Vue d'ensemble{% endblock %}
    {% endset %}

    <main id="main-content" class="flex-1 flex flex-col min-w-0 w-full">

        {# ==========================================
           HEADER (Ajusté pour mobile)
           ========================================== #}
        <header class="flex-shrink-0 h-16 bg-white/80 backdrop-blur-md border-b border-slate-200/60 flex items-center justify-between px-4 sm:px-6 md:px-8 z-10 sticky top-0">

            <div class="flex items-center gap-3 sm:gap-4">
                {# Bouton Hamburger (Visible uniquement sur mobile) #}
                <button data-action="click->sidebar#open" class="md:hidden p-2 -ml-2 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-slate-200">
                    <twig:ux:icon name="lucide:menu" class="w-5 h-5" />
                </button>

                {# Breadcrumb complet (Visible à partir de la taille Small) #}
                <div class="hidden sm:block">
                    <twig:Breadcrumb>
                        <twig:Breadcrumb:List>
                            <twig:Breadcrumb:Item>
                                <twig:Breadcrumb:Link href="{{ path('app_dashboard') }}" class="flex items-center gap-1">
                                    <twig:ux:icon name="material-symbols:home-rounded" />
                                    <span class="text-xs font-semibold">
                                        {{ workspaceInfo().name | lower | capitalize }}
                                    </span>
                                </twig:Breadcrumb:Link>
                            </twig:Breadcrumb:Item>

                            {{ dynamic_breadcrumbs }}

                            <twig:Breadcrumb:Separator />
                            <twig:Breadcrumb:Item>
                                <twig:Breadcrumb:Page class="text-xs">
                                    {{ title_page }}
                                </twig:Breadcrumb:Page>
                            </twig:Breadcrumb:Item>
                        </twig:Breadcrumb:List>
                    </twig:Breadcrumb>
                </div>

                {# Titre simple pour mobile (Remplace le breadcrumb pour gagner de la place) #}
                <div class="sm:hidden font-bold text-[14px] text-slate-800 truncate max-w-[140px]">
                    {{ title_page }}
                </div>
            </div>

            <div class="flex items-center gap-3 sm:gap-5">
                {# 1. Le Badge des Crédits #}
                {% if not workspaceInfo().isFirm %}
                    {# 🧑‍💻 DESIGN POUR LES INDÉPENDANTS (CRÉDITS) #}
                    <a href="{{ path('app_settings_billing') }}"
                       class="flex items-center gap-2 h-8 px-2 sm:px-2.5 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg shadow-sm transition-all cursor-pointer group text-[13px]">

        <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-20 group-hover:opacity-40"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500 group-hover:bg-indigo-600 transition-colors"></span>
        </span>

                        <span class="font-medium text-slate-500">
            <strong class="font-semibold text-slate-900">{{ workspaceInfo().balance }}</strong>
            <span class="hidden sm:inline">crédits</span>
        </span>
                    </a>
                {% else %}
                    {% set isTrial = subInfo().status == 'trialing' %}

                    {# On affiche le badge SI c'est un essai ET qu'il reste 10 jours ou moins ET que l'essai n'est pas expiré #}
                    {% if isTrial and subInfo().trialDaysRemaining <= 10 and subInfo().trialDaysRemaining > 0 %}
                        <a href="{{ path('app_settings_subscription') }}">
                      <span class="inline-flex items-center gap-1.5 rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">
        {# Petite icône horloge pour l'urgence #}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Essai : {{ subInfo().trialDaysRemaining }} jours restants
    </span>
                        </a>

                    {% endif %}
                {% endif %}
                {% block button_page %}
                    {% set has_active_thread = true %} {# Simulation #}
                    {% set unread_support_count = 1 %} {# Simulation #}
                    {% if has_active_thread %}
                        <div class="relative">
                            <button type="button"
                                    data-action="click->support#open"
                                    class="w-7 h-7 cursor-pointer flex items-center justify-center rounded-lg bg-white border border-slate-200 text-slate-500 hover:text-violet-600 hover:border-violet-300 hover:bg-violet-50 transition-all shadow-sm group">
                                {{ ux_icon('lucide:message-circle', { class: 'size-4' }) }}

                                {# Badge de notification si message non lu #}
                                {% if unread_support_count > 0 %}
                                    <span class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[10px] font-bold text-white ring-2 ring-white">
                            {{ unread_support_count }}
                        </span>
                                    {# Petit effet de halo pour attirer l'oeil si c'est non lu #}
                                    <span class="absolute -top-1 -right-1 animate-ping inline-flex h-4 w-4 rounded-full bg-red-400 opacity-75"></span>
                                {% endif %}
                            </button>
                        </div>
                    {% endif %}

                    {# 3. Le bouton Plus (Harmonisé en violet) #}
                    <div class="relative group">
                        <div class="cursor-pointer transition-transform duration-200 active:scale-95">
                            <div class="w-7 h-7 rounded-lg bg-violet-600 flex items-center justify-center text-white border border-violet-500 shadow-sm group-hover:bg-violet-700 transition-all">
                                {{ ux_icon('lucide:plus', { class: 'size-4' }) }}
                            </div>
                        </div>

                        <div class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl border border-slate-200/60
                opacity-0 invisible translate-y-2
                group-hover:opacity-100 group-hover:visible group-hover:translate-y-0
                transition-all duration-200 z-50 overflow-hidden">
                            <div class="p-1">
                                <a href="{{ path('app_settings_account') }}" class="flex items-center gap-2 px-3 py-2 text-xs text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors">
                                    Dossier KYC
                                </a>
                                <a href="{{ path('app_settings_account') }}" class="flex items-center gap-2 px-3 py-2 text-xs text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors">
                                    Dossier KYB
                                </a>
                                <a href="{{ path('app_settings_account') }}" class="flex items-center gap-2 px-3 py-2 text-xs text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors">
                                    Criblage LCB-FT
                                </a>
                            </div>
                        </div>
                    </div>

                    {# 4. L'Avatar #}
                    <div class="relative group">
                        <div class="cursor-pointer transition-transform duration-200 active:scale-95">
                            <div class="w-7 h-7 rounded-lg bg-violet-200 flex items-center justify-center text-[10px] font-black border border-violet-300 shadow-sm uppercase group-hover:bg-violet-300 transition-all text-violet-900">
                                {{ app.user.fullName|slice(0, 2) }}
                            </div>
                        </div>

                        <div class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl border border-slate-200/60
                opacity-0 invisible translate-y-2
                group-hover:opacity-100 group-hover:visible group-hover:translate-y-0
                transition-all duration-200 z-50 overflow-hidden">
                            <div class="px-4 py-3 border-b border-slate-100">
                                <p class="text-xs font-semibold text-slate-900">{{ app.user.fullName }}</p>
                                <p class="text-[10px] text-slate-500 truncate">{{ app.user.email }}</p>
                            </div>
                            <div class="p-1">
                                <a href="{{ path('app_settings_account') }}" class="flex items-center gap-2 px-3 py-2 text-xs text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors">
                                    <twig:ux:icon name="material-symbols:account-circle-outline" class="w-4 h-4" />
                                    Paramètres
                                </a>
                                <button type="button"
                                        data-action="click->support#open"
                                        class="w-full flex items-center justify-between px-3 py-2 text-xs text-slate-600 hover:bg-violet-50 hover:text-violet-700 rounded-lg transition-colors text-left group/support">
                                    <div class="flex items-center gap-2">
                                        {{ ux_icon('lucide:life-buoy', { class: 'size-4 group-hover/support:text-violet-600 transition-colors' }) }}
                                        Support
                                    </div>

                                    {# Le badge répété dans le menu pour attirer l'oeil #}
                                    {% if unread_support_count > 0 %}
                                        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-red-100 text-[10px] font-bold text-red-600">
                        {{ unread_support_count }}
                    </span>
                                    {% endif %}
                                </button>
                                <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-3 py-2 text-xs text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                                    <twig:ux:icon name="material-symbols:logout-rounded" class="w-4 h-4" />
                                    Déconnexion
                                </a>
                            </div>
                        </div>
                    </div>
                {% endblock %}
            </div>
        </header>

        {# 4. LA MAGIE EST ICI : Marges ajustées pour le mobile (p-4 vs p-8) #}
        <div class="flex-1 overflow-y-auto p-4 sm:p-4 md:p-8">
            <div class="max-w-8xl mx-auto space-y-8 pb-20">
                {% block content %}{% endblock %}
            </div>
        </div>
    </main>
</div>
{% include '@app/partials/_flashes.html.twig' %}
{{ include('components/_support_panel.html.twig') }}
</body>
</html>
